{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["agentconfig/steer.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "ask",
      "copy/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "main/run createscratch": "allow",
      "main/run mergescratch": "allow",
      "./run checkall": "allow",
      "./run typecheck": "allow",
      "./run test *": "allow",
      "./run lintfix": "allow",
      "./run djangomanage makemigrations *": "allow",
      "./run djangomanage migrate *": "allow",
      "cd copy *": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git ls-files": "allow",
      "git blame *": "allow"
    },
    "doom_loop": "allow",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "webfetch": "ask",
    "websearch": "allow",
    "lsp": "deny",
    "skill": "deny"
  }
}
