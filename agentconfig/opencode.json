{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["agentconfig/steer.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "ask",
      "apps/*": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "./run djangomanage buildbackend *": "allow",
      "./run djangomanage buildfrontend *": "allow",
      "npm --prefix frontend run lint": "allow",
      "npm --prefix frontend run type-check": "allow",
      "npm --prefix frontend run build": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git show": "allow",
      "git branch": "allow",
      "git ls-files": "allow",
      "git blame": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "wc *": "allow",
      "echo *": "allow",
      "head *": "allow",
      "tail *": "allow"

    },
    "doom_loop": "allow",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "webfetch": "ask",
    "websearch": "allow",
    "lsp": "deny",
    "skill": "deny"
  }
}
