{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["main/agentconfig/steer.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "ask",
      "copy/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls -la": "allow",
      "ls -la *": "allow",
      "main/run createscratch": "allow",
      "main/run mergescratch": "allow",
      "main/run cleancopy": "allow",
      "main/run djangomanage migrate": "allow",
      "main/run djangomanage migrate *": "allow",
      "main/run checkproject": "allow",
      "./run checkcopy": "allow",
      "./run typecheck": "allow",
      "./run test *": "allow",
      "./run lintfix": "allow",
      "./run playwrighttest": "allow",
      "./run playwrighttest *": "allow",
      "./run djangomanage makemigrations *": "allow",
      "./run djangomanage migrate *": "allow",
      "./run djangomanage findstatic *": "allow",
      "npm run build": "allow",
      "cd copy *": "allow",
      "rm -rf copy": "allow",
      "rm -rf copy/*": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git ls-files": "allow",
      "git blame *": "allow",
      "rg *": "deny",
      "perl *": "deny"
    },
    "doom_loop": "allow",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "webfetch": "ask",
    "websearch": "allow",
    "lsp": "deny",
    "skill": "deny"
  }
}
