{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["agentconfig/steer.md"],
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "ask",
      "scratch/**": "allow",
      "/srv/app/scratch/**": "allow"
    },
    "external_directory": {
      "$HOME/**/scratch/**": "allow",
      "/srv/app/scratch/**": "allow"
    },
    "bash": {
      "*": "ask",
      "pwd": "allow",
      "ls -la": "allow",
      "ls -la *": "allow",
      "ls -d": "allow",
      "ls -d *": "allow",
      "./run createscratch": "allow",
      "./run mergescratch": "allow",
      "./run cleanscratch": "allow",
      "./run djangomanage migrate": "allow",
      "./run djangomanage migrate *": "allow",
      "./run checkproject": "allow",
      "./run checkscratch": "allow",
      "./run typecheck": "allow",
      "./run test *": "allow",
      "./run lintfix": "allow",
      "./run playwrighttest": "allow",
      "./run playwrighttest *": "allow",
      "./run djangomanage makemigrations *": "allow",
      "./run djangomanage findstatic *": "allow",
      "npm run build": "allow",
      "cd scratch *": "allow",
      "cd ../scratch *": "allow",
      "rm -rf scratch": "allow",
      "rm -rf scratch/*": "allow",
      "rm -rf ../scratch": "allow",
      "rm -rf ../scratch/*": "allow",
      "git status": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git ls-files": "allow",
      "git blame *": "allow",
      "rg *": "deny",
      "perl *": "deny"
    },
    "doom_loop": "allow",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "webfetch": "ask",
    "websearch": "allow",
    "lsp": "deny",
    "skill": "deny"
  }
}
