{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.53.0",
    "npm-run-all": "^4.1.5",
    "oxlint": "^1.89.0",
    "prettier": "^3.8.1",
    "sass": "^1.99.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsgo": "^0.3.0"
  },
  "scripts": {
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "dev": "vite build --mode development --watch",
    "lint": "oxlint && prettier --check \"src/**/*.vue\" && eslint --cache \"src/**/*.vue\"",
    "lint:fix": "oxlint --fix && prettier --write \"src/**/*.vue\" && eslint --cache \"src/**/*.vue\" --fix",
    "preview": "vite preview",
    "type-check": "vue-tsgo --tsdk typescript7"
  },
  "dependencies": {
    "@d2lang/d2": "^0.1.34",
    "@inertiajs/core": "^3.6.1",
    "@inertiajs/vue3": "^3.6.0",
    "@panzoom/panzoom": "^4.6.2",
    "bootstrap": "^5.3.8",
    "diff2html": "^3.4.56",
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "ky": "^2.2.0",
    "marked": "^18.0.6",
    "marked-highlight": "^2.2.4",
    "quill": "^2.0.3",
    "sweetalert2": "^11.26.17",
    "vue": "^3.5.33",
    "vue-multiselect": "^3.4.0",
    "zod": "^4.0.0"
  }
}
