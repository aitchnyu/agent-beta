{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "permissionReviewLog": true,
  "permission": {
    "*": "ask",
    "subagent": "allow",
    "get_subagent_result": "allow",
    "read": "allow",
    "grep": "allow",
    "path": {
      "*": "allow",
      ".env": "ask",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.env.example": "allow"
    },
    "write": {
      "*": "ask",
      "scratch/*": "allow",
      "*/scratch/*": "allow",
      "/srv/desmo/scratch/*": "allow"
    },
    "edit": {
      "*": "ask",
      "scratch/*": "allow",
      "*/scratch/*": "allow",
      "/srv/desmo/scratch/*": "allow"
    },
    "external_directory": {
      "*": "ask",
      "../scratch": "allow",
      "../scratch/*": "allow",
      "/srv/desmo/scratch": "allow",
      "/srv/desmo/scratch/*": "allow",
      "..": "allow",
      "../*": "allow"
    },
    "bash": {
      "*": "ask",
      "perl": { "action": "deny", "reason": "perl one-liners are denied — use the grep tool or Python" },
      "perl *": { "action": "deny", "reason": "perl one-liners are denied — use the grep tool or Python" },
      "git -C *": { "action": "deny", "reason": "git -C is denied — cd into the directory, then git …" },
      "pwd": "allow",
      "cd": "allow",
      "cd *": "allow",
      "sed -n *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "sudo -u postgres pgbackrest --stanza=desmo info": "allow",
      "./run createscratch": "allow",
      "./run deployscratch": "allow",
      "./run cleanscratch": "allow",
      "./run checkframework1": "allow",
      "./run typecheck": "allow",
      "./run lintfix": "allow",
      "npm run build": "allow",
      "rm -rf ../scratch": "allow",
      "rm ../scratch/*": "allow",
      "rm scratch/*": "allow",
      "rm /srv/desmo/scratch/*": "allow",
      "./run djangomanage migrate *": "allow",
      "./run djangomanage makemigrations *": "allow",
      "./run djangomanage findstatic *": "allow",
      "./run djangomanage baseurls *": "allow",
      "./run djangomanage createuser *": "allow",
      "./run djangomanage makeloginlink *": "allow",
      "./run djangomanage promotetosuperuser *": "allow",
      "./run test *": "allow",
      "./run playwrighttest *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git blame *": "allow",
      "git status *": "allow",
      "git grep *": "allow",
      "git check-ignore *": "allow",
      "git rev-parse *": "allow",
      "git ls-tree *": "allow",
      "git ls-files *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "stat *": "allow",
      "file *": "allow",
      "du *": "allow",
      "date *": "allow",
      "which *": "allow",
      "ps *": "allow",
      "pgrep *": "allow",
      "lsof *": "allow",
      "bash -n *": "allow",
      "zsh -n *": "allow",
      "export *": "allow"
    }
  }
}
