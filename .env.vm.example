# .env.vm.example — VM environment. Copy to .env.vm (gitignored) at the repo
# ROOT and fill in; `./testvm provision` stages it to
# /etc/credentials/app/.env.vm where ALL systemd units (app_granian,
# app_huey, console_ttyd) read it. Layout is IDENTICAL to .env.example (the
# dev template); keys that don't apply to the VM are commented with a note.
# All keys must exist in both files. Legacy deploy/env.vm / .env_vm files
# must be RENAMED to .env.vm.

# ── Core ──────────────────────────────────────────────────────────────────
# Generate with high entropy (256-bit):  openssl rand -hex 32
# NEVER leave ANY value as DANGEROUSLYUNSET — provisioning refuses to run
# on any sentinel value, whatever the key (./testvm validates before
# anything ships; new env vars inherit the tripwire for free).
SECRET_KEY="DANGEROUSLYUNSET"
DEBUG="False"
# The VM serves https://app.local/ (the app) with the ttyd web terminal at
# https://app.local/agent/ — one mDNS hostname, one port.
ALLOWED_HOSTS="app.local"
TIME_ZONE="Asia/Kolkata"

# ── Database (Postgres — created by provisioning from these values) ───────
# Fixed single-app names (the multi-app parameterization is gone):
DB_NAME="app_db"
DB_USER="app_user"
# Generate with:  openssl rand -hex 32
DB_PASSWORD="DANGEROUSLYUNSET"
DB_HOST="127.0.0.1"
DB_PORT="5432"

# ── Redis / client-error capture ──────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"

# ── opencode agent (CLI in the ttyd console) ──────────────────────────────
# Full auth JSON as opencode's OPENCODE_AUTH_CONTENT contract expects — the
# TUI inside the https://app.local/agent/ terminal reads it from the environment (the
# console_ttyd unit sources this same file) and needs NO auth.json. Static
# API keys only (read-only path; oauth login/refresh still writes the file).
# SINGLE-quoted, ONE line, no spaces (quotes survive both shell sourcing and
# systemd EnvironmentFile; unquoted JSON breaks brace expansion):
# OPENCODE_AUTH_CONTENT='{"zai-coding-plan":{"type":"api","key":"sk-…"}}'
# Provider/model the agent prompts with (defaults shown):
# OPENCODE_PROVIDER="zai-coding-plan"
# OPENCODE_MODEL="glm-5.2"

# ── URLs ──────────────────────────────────────────────────────────────────
# The ttyd web-terminal address — drives the superuser "Console" nav link
# (rendered only when set). One mDNS hostname; the terminal rides the same
# HTTPS port at /agent/.
CONSOLE_URL="https://app.local/agent"

# ── Git identity for agent commits ────────────────────────────────────────
# Commits made by the agent (in the console terminal) show as "Opencode
# Agent" with NO email (empty value is valid git). Applies to every git
# process inheriting this env — all units share this file; no global git
# identity is ever set on the VM (fresh users), so env always wins.
GIT_AUTHOR_NAME="Opencode Agent"
GIT_COMMITTER_NAME="Opencode Agent"
GIT_AUTHOR_EMAIL=""
GIT_COMMITTER_EMAIL=""

# ── VM-only knobs ─────────────────────────────────────────────────────────
# granian/huey sizing (rendered into the systemd units by provisioning).
# HUEY_WORKERS=0 disables the huey service entirely. NOTE: keep values bare —
# no inline trailing comments on assignment lines (systemd EnvironmentFile
# and the provisioning parser take the line literally).
GRANIAN_WORKERS="1"
GRANIAN_THREADS="1"
HUEY_WORKERS="2"
# collectstatic target (Caddy serves /static/* from this directory):
STATIC_ROOT="staticfiles"

# ── Login on the VM ───────────────────────────────────────────────────────
# No Google OAuth here (.local is not registrable). One-time links for
# existing users:
#   multipass exec app -- sudo -u app -H bash -c \
#     'set -a; . /etc/credentials/app/.env.vm; set +a; cd /srv/app/main; .venv/bin/python manage.py makeloginlink <email>'
# Promote to superuser:
#   multipass exec app -- sudo -u app -H bash -c \
#     'set -a; . /etc/credentials/app/.env.vm; set +a; cd /srv/app/main; .venv/bin/python manage.py makesuperuser <email>'
