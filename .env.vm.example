# .env.vm.example — VM environment. Copy to .env.vm (gitignored) at the repo
# ROOT; `./testvm provision` stages it to /etc/credentials/desmo/.env.vm
# where ALL systemd units (desmo_granian, desmo_huey) read it. Layout is
# IDENTICAL to .env.example (the dev template); keys that don't apply to the
# VM are commented with a note. All keys must exist in both files. Legacy
# deploy/env.vm / .env_vm files must be RENAMED to .env.vm.
#
# Nothing here is a secret to fill in: the three machine secrets (SECRET_KEY,
# DB_PASSWORD, VAPID_PRIVATE_KEY) are GENERATED on the VM at provision time,
# and provisioning REFUSES if it finds generated secrets already installed
# (build-only — delete the VM to rebuild). The agent's provider auth + startup
# model live in pi's own stores (/login, /model + Ctrl+S; see
# deploy/access-steps.txt).

# ── Core ──────────────────────────────────────────────────────────────────
# Auto-generated on the VM at provision (openssl rand -hex 32).
SECRET_KEY=""
DEBUG="False"
# The VM serves https://localhost:8000/ (the app), reached ONLY through the
# ssh port forward (README § VM). ALLOWED_HOSTS is the single source of
# truth: Django's accepted hosts AND the caddy site names (testvm renders
# the caddy site from this value).
ALLOWED_HOSTS="localhost"
TIME_ZONE="Asia/Kolkata"
# Sessions expire this many days after the user's LAST REQUEST (sliding).
SESSION_IDLE_DAYS="14"

# ── Database (Postgres — created by provisioning from these values) ───────
# Fixed single-app names (the multi-app parameterization is gone):
DB_NAME="desmo_db"
DB_USER="desmo_user"
# Auto-generated on the VM at provision (openssl rand -hex 32) —
# the postgres login role is created with it.
DB_PASSWORD=""
DB_HOST="127.0.0.1"
DB_PORT="5432"

# ── Redis / client-error capture ──────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"

# ── pi agent (TUI run by the default cloud user via desmo pi) ──────────────
# No env keys: provider auth and the startup model live in pi's OWN stores —
# /login <provider> in the TUI writes credentials to ~/.pi/agent/auth.json,
# and /model + Ctrl+S saves the startup model to ~/.pi/agent/settings.json
# (one-time post-provision steps — see deploy/access-steps.txt). A one-off
# override needs no env either: `desmo pi --model <provider/model>`.

# ── Git identity for agent commits ────────────────────────────────────────
# Only the committer NAME is pinned: commits made by the agent user are
# marked "Agent" as committer, while author + emails fall back
# to git's defaults. Applies to every git process inheriting this env (all
# units share this file); no global git identity is ever set on the VM.
GIT_COMMITTER_NAME="Agent"

# ── Web Push notifications (bell + browser toasts) ────────────────────────
# Auto-generated on the VM at provision (deploy/gen-vapid-b64.sh via the
# tree) — never hand-filled.
VAPID_PRIVATE_KEY=""

# ── VM-only knobs ─────────────────────────────────────────────────────────
# granian/huey sizing (rendered into the systemd units by provisioning).
# HUEY_WORKERS must be ≥ 1 — provisioning refuses 0 (huey always runs).
# NOTE: keep values bare — no inline trailing comments on assignment lines
# (systemd EnvironmentFile and the provisioning parser take the line
# literally).
GRANIAN_WORKERS="1"
GRANIAN_THREADS="1"
HUEY_WORKERS="2"
# collectstatic target (Caddy serves /static/* from this directory):
STATIC_ROOT="staticfiles"
# Playwright: ONE shared browser cache — provisioning installs once
PLAYWRIGHT_BROWSERS_PATH="/srv/desmo/playwright-browsers"

# ── Login on the VM ───────────────────────────────────────────────────────
# Google OAuth works here (localhost is Google's dev redirect exception —
# tunnel must be up). Register
#   https://localhost:8000/accounts/google/login/callback/
# in the Google console, then store credentials:
#   multipass exec desmo -- sudo -u desmo -H bash /srv/desmo/main/deploy/vm.sh \
#     runasdesmo .venv/bin/python manage.py addoauth google <client_id> <secret>
# Or issue a one-time link for an existing user:
#   multipass exec desmo -- sudo -u desmo -H bash /srv/desmo/main/deploy/vm.sh \
#     runasdesmo .venv/bin/python manage.py makeloginlink <email>
# Promote to superuser:
#   multipass exec desmo -- sudo -u desmo -H bash /srv/desmo/main/deploy/vm.sh \
#     runasdesmo .venv/bin/python manage.py promotetosuperuser <email>
