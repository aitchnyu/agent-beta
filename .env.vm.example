# .env.vm.example — VM environment. Copy to .env.vm (gitignored) at the repo
# ROOT and fill in; `./testvm provision` stages it to
# /etc/credentials/app/.env.vm where ALL systemd units (app_granian,
# app_huey) read it. Layout is IDENTICAL to .env.example (the
# dev template); keys that don't apply to the VM are commented with a note.
# All keys must exist in both files. Legacy deploy/env.vm / .env_vm files
# must be RENAMED to .env.vm.

# ── Core ──────────────────────────────────────────────────────────────────
# Generate with high entropy (256-bit):  openssl rand -hex 32
# NEVER leave ANY value as DANGEROUSLYUNSET — provisioning refuses to run
# on any sentinel value, whatever the key (./testvm validates before
# anything ships; new env vars inherit the tripwire for free).
SECRET_KEY="DANGEROUSLYUNSET"
DEBUG="False"
# The VM serves https://app.local/ (the app) — one mDNS hostname, one port.
ALLOWED_HOSTS="app.local"
TIME_ZONE="Asia/Kolkata"

# ── Database (Postgres — created by provisioning from these values) ───────
# Fixed single-app names (the multi-app parameterization is gone):
DB_NAME="app_db"
DB_USER="app_user"
# Generate with:  openssl rand -hex 32
DB_PASSWORD="DANGEROUSLYUNSET"
DB_HOST="127.0.0.1"
DB_PORT="5432"

# ── Redis / client-error capture ──────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"

# ── pi agent (TUI run by the agent user via ./run pi) ──────────────────────
# Only pi's BUILT-IN providers are supported (no custom endpoints; list:
# pi --list-models). AGENT_MODEL is provider-qualified and passed to pi
# verbatim. Auth rides the provider's NATIVE env var — pi's zai provider
# reads ZAI_API_KEY directly (other providers use their own native
# names: ANTHROPIC_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY…).
# Every shell sources this same file via ./run setenv, so the TUI
# inherits them all. Both ship as active sentinels: the provision scan
# REFUSES on any DANGEROUSLYUNSET value.
ZAI_API_KEY="DANGEROUSLYUNSET"
AGENT_MODEL="DANGEROUSLYUNSET"

# ── Git identity for agent commits ────────────────────────────────────────
# Only the committer NAME is pinned: commits made by the agent user are
# marked "Agent" as committer, while author + emails fall back
# to git's defaults. Applies to every git process inheriting this env (all
# units share this file); no global git identity is ever set on the VM.
GIT_COMMITTER_NAME="Agent"

# ── VM-only knobs ─────────────────────────────────────────────────────────
# granian/huey sizing (rendered into the systemd units by provisioning).
# HUEY_WORKERS=0 disables the huey service entirely. NOTE: keep values bare —
# no inline trailing comments on assignment lines (systemd EnvironmentFile
# and the provisioning parser take the line literally).
GRANIAN_WORKERS="1"
GRANIAN_THREADS="1"
HUEY_WORKERS="2"
# collectstatic target (Caddy serves /static/* from this directory):
STATIC_ROOT="staticfiles"
# Playwright: ONE shared browser cache — provisioning installs once
PLAYWRIGHT_BROWSERS_PATH="/srv/app/playwright-browsers"

# ── Login on the VM ───────────────────────────────────────────────────────
# No Google OAuth here (.local is not registrable). One-time links for
# existing users:
#   multipass exec app -- sudo -u app -H bash -c \
#     'set -a; . /etc/credentials/app/.env.vm; set +a; cd /srv/app/main; .venv/bin/python manage.py makeloginlink <email>'
# Promote to superuser:
#   multipass exec app -- sudo -u app -H bash -c \
#     'set -a; . /etc/credentials/app/.env.vm; set +a; cd /srv/app/main; .venv/bin/python manage.py promotetosuperuser <email>'
