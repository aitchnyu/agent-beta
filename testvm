#!/bin/bash
# testvm — host-side driver for the test VM (multipass). The repo ships to
# the VM via the seed tarball; machine phases live in deploy/inside-vm.sh.
#
# Usage: ./testvm provision [--release 26.04|24.04]
#        ./testvm delete
#
# provision BUILDS a fresh VM (refuses if the instance exists — delete,
# then rebuild): /srv/desmo/{main,scratch}, units
# desmo_granian/desmo_huey, caddy at https://localhost:8000/ (ssh port
# forward), postgres + redis. ALL config comes from the root .env.vm,
# validated FAIL-HARD here before anything ships.
#
# delete is destructive with no backup: the VM's `.git` and database are
# gone — copy anything you need off first (tar via multipass transfer,
# pg_dump via multipass exec).
#
# Never touches the host's ssh config: use `multipass shell desmo` or
# your own alias. Plan + manifest: prompts/20260818-vm-provisioning-multipass.md.

# ── The file tree provisioning writes on the VM ──────────────────────────
# Built LOCALLY in $t/tree (mirroring absolute VM paths), shipped as ONE
# tarball, extracted at / by inside-vm.sh provision_app. Every leaf is
# tagged `tree: <path>` at its build line here and at its consumption site
# in inside-vm.sh — searchable both directions. Stock configs that need
# mutation (redis, caddy) are FETCHED from the VM after its packages
# install, then appended to locally. System phases (users, apt, postgres,
# ufw, swap) stay in deploy/inside-vm.sh. The repo seed + first commit
# (/srv/desmo/main) land AFTER the tree.
#
#   /
#   └── etc/
#       ├── credentials/desmo/
#       │   └── .env.vm                  shared env — every unit's EnvironmentFile
#       ├── systemd/system/
#       │   ├── desmo_granian.service
#       │   └── desmo_huey.service       always (HUEY_WORKERS ≥ 1 enforced)
#       ├── caddy/
#       │   ├── Caddyfile                stock + "import sites/*.caddy"
#       │   └── sites/desmo.caddy        the app site (names: ALLOWED_HOSTS)
#       └── redis/redis.conf             stock + maxmemory block
#   /
#   └── usr/local/lib/desmo/
#       └── gen-vapid-b64.sh             the VAPID mint executable (one recipe
#                                         with run init's repo copy)
#   /srv/desmo  (pre-created by provision_vm; group-desmo-writable)
#     └── main/ contents = the SEED TARBALL (the TRACKED working tree —
#         git ls-files driven, so the git index is the exclude authority;
#         deploy/ ships WITH it — guards, tests included)
#   /
#   └── tmp/
#       ├── vm-seed-commit.sh            one-shot: git init + first commit (run as desmo)
#       └── vm-bootstrap.sh              one-shot: uv sync, build, migrate, collectstatic
#
# The tree carries CONTENT only — extraction is `tar --no-same-owner`
# (everything lands root:root, the host's umask rides through in the file
# modes), so every mode/ownership pin lives in ONE place: inside-vm.sh
# provision_app, right after extraction. The single exception is tmp/'s
# 1777, which must ride in the archive itself (tar stamps the extracted
# dir with the archived mode).

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # repo root (main/)
deploy_dir="$here/deploy"
t="/tmp/provision-vm-desmo"

usage() {
  echo "Usage: $0 {provision|delete}" >&2
  [[ -n "${1:-}" ]] && echo "  $1" >&2
  exit 1
}

# Read a KEY="value" from the root .env.vm (first match wins; missing →
# empty — the `|| true` keeps set -e/pipefail from aborting BEFORE the
# friendly refusal paths that consume missing keys).
envval() {
  { grep -E "^$1=" "$here/.env.vm" | head -1 | cut -d= -f2- | tr -d '"'; } || true
}

provision() {
  # Pin the umask host-side: tree + seed tarballs carry file/dir modes
  # through extraction, so a stricter dev shell (027/077) would land
  # /etc/redis 700 (redis user can't traverse) and /tmp one-shots 600
  # (`sudo -u desmo bash /tmp/…` denied). 022 is the base the inside-vm
  # mode pins assume.
  umask 022
  local release="26.04"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --release) release="$2"; shift 2 ;;
      *) usage "unknown flag: $1" ;;
    esac
  done

  if ! command -v multipass >/dev/null 2>&1; then
    echo "multipass not found — install it first (https://multipass.run)" >&2
    exit 1
  fi

  # Root .env.vm is required (config knobs; the three machine secrets are
  # generated ON the VM at provision — see the template's header).
  [[ -f "$here/.env.vm" ]] || {
    echo ".env.vm not found — cp .env.vm.example .env.vm first." >&2
    exit 1
  }

  # ── fail-hard validation of .env.vm (host-side, before anything ships) ──
  # Worker knobs, ALLOWED_HOSTS: config that must be real before the build.
  # (No sentinel scan anymore: SECRET_KEY/DB_PASSWORD/VAPID_PRIVATE_KEY ship
  # empty and are generated inside the VM by inside-vm.sh provision_app;
  # provider auth/model live in pi's own stores.)

  # Worker knobs (baked into the units at render). No defaults.
  local granian_workers granian_threads huey_workers
  granian_workers="$(envval GRANIAN_WORKERS)"
  granian_threads="$(envval GRANIAN_THREADS)"
  huey_workers="$(envval HUEY_WORKERS)"
  if [[ -z "$granian_workers" || -z "$granian_threads" || -z "$huey_workers" ]]; then
    echo "REFUSING: GRANIAN_WORKERS/GRANIAN_THREADS/HUEY_WORKERS must be set explicitly in .env.vm (huey needs at least 1 worker)." >&2
    exit 1
  fi
  # Knobs are baked into unit files via sed and arithmetic — digits only
  # (a `/` or `&` would corrupt the render; junk would silently skip huey).
  local knob
  for knob in "$granian_workers" "$granian_threads" "$huey_workers"; do
    if [[ ! "$knob" =~ ^[0-9]+$ ]]; then
      echo "REFUSING: worker knobs must be non-negative integers in .env.vm (got: '$knob')." >&2
      exit 1
    fi
  done
  # Huey always runs — 0 workers is not a valid deployment (periodic tasks
  # like the daily pick would silently never run).
  if (( huey_workers < 1 )); then
    echo "REFUSING: HUEY_WORKERS must be at least 1 in .env.vm (got: '$huey_workers')." >&2
    exit 1
  fi
  # ALLOWED_HOSTS is the single source of truth for BOTH the hosts Django
  # accepts and the caddy site names (rendered into sites/desmo.caddy
  # below — a mismatch is impossible by construction, so no
  # app.local-style warning).
  local site_hostnames site_names
  site_hostnames="$(envval ALLOWED_HOSTS)"
  if [[ -z "$site_hostnames" ]]; then
    echo "REFUSING: ALLOWED_HOSTS must be set in .env.vm (Django hosts + caddy site names)." >&2
    exit 1
  fi
  # Comma-separated → a caddy site label ("localhost" / "a, b"), with the
  # charset validated so the sed render below can't be corrupted.
  site_names="$(printf '%s' "$site_hostnames" | tr ',' ' ' | tr -s ' ' | sed -e 's/^ //' -e 's/ $//' -e 's/ /, /g')"
  if [[ ! "$site_names" =~ ^[A-Za-z0-9._*-]+(, [A-Za-z0-9._*-]+)*$ ]]; then
    echo "REFUSING: ALLOWED_HOSTS must be plain hostnames, comma-separated (got: '$site_hostnames')." >&2
    exit 1
  fi
  # The three machine-secret keys must ship EMPTY: the VM generates them at
  # provision (inside-vm.sh) — a value shipped here would be silently
  # discarded by the mint's rewrite.
  local prefilled
  prefilled="$(grep -E '^(SECRET_KEY|DB_PASSWORD|VAPID_PRIVATE_KEY)=".+"' "$here/.env.vm" || true)"
  if [[ -n "$prefilled" ]]; then
    echo "REFUSING: .env.vm carries pre-filled machine secrets — the VM generates SECRET_KEY/DB_PASSWORD/VAPID_PRIVATE_KEY itself; empty these lines:" >&2
    # Key names only — never echo the values back into the terminal.
    printf '%s\n' "$prefilled" | sed -E 's/=.*/=<non-empty>/' >&2
    exit 1
  fi
  if ! grep -qE '^PLAYWRIGHT_BROWSERS_PATH=' "$here/.env.vm"; then
    echo "WARNING: PLAYWRIGHT_BROWSERS_PATH unset in .env.vm — browsers land in per-user caches and the agent's scratch tests won't find them (.env.vm.example documents the key)." >&2
  fi

  # ── 1. launch the instance (refuse if it exists — build only) ────────────
  if multipass info desmo >/dev/null 2>&1; then
    echo "REFUSING: instance 'desmo' already exists — provisioning builds only." >&2
    echo "  ./testvm delete && ./testvm provision  # to rebuild" >&2
    exit 1
  fi
  # en0 = the primary (bridged) interface on a macOS host — the locked deploy
  # target. On another host OS, substitute its bridged interface name.
  echo "==> multipass launch desmo (bridged en0, DHCP, 2G ram, 20G disk, $release)"
  multipass launch --name desmo --network en0 --memory 2G --disk 20G "$release"

  # ── 2. machine phases inside (users, apt, node, pi, caddy, swap…) ──
  multipass transfer "$deploy_dir/inside-vm.sh" desmo:/tmp/inside-vm.sh
  multipass exec desmo -- sudo bash /tmp/inside-vm.sh provision_vm
  # vm.sh rides along as /tmp/vm.sh: the seed (with its deploy/vm.sh copy)
  # isn't extracted until step 5, and steps before it already need helpers.
  multipass transfer "$deploy_dir/vm.sh" desmo:/tmp/vm.sh

  # ── 3. build the file tree locally (see the tree comment up top) ─────────
  rm -rf "$t"; mkdir -p "$t"

  # Stock configs to mutate: fetch them from the freshly installed VM.
  multipass exec desmo -- sudo cat /etc/redis/redis.conf > "$t/redis.conf"
  multipass exec desmo -- sudo cat /etc/caddy/Caddyfile > "$t/Caddyfile"

  echo "==> build the provisioned tree in $t/tree"
  local tree="$t/tree"
  mkdir -p "$tree/etc/credentials/desmo" \
    "$tree/etc/systemd/system" \
    "$tree/etc/caddy/sites" "$tree/etc/redis"
  render() {
    sed -e "s/@GRANIAN_WORKERS@/$granian_workers/g" \
        -e "s/@GRANIAN_THREADS@/$granian_threads/g" \
        -e "s/@HUEY_WORKERS@/$huey_workers/g" \
        -e "s/@SITE_HOSTNAMES@/$site_names/g" "$1"
  }

  # tree: /etc/credentials/desmo/.env.vm — content only; root:desmo +
  # 750/640 are pinned inside (inside-vm.sh, after --no-same-owner
  # extraction).
  cp "$here/.env.vm" "$tree/etc/credentials/desmo/.env.vm"

  # tree: /etc/systemd/system/desmo_granian.service
  render "$deploy_dir/granian.service.in" > "$tree/etc/systemd/system/desmo_granian.service"
  # tree: /etc/systemd/system/desmo_huey.service (always — HUEY_WORKERS ≥ 1
  # is validated above, huey is never deployed without workers)
  render "$deploy_dir/huey.service.in" > "$tree/etc/systemd/system/desmo_huey.service"

  # tree: /etc/caddy/Caddyfile — stock + the sites import (one line).
  printf '\nimport sites/*.caddy\n' >> "$t/Caddyfile"
  cp "$t/Caddyfile" "$tree/etc/caddy/Caddyfile"
  # tree: /etc/caddy/sites/desmo.caddy
  render "$deploy_dir/Caddyfile.site.in" > "$tree/etc/caddy/sites/desmo.caddy"

  # tree: /etc/redis/redis.conf — stock + the maxmemory block.
  cat "$deploy_dir/redis-append.conf" >> "$t/redis.conf"
  cp "$t/redis.conf" "$tree/etc/redis/redis.conf"

  # tree: /usr/local/lib/desmo/gen-vapid-b64.sh — the canonical VAPID mint
  # inside-vm.sh executes (the seed/repo doesn't exist yet when provision_app
  # runs; `run init` executes the repo's deploy/ copy). -m 755: executed,
  # never sourced.
  mkdir -p "$tree/usr/local/lib/desmo"
  install -m 755 "$deploy_dir/gen-vapid-b64.sh" "$tree/usr/local/lib/desmo/gen-vapid-b64.sh"

  # tree: /tmp/vm-seed-commit.sh + /tmp/vm-bootstrap.sh — one-shot scripts
  # this driver invokes below via `bash /tmp/…` (never executed directly,
  # so no exec bit needed; mode pinned nowhere on purpose).
  # tmp/'s 1777 must ride IN the archive (not be re-applied inside) because
  # tar stamps the EXTRACTED directory with the archived mode — and the
  # tmpfs-mounted /tmp is the one dir an outside-file chmod can't fix after
  # the fact (a plain 755 here strips the sticky bit and every later
  # multipass transfer, running as ubuntu, hits Permission denied).
  mkdir -p "$tree/tmp"
  chmod 1777 "$tree/tmp"
  cp "$deploy_dir/vm-seed-commit.sh" "$tree/tmp/vm-seed-commit.sh"
  cp "$deploy_dir/vm-bootstrap.sh" "$tree/tmp/vm-bootstrap.sh"

  # Ship the whole tree as ONE tarball (ownership is fixed inside after
  # extraction — the host can't know VM gids).
  tar czf "$t/tree.tgz" -C "$tree" .
  multipass transfer "$t/tree.tgz" desmo:/tmp/tree.tgz

  # ── 4. app phases inside (extract tree, postgres, enable, caddy) ─────────
  multipass exec desmo -- sudo bash /tmp/inside-vm.sh provision_app

  # ── 5. seed the repo ─────────────────────────────────────────────────────
  echo "==> seed /srv/desmo/main (tarball over multipass transfer, from $here)"
  multipass exec desmo -- sudo install -d -o desmo -g desmo /srv/desmo/main
  # The seed = the TRACKED working tree: `git ls-files` drives tar, so the
  # git index is the single source of truth — gitignored artifacts (.env*,
  # /sessions/ (pi sessions, root-level via sessionDir), staticfiles/, caches…) and untracked clutter (editor state,
  # AppleDouble junk, empty dirs) can never ship, and no hand-maintained
  # exclude list can drift (it did: .coverage/static/uploads/.idea all
  # leaked at some point). Tracked-but-deleted files make tar fail
  # loudly — desired. Mode bits come from the filesystem, as before.
  (cd "$here" && git ls-files -z) | COPYFILE_DISABLE=1 tar czf /tmp/desmo-seed.tgz -C "$here" --null -T -
  multipass transfer /tmp/desmo-seed.tgz desmo:/tmp/desmo-seed.tgz
  # Extract + ownership/perms pin — the body lives in deploy/vm.sh
  # (extract-app-seed); call sites stay one-liners (INSTRUCTIONS.md §
  # Multipass helpers in deploy/vm.sh).
  multipass exec desmo -- sudo bash /tmp/vm.sh extract-app-seed

  # main/ is its OWN repo (the seed ships no .git; the parent /srv/desmo
  # is NOT a repo — the agent uses external_directory for scratch/). The
  # script makes the first commit marking the provisioned baseline.
  echo "==> git init + first commit in /srv/desmo/main"
  multipass exec desmo -- sudo -u desmo -H bash /tmp/vm-seed-commit.sh

  # ── 6. bootstrap the app as desmo (env via the credentials file) ────────
  echo "==> bootstrap (uv sync, npm build, migrate, collectstatic)"
  multipass exec desmo -- sudo -u desmo -H bash /tmp/vm-bootstrap.sh

  # ── 6a. provision tail: playwright browsers + deps + /tmp cleanup ────────
  # The distro is ubuntu 26.04; the arch varies — bodies + per-step
  # rationale in deploy/vm.sh (provision-finish).
  multipass exec desmo -- sudo bash /srv/desmo/main/deploy/vm.sh provision-finish

  echo "==> start services"
  # Huey's unit always ships (HUEY_WORKERS ≥ 1 is validated before render).
  multipass exec desmo -- sudo systemctl restart desmo_granian.service desmo_huey.service
  multipass exec desmo -- sudo systemctl restart caddy

  # ── 7. print the access steps ────────────────────────────────────────────
  cat "$deploy_dir/access-steps.txt"
  rm -rf "$t"
}

delete() {
  multipass delete desmo
  multipass purge
  echo "Deleted VM 'desmo'. Recreate: ./testvm provision (fresh seed from the local repo)."
}

# Check if function exists and call it with all arguments except $1
cmd="${1:-}"
if [[ -n "$cmd" ]] && declare -F "$cmd" >/dev/null; then
  shift
  "$cmd" "$@"
else
  usage
fi
