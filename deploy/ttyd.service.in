[Unit]
Description=console ttyd (web terminal)
After=network.target

[Service]
# The powerful console user: the terminal it serves is where the operator
# (and the Crush agent, run BY the operator inside this terminal) works.
# console has full NOPASSWD sudo (see /etc/sudoers.d/console), so the agent
# can restart services / read journals from in here.
User=console
Group=console

# cwd = main/ (the repo): shells land among the files and `./run agent`
# works from the prompt; the rcfile chains the user's bashrc + the shared
# banner (deploy/console-bashrc, same file as dev). -W: clients write to
# the TTY (required for TUIs). Loopback only — caddy is the sole front.
# The start command is REQUIRED: bare ttyd spawns exit-254 per WS
# connection and the browser reconnect-loops forever (observed).
ExecStart=/usr/bin/ttyd -W -i 127.0.0.1 -p 7681 -w /srv/app/main -- /bin/bash --rcfile /srv/app/main/deploy/console-bashrc

# The single shared env file (root .env.vm staged by provisioning): ttyd
# passes its environment to every shell (and to crush launched inside) —
# AGENT_MODEL plus the provider's NATIVE auth var (ZAI_API_KEY for z.ai;
# the repo-root .crushrc uses crush's built-in providers) +
# GIT_COMMITTER_NAME (agent-made commits are marked "Agent" as
# committer). Nothing else to point: crush discovers the project .crushrc
# from its cwd (/srv/app/main).
EnvironmentFile=/etc/credentials/app/.env.vm

Restart=always
RestartSec=3

# Hardening. EXCEPTION: NoNewPrivileges must be no HERE — sudo is a
# setuid binary and NNP (inherited by every child of this unit) makes
# each sudo from the terminal fail with "the 'no new privileges' flag
# is set", killing the NOPASSWD workflow this console exists for. The
# app units (granian/huey) correctly keep NNP=yes — they never sudo.
NoNewPrivileges=no
ProtectSystem=strict
# read-only /home so the spawned shell can read ~/.bashrc / ~/.profile;
# writables are the app tree (scratch edits, crush state) + the home.
ProtectHome=read-only
ReadWritePaths=/srv/app /home/console
PrivateTmp=yes

# commented out
# MemoryMax 512M: the agent TUI needs more than a shell
#MemoryMax=512M

[Install]
WantedBy=multi-user.target
