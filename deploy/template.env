# template.env — the VM's environment file (static half; named *.env so
# editors highlight it).
# Provisioning (deploy/inside-vm.sh) validates this file, installs it as
# /etc/credentials/desmo/.env.vm (root:desmo 640 — the single file every
# service unit and ./run sources), and fills the three @…@ secret
# placeholders at first provision. Build-only: provisioning refuses a VM
# whose secrets are already set.

# ── App ────────────────────────────────────────────────────────────────────
# Django session/signing secret — generated at provision (openssl).
SECRET_KEY="@SECRET_KEY@"
DEBUG="False"
# Hosts Django answers on AND the caddy site names (single source of truth).
ALLOWED_HOSTS="localhost"
TIME_ZONE="Asia/Kolkata"
# Sessions expire N days after the user's LAST request (sliding).
SESSION_IDLE_DAYS="14"

# ── Database (postgres on this machine) ────────────────────────────────────
# Role + both databases (desmo_db, desmo_db_test) are created at provision
# from these values; one app per VM.
DB_NAME="desmo_db"
DB_USER="desmo_user"
# The role's password — generated at provision (openssl).
DB_PASSWORD="@DB_PASSWORD@"
DB_HOST="127.0.0.1"
DB_PORT="5432"

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"

# ── Web Push ───────────────────────────────────────────────────────────────
# VAPID identity (P-256 scalar, base64url) — generated at provision.
VAPID_PRIVATE_KEY="@VAPID_PRIVATE_KEY@"

# ── Processes (baked into the systemd units at provision) ──────────────────
# granian web workers/threads; huey workers — huey always runs, so ≥ 1.
# Bare values only: no inline trailing comments on assignment lines
# (systemd EnvironmentFile parses the line literally).
GRANIAN_WORKERS="1"
GRANIAN_THREADS="1"
HUEY_WORKERS="2"
# collectstatic target — caddy serves /static/* from it.
STATIC_ROOT="staticfiles"
# One shared playwright browser cache for all users (agent tests included).
PLAYWRIGHT_BROWSERS_PATH="/srv/desmo/playwright-browsers"

# ── Git ────────────────────────────────────────────────────────────────────
# Committer name for agent-made commits. No global git identity is ever set.
GIT_COMMITTER_NAME="Agent"

# pi agent auth + startup model are NOT env keys — they live in pi's own
# stores (/login, /model + Ctrl+S in the TUI). Operator how-to: README § VM.

# MAINTAIN-CONSISTENCY env-file — every key must exist in both this file
# and .env.example (see INSTRUCTIONS.md).
