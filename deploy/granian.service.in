[Unit]
Description=desmo granian (ASGI)
After=network.target postgresql.service redis-server.service

[Service]
# The less powerful desmo user: runs the web app + nothing else. No sudo.
User=desmo
Group=desmo
WorkingDirectory=/srv/desmo/main

# Pure app server: caddy does TLS + /static/*; worker/threads baked at
# build time. uv --no-sync just execs the venv's script; UV_NO_CACHE
# because ProtectHome blocks uv's cache dir.
Environment=UV_NO_CACHE=1
ExecStart=/usr/local/bin/uv run --no-sync granian --interface asgi --no-ws \
  --host 127.0.0.1 --port 8000 \
  --workers @GRANIAN_WORKERS@ --blocking-threads @GRANIAN_THREADS@ \
  djangoproject.asgi:application

# The single shared env file (the tracked deploy/template.env staged by
# provisioning + minted secrets; REDIS_URL, URL keys). Root-owned,
# desmo-group-readable — units read it, the app itself holds all these
# values at runtime anyway.
EnvironmentFile=/etc/credentials/desmo/.env.vm

Restart=always
RestartSec=3

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/desmo
PrivateTmp=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
