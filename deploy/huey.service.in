[Unit]
Description=desmo huey consumer
After=network.target postgresql.service redis-server.service

[Service]
# The less powerful desmo user (same as desmo_granian).
User=desmo
Group=desmo
WorkingDirectory=/srv/desmo/main

# Worker count baked at build time from deploy/template.env (HUEY_WORKERS).
# uv --no-sync execs the venv python; UV_NO_CACHE — ProtectHome blocks the
# cache dir.
Environment=UV_NO_CACHE=1
ExecStart=/usr/local/bin/uv run --no-sync python manage.py run_huey -w @HUEY_WORKERS@

# The single shared env file (the tracked deploy/template.env staged by
# provisioning).
EnvironmentFile=/etc/credentials/desmo/.env.vm

Restart=always
RestartSec=3

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/desmo
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
