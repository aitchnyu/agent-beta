[Unit]
Description=desmo huey consumer
After=network.target postgresql.service redis-server.service

[Service]
# The less powerful desmo user (same as desmo_granian).
User=desmo
Group=desmo
WorkingDirectory=/srv/desmo/main

# Worker count baked at build time from .env.vm (HUEY_WORKERS; provisioning
# refuses anything below 1 — huey is never deployed without workers).
ExecStart=/srv/desmo/main/.venv/bin/python manage.py run_huey -w @HUEY_WORKERS@

# The single shared env file (root .env.vm staged by provisioning).
EnvironmentFile=/etc/credentials/desmo/.env.vm

Restart=always
RestartSec=3

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/desmo
PrivateTmp=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
