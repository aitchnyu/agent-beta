#!/bin/bash

set -euo pipefail

setenv() {
  if [ ! -f .env ]; then
    echo "Warning: .env file not found, relying on python-dotenv to load defaults or environment"
  fi
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests
  uv run playwright install firefox
  # Create the database
  psql -U postgres -c "CREATE DATABASE tables;" || echo "Database 'tables' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
}

runserver() {
  setenv
  djangomanage runserver
}

test() {
  setenv
  uv run manage.py test --exclude-tag playwright "$@"
}

coverage() {
  setenv
  uv run coverage run --source=djangoapp --omit='djangoapp/tests/test_playwright.py' manage.py test --exclude-tag playwright
  uv run coverage report -m
  uv run coverage html
  open htmlcov/index.html
#  echo -n "Open HTML coverage report in browser? (y/N)"
#  read -r response
#  if [[ "$response" =~ ^[Yy]$ ]]; then
#    uv run coverage html
#    open htmlcov/index.html
#  fi
}

specialcoverage() {
  setenv
  echo "\n Running filters coverage check"
  # Run coverage on filters modules using all tests
  uv run coverage run --source=djangoapp.filters manage.py test djangoapp.tests.test_filters
  # Generate text report and fail if coverage is less
  uv run coverage report -m #--fail-under=95

  echo "\n Running serializers coverage check"
  # Run coverage on models and serializers modules using all tests
  uv run coverage run --source=djangoapp.serializers manage.py test djangoapp.tests.test_serializers
  # Generate text report and fail if coverage is less
  uv run coverage report -m #--fail-under=95

  echo "\n Running models coverage check"
  # Run coverage on models and serializers modules using all tests
  uv run coverage run --source=djangoapp.models manage.py test djangoapp.tests.models
  # Generate text report and fail if coverage is less
  uv run coverage report -m #--fail-under=95
  
  uv run coverage html
  open htmlcov/index.html
}

typecheck() {
  setenv
  uv run mypy .
}


playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  # Modify command like this to test specific things on debugger
  #  PWDEBUG=1 uv run manage.py test djangoapp.tests.playwright.test_playwright.CrudOperationsPlaywrightTest.test_create_row_submit_success
  uv run manage.py test --tag playwright --noinput
}

checkall() {
  setenv
  echo "Running ruff for formatting problems"
  uv run ruff check
  echo "Running mypy for type checking"
  uv run mypy .
#  echo "Running models coverage check (must be 100%)"
#  specialcoverage
  echo "Running test"
  test --noinput
#  uv run coverage run --source=djangoapp manage.py test && uv run coverage report --fail-under=80
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  cd ..
  echo "Running Playwright tests"
  playwrighttest
}

lintfix() {
  setenv
  uv run ruff format
  uv run ruff check --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  echo "Usage: $0 {func_name}"
  exit 1
fi