# .env.example is meant to be copied to .env
SECRET_KEY="fake"
DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1"
TIME_ZONE="Asia/Kolkata"
# Database is SQLite (db.sqlite3), created automatically on first migrate.
# Google OAuth credentials are NOT set here: run
#   ./run python manage.py addgoogleoauth <client_id> <secret>
# after migrating to store them in the database.

# opencode daemon — launched by `./run opencode`; Django proxies /agent/api/*
# to the same URL. A single knob drives both, so they can't drift apart.
# OPENCODE_BASE_URL="http://127.0.0.1:4196"
# Provider/model the daemon prompts with (defaults shown):
# OPENCODE_PROVIDER="zai-coding-plan"
# OPENCODE_MODEL="glm-5.2"
# Startup order: start `./run opencode` before `./run runserver` — the Django
# proxy 502s on /agent/api/* until the daemon is listening on that port.

# Logging / client-error capture
# Redis backs the per-identity rate limit on POST /client-errors — it's a hard
# dependency: if unreachable the endpoint fails closed (500), never accepting an
# unbounded report. Defaults to the local redis if unset. The SAME Redis is also
# the backend for Huey background tasks + cron (settings.HUEY reuses REDIS_URL),
# so ./run hueydev / ./run dev need it running too.
# REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"
