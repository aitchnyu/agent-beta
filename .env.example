# .env.example — DEV environment. Copy to .env (gitignored) and fill in.
# Layout is IDENTICAL to .env.vm.example (the VM template); keys that don't
# apply to dev are commented with a note. All keys must exist in both files.

# ── Core ──────────────────────────────────────────────────────────────────
# Generate with high entropy (256-bit):  openssl rand -hex 32
# the DEV env does NOT enforce DANGEROUSLYUNSET sentinel —
# `./run init` replaces SECRET_KEY, and DB_PASSWORD is your local postgres
# password (unset = DB connections just fail).
SECRET_KEY="DANGEROUSLYUNSET"
DEBUG="True"
ALLOWED_HOSTS="localhost,127.0.0.1"
TIME_ZONE="Asia/Kolkata"

# ── Database (Postgres — required; the app never uses SQLite) ─────────────
# Dev: create the DB once, e.g.
#   psql -U postgres -c "CREATE DATABASE app1_db;" -c "CREATE USER app1_user WITH PASSWORD '…';"
# matching the values below. On the VM, provisioning creates these from .env.vm.
DB_NAME="app1_db"
DB_USER="app1_user"
# Generate with:  openssl rand -hex 32   (dev: your local postgres password)
DB_PASSWORD="DANGEROUSLYUNSET"
DB_HOST="localhost"
DB_PORT="5432"

# ── Redis / client-error capture ──────────────────────────────────────────
# Redis backs the per-identity rate limit on POST /client-errors AND Huey
# (settings.HUEY reuses REDIS_URL). Required — no default.
REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"

# ── pi agent (TUI via `./run pi`) ──────────────────────────────────────────
# Only pi's BUILT-IN providers are supported (no custom endpoints; list:
# pi --list-models). AGENT_MODEL is provider-qualified and passed to pi
# verbatim. Auth rides the provider's NATIVE env var — pi's zai provider
# reads ZAI_API_KEY directly (other providers use their own native
# names: ANTHROPIC_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY…).
# Set the var(s) for the provider AGENT_MODEL points at. Both ship as
# active sentinels — the DEV env does not enforce them (./run init only
# replaces SECRET_KEY), but pi itself refuses/401s until they're real
# values.
ZAI_API_KEY="DANGEROUSLYUNSET"
AGENT_MODEL="DANGEROUSLYUNSET"

# collectstatic output directory (relative to the repo root; Caddy serves
# /static/* from it on the VM).
STATIC_ROOT="staticfiles"
# VM-only (kept here for key parity): the shared browser cache path
# provisioning installs to on the VM. Dev uses playwright's default cache.
# PLAYWRIGHT_BROWSERS_PATH="/srv/app/playwright-browsers"

# ── Git identity for agent commits ────────────────────────────────────────
# Only the committer NAME is pinned: agent-made commits are marked
# "Agent" as committer; author + emails fall back to git's
# defaults. Applies to every git process inheriting this env (set by .env
# here; by the shared credentials file on the VM).
# GIT_COMMITTER_NAME="Agent"

# ── VM-only knobs (set in .env.vm; unused in dev) ─────────────────────────
# granian/huey sizing (rendered into the systemd units by provisioning):
# GRANIAN_WORKERS="1"
# GRANIAN_THREADS="1"
# HUEY_WORKERS="2"   (VM provisioning requires ≥ 1 — huey always runs)

# ── Google OAuth ──────────────────────────────────────────────────────────
# Credentials are NOT set here: run
#   ./run python manage.py addgoogleoauth <client_id> <secret>
# after migrating to store them in the database.
