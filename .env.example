# .env.example — DEV environment. Copy to .env (gitignored) and fill in.
# Layout is IDENTICAL to deploy/template.env (the VM template); keys that
# don't apply to dev are commented with a note. All keys must exist in both
# files.
# The machine secrets are never hand-minted: on the VM the three
# (SECRET_KEY, DB_PASSWORD, VAPID_PRIVATE_KEY) are generated at provision
# time; in dev `./run init` generates SECRET_KEY and VAPID_PRIVATE_KEY, and
# DB_PASSWORD is your local postgres password.

# ── Core ──────────────────────────────────────────────────────────────────
# `./run init` fills a generated SECRET_KEY when it copies this template.
SECRET_KEY=""
DEBUG="True"
ALLOWED_HOSTS="localhost"
TIME_ZONE="Asia/Kolkata"
# Sessions expire this many days after the user's LAST REQUEST (sliding).
SESSION_IDLE_DAYS="14"

# ── Database (Postgres — required; the app never uses SQLite) ─────────────
# Dev: create the DB once, e.g.
#   psql -U postgres -c "CREATE DATABASE app1_db;" -c "CREATE USER app1_user WITH PASSWORD '…';"
# matching the values below. On the VM, provisioning creates these from
# deploy/template.env.
DB_NAME="app1_db"
DB_USER="app1_user"
# Dev: your local postgres password (empty = DB connections just fail).
DB_PASSWORD=""
DB_HOST="localhost"
DB_PORT="5432"

# ── Redis / client-error capture ──────────────────────────────────────────
# Redis backs the per-identity rate limit on POST /client-errors AND Huey
# (settings.HUEY reuses REDIS_URL). Required — no default.
REDIS_URL="redis://127.0.0.1:6379/0"
# Max client-error reports per identity (user, else IP) per 60s. 0 disables.
# CLIENT_ERROR_RATE_LIMIT="30"

# ── pi agent (TUI via `./run pi`) ──────────────────────────────────────────
# No env keys: provider auth and the startup model live in pi's OWN stores —
# /login <provider> in the TUI writes credentials to ~/.pi/agent/auth.json,
# and /model + Ctrl+S saves the startup model to ~/.pi/agent/settings.json
# (one-time local setup). A one-off override needs no env either:
# `./run pi --model <provider/model>`.

# ── Web Push notifications (bell + browser toasts) ────────────────────────
# Required, like DB_PASSWORD: `./run init` mints the P-256 scalar with the
# canonical recipe (deploy/gen-vapid-b64.sh)
VAPID_PRIVATE_KEY=""

# collectstatic output directory (relative to the repo root; Caddy serves
# /static/* from it on the VM).
STATIC_ROOT="staticfiles"
# VM-only (kept here for key parity): the shared browser cache path
# provisioning installs to on the VM. Dev uses playwright's default cache.
# PLAYWRIGHT_BROWSERS_PATH="/srv/desmo/playwright-browsers"

# ── Git identity for agent commits ────────────────────────────────────────
# Only the committer NAME is pinned: agent-made commits are marked
# "Agent" as committer; author + emails fall back to git's
# defaults. Applies to every git process inheriting this env (set by .env
# here; by the shared credentials file on the VM).
# GIT_COMMITTER_NAME="Agent"

# ── VM-only knobs (set in deploy/template.env; unused in dev) ───────────
# granian/huey sizing (rendered into the systemd units by provisioning):
# GRANIAN_WORKERS="1"
# GRANIAN_THREADS="1"
# HUEY_WORKERS="2"   (VM provisioning requires ≥ 1 — huey always runs)

# MAINTAIN-CONSISTENCY env-file — every key must exist in both this file
# and deploy/template.env (see INSTRUCTIONS.md).
