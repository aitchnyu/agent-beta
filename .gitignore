.venv
# Filled env files (from .env.example / .env.vm.example); never commit secrets.
.env
.env.vm
*.pyc
db.sqlite3
.DS_Store
*/__pycache__
uploads/
.idea/
# Host frontend dependencies.
node_modules/
# Vite build output (main bundle, code-split chunks, source maps); generated.
djangoapp/static/

# Python lint/type caches.
.mypy_cache/
.ruff_cache/

# coverage tool generates this
.coverage

# TypeScript incremental compilation cache
*.tsbuildinfo
# kilo stuff
.kilo/package-lock.json

# Playwright MCP (browser tooling) artifacts: snapshots, console logs
.playwright-mcp/

# pi agent state: sessions are isolated in-repo (sessionDir "sessions" in
# .pi/settings.json resolves against the working directory); project
# packages land under .pi/npm/. Tracked .pi/ content: settings.json,
# extensions/, agents/.
/sessions/
.pi/sessions/
.pi/npm/

# collectstatic output (STATIC_ROOT is repo-relative; seed ships none,
# the VM builds its own — never commit it)
staticfiles/
