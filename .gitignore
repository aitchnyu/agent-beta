# Installed apps live at the project root in apps/ at runtime (gitignored);
# anchored so it does NOT match djangoapp/apps/ or djangoapp/tests/apps/.
/apps/

.venv
.env
*.pyc
db.sqlite3
.DS_Store
*/__pycache__
uploads/
.idea/
# Any node_modules (host frontend + per-app/test-app frontends).
node_modules/
# js, css, map etc
djangoapp/static/djangoapp/main*
# Per-app build artifacts (buildapp output); built, not committed.
djangoapp/static/djangoapp/apps/

# coverage tool generates this
.coverage

# TypeScript incremental compilation cache
*.tsbuildinfo
# kilocode stuff
.kilo/package-lock.json
.kilocode/package-lock.json

# Playwright MCP (browser tooling) artifacts: snapshots, console logs
.playwright-mcp/

# Only uv.lock is tracked in this section; nothing else to ignore here.

