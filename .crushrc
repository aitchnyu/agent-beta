# Agent config for Crush (replaces agentconfig/opencode.json — see
# prompts/20260824-agent-crush-migration.md). Runs at startup with our env
# sourced (.env via ./run agent in dev; .env.vm via the console on the VM).
#
# Uses ONLY crush's built-in provider catalog — no `provider add`, no
# custom base URLs (nothing persists into ~/.local/share/crush/). The
# model is the single env knob: AGENT_MODEL, provider-qualified with the
# BUILT-IN provider id (e.g. "zai/glm-5.3" — list ids/models with
# `crush models`). Auth is each provider's NATIVE env var, exported by
# the env file (ZAI_API_KEY for z.ai, OPENROUTER_API_KEY for OpenRouter,
# …); crush reads it directly. The :? line makes crush refuse on an
# unset model.
#
# Project-level .crushrc has top priority, but a global ~/.config/crush/
# config still MERGES — ./run agent's preflight refuses if one exists.
# Tool names verified against crush v0.91.0 (binary strings).

model large "${AGENT_MODEL:?Refusing: AGENT_MODEL unset — provider-qualified built-in id, e.g. zai/glm-5.3}"

# steer.md is the agent's instructions file (crush would otherwise
# auto-read AGENTS.md / CRUSH.md — we ship neither on purpose).
option context-path agentconfig/steer.md
option auto-lsp false
option metrics false

# Read-only tools run unprompted; the bash + edit policy lives in the
# PreToolUse hooks below (deploy/crush_*_guard.py, unit-tested in
# deploy/tests/, wired into ./run checkframework1). Hook paths are RELATIVE and
# crush 0.91 only loads this file when cwd IS the project root (probed:
# hooks don't fire from subdirectories), so `./deploy/…` always resolves —
# `./run agent` enforces the root cwd; running bare `crush` from a subdir
# silently skips this whole file (including the hooks), not just paths.
permissions allow view ls grep glob web_search
permissions deny lsp_definition lsp_symbols lsp_call_hierarchy lsp_rename lsp_replace_symbol lsp_restart references

hook add PreToolUse --matcher "^bash$" \
  --command "./deploy/crush_bash_guard.py" --name bash-guard
hook add PreToolUse --matcher "^(edit|write|multiedit)$" \
  --command "./deploy/crush_edit_guard.py" --name edit-guard
