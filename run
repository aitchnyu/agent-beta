#!/bin/bash

set -euo pipefail

setenv() {
  if [ ! -f .env ]; then
    echo "Warning: .env file not found, relying on python-dotenv to load defaults or environment"
  fi
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      echo "Review .env and add necessary vars"
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests
  uv run playwright install firefox
  # Create the database
  psql -U postgres -c "CREATE DATABASE instant;" || echo "Database 'instant' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

runserver() {
  setenv
  djangomanage runserver
}

opencode() {
  # Bind address for the daemon. 4196, not opencode's default 4096: 4096
  # collides with the Kilo extension's random `kilo serve` server in this
  # session. A single knob — OPENCODE_BASE_URL (default below) — drives both
  # this launcher and Django's /agent/api/* proxy (djangoapp/views/
  # opencode.py)
  local base_url="${OPENCODE_BASE_URL:-http://127.0.0.1:4196}"
  local stripped="${base_url#http://}"; stripped="${stripped#https://}"
  stripped="${stripped%%/*}"
  local hostname="${stripped%%:*}"
  local port="${stripped##*:}"
  # Resolve paths from this script's location (the repo root = main/), not $PWD,
  # so `./run opencode` works no matter which directory it's invoked from.
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # Point opencode at agentconfig/ for the web-chat agent + permission rules.
  local config_dir="${OPENCODE_CONFIG_DIR:-$repo_root/agentconfig}"
  local config_file="${OPENCODE_CONFIG:-$repo_root/agentconfig/opencode.json}"

  # opencode scopes its workspace to the nearest enclosing git worktree, so run
  # the daemon from the PARENT of repo_root (the dir holding both main/ and
  # scratch/). scratch/ is a sibling of main/: when the daemon ran from main/ (its
  # git worktree), every read/edit of scratch/ tripped `external_directory` and
  # the relative `edit scratch/**` rule never matched (scratch/ was outside the
  # worktree). From parent/ as the worktree, scratch/ and main/ are both inside it
  # — scratch/** matches the allow rule, and no external_directory prompt fires. A
  # non-git parent would fall back to opencode's global "/" project, so parent/ is
  # made a git repo below. Paths above stay repo-root-relative (BASH_SOURCE), so
  # the `cd` only sets the daemon's cwd; opencode.json's `instructions` path is
  # parent-relative ("main/agentconfig/steer.md") to match.
  local parent_dir
  parent_dir="$(dirname "$repo_root")"
  cd "$parent_dir"
  # Ensure parent/ is its own git worktree (idempotent; no commit is needed —
  # opencode only wants the boundary, verified on opencode 1.18's project model).
  if [[ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$parent_dir" ]]; then
    git init -q
  fi

  # Preflight — fail fast before serving, in order:
  #   (1) the agentconfig/ config file exists,
  #   (2) no competing opencode config would override it,
  #   (3) the opencode binary is on PATH,
  #   (4) the config validates (`opencode debug config`),
  #   (5) the port is free to bind.
  # Each check prints why it refuses and returns 1.

  # (1) Config file exists — without it the daemon runs with no agent/permissions.
  [[ -f "$config_file" ]] || {
    echo "Refusing to start: $config_file not found" >&2
    return 1
  }

  # (2) No competing config — opencode merges every config it finds, which would
  #     override agentconfig/. Delete the other one so only $config_file is used.
  #     opencode also auto-creates an empty global ~/.config/opencode/opencode.jsonc
  #     (just $schema) on first run — that stub merges nothing, so discard it and
  #     continue; refuse only on a config with real content.
  # Where opencode stores its global (user-level) config.
  local global_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"

  # Walk the two global config names opencode uses. opencode auto-creates an
  # empty stub (just $schema) on first run — it merges nothing, so discard it;
  # a config with real content would override agentconfig/, so refuse to start.
  local global_config_file
  for global_config_file in \
    "$global_config_dir/opencode.json" \
    "$global_config_dir/opencode.jsonc"
  do
    [[ -f "$global_config_file" ]] || continue
    # Key-aware stub check: it's opencode's empty auto-stub only if $schema is
    # the sole top-level key. A minified one-liner with real keys (e.g.
    # {"$schema":"…","permission":…}) must NOT be deleted — the old line-based
    # sed deleted the whole $schema line and mis-classified those as empty.
    if grep -oE '"[^"]+"\s*:' "$global_config_file" | grep -qvE '"\$schema"\s*:'; then
      echo "Refusing to start: a real global opencode config exists at" \
        "$global_config_file; delete it so only $config_file is used." >&2
      return 1
    fi
    rm -f "$global_config_file"   # only $schema (or no keys) — empty stub
  done

  # Any other real config opencode would also merge — the parent_dir ones
  # matter because the daemon runs from there.
  local found_competing=0
  [[ -f "$global_config_dir/config.json" ]] && found_competing=1
  [[ -f "$repo_root/opencode.json" ]] && found_competing=1
  [[ -f "$parent_dir/opencode.json" ]] && found_competing=1
  [[ -f "$parent_dir/opencode.jsonc" ]] && found_competing=1
  [[ -n "${OPENCODE_CONFIG_CONTENT:-}" ]] && found_competing=1
  if (( found_competing )); then
    echo "Refusing to start: another opencode config exists (global" \
      "config.json, the daemon's working directory $parent_dir, or" \
      "\$OPENCODE_CONFIG_CONTENT); delete it so only $config_file is used." >&2
    return 1
  fi

  # (3) Binary on PATH — check before `debug config` so a missing binary isn't
  #     misreported as "config invalid".
  if ! command -v opencode >/dev/null 2>&1; then
    echo "opencode binary not found on PATH — install it first" >&2
    return 1
  fi

  # (4) Config valid — `opencode serve` starts even on an invalid config and
  #     only 400s per request, so validate first and refuse to serve if broken.
  local check_output
  if ! check_output=$(
    OPENCODE_CONFIG_DIR="$config_dir" OPENCODE_CONFIG="$config_file" \
      command opencode debug config 2>&1
  ); then
    echo "opencode config is invalid — refusing to serve:" >&2
    echo "$check_output" >&2
    return 1
  fi

  # (5) Port free — fail fast so the error names the cause instead of relying on
  #     opencode's bind-time failure (which can leave a half-started process).
  #     `lsof` is present on macOS.
  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Refusing to start: port $port is already in use (change OPENCODE_BASE_URL to override)." >&2
    return 1
  fi

  # All checks passed — announce and serve. If `serve` fails to bind
  # (permissions) opencode prints its own error and exits non-zero.
  echo "Starting opencode serve on ${hostname}:${port} (Ctrl+C to stop)…"
  OPENCODE_CONFIG_DIR="$config_dir" OPENCODE_CONFIG="$config_file" \
    command opencode serve --hostname "$hostname" --port "$port" "$@"
}

test() {
  setenv
  uv run manage.py test --exclude-tag playwright "$@"
}

coverage() {
  setenv
  uv run coverage run --source=djangoapp --omit='djangoapp/tests/test_playwright.py' manage.py test --exclude-tag playwright
  uv run coverage report -m
  uv run coverage html
  open htmlcov/index.html
}

typecheck() {
  setenv
  uv run mypy .
}

playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  uv run manage.py test --tag playwright --noinput
}

checkall() {
  setenv
  echo "Running ruff for formatting problems"
  uv run ruff check
  echo "Running mypy for type checking"
  uv run mypy .
  echo "Running test"
  test --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  cd ..
  echo "Running Playwright tests"
  playwrighttest
}

# The scratch/ fast loop: validate the agent's ourapp/ edits without re-running the
# unchanged framework suite or the slow browser pass. ruff + mypy (whole codebase
# — the agent's Python must pass), ourapp's OWN tests only (not djangoapp/tests/,
# which is identical to main/), and the frontend lint/typecheck/build (the build
# confirms the agent's frontend compiles; the browser pass is skipped). The full
# backend suite + Playwright stay in checkall, run in main/.
checkscratch() {
  setenv
  echo "Running ruff for formatting problems"
  uv run ruff check
  echo "Running mypy for type checking"
  uv run mypy .
  echo "Running ourapp tests (scoped; the framework suite runs in main/)"
  test ourapp --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  echo "Running frontend build"
  npm run build
  cd ..
}

lintfix() {
  setenv
  uv run ruff format
  uv run ruff check --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# Shared rsync exclude list for createscratch/mergescratch: skip git, the scratch
# tree itself, virtualenvs, build-tool output (dist/build), caches, and
# machine-local state. NOTE: djangoapp/static/ (the built frontend bundle) is
# intentionally NOT excluded — it's gitignored, and deploying it carries the
# agent's fresh build from scratch/ to main/ so the live server isn't left on a
# stale bundle. ``.env`` is copied INTO scratch/ (same machine, same DB) but
# never synced BACK to main/.
_SCRATCH_EXCLUDES=(
  --exclude='.git/'
  --exclude='scratch/'
  --exclude='node_modules/'
  --exclude='.venv/'
  --exclude='__pycache__/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
  --exclude='dist/'
  --exclude='build/'
  --exclude='.DS_Store'
)

# main/ is this script's dir; scratch/ is its sibling (both under parent/).
# Resolved once at load time so createscratch/mergescratch stay free of path
# boilerplate.
_MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRATCH_DIR="$(dirname "$_MAIN_DIR")/scratch"

# Build a fresh scratch/ from main/: rsync (shared excludes), own env, own
# throwaway git repo with a baseline commit. Shared by createscratch and
# checkproject.
_new_scratch() {
  rm -rf "$_SCRATCH_DIR"
  rsync -a "${_SCRATCH_EXCLUDES[@]}" "$_MAIN_DIR/" "$_SCRATCH_DIR/"
  ( cd "$_SCRATCH_DIR"
    uv sync
    cd frontend
    npm install
  )
  git -C "$_SCRATCH_DIR" init -q
  git -C "$_SCRATCH_DIR" config user.email "scratch@local"
  git -C "$_SCRATCH_DIR" config user.name "scratch"
  git -C "$_SCRATCH_DIR" add -A
  git -C "$_SCRATCH_DIR" commit -q -m "scratch baseline"
}

# Overlay an app's ourapp/ onto scratch/ourapp/ (full replace).
_overlay_app() {
  rsync -a --delete "$1/ourapp/" "$_SCRATCH_DIR/ourapp/"
}

createscratch() {
  # Fresh scratch/ of main/ (own env + git baseline) for the agent to edit + diff.
  _new_scratch
  echo "scratch/ ready at $_SCRATCH_DIR. Edit there, then run: ( cd $_SCRATCH_DIR && ./run checkscratch )"
}

mergescratch() {
  # Deploy scratch/ into main/ (rsync --delete; same excludes + .env so main's env
  # is never overwritten). Does NOT commit — committing is a separate step the
  # user does later. In dev, runserver auto-reloads main/ so the change is live.
  [ -d "$_SCRATCH_DIR" ] || { echo "Refusing: $_SCRATCH_DIR not found. Run createscratch first." >&2; return 1; }
  echo "Deploying $_SCRATCH_DIR/ → $_MAIN_DIR/ (--delete, excluding .env + generated dirs)…"
  rsync -a --delete "${_SCRATCH_EXCLUDES[@]}" --exclude='.env' "$_SCRATCH_DIR/" "$_MAIN_DIR/"
  echo "Deployed scratch/ → main/ (uncommitted). Commit in main/ when ready."
}

cleanscratch() {
  # Remove scratch/ outright (discard the scratch tree). Portable: uses
  # _SCRATCH_DIR (parent/scratch), so the agent calls `main/run cleanscratch`
  # without computing an absolute path — an absolute `rm -rf /…/scratch` isn't
  # allowlisted and prompts.
  if [ -d "$_SCRATCH_DIR" ]; then
    rm -rf "$_SCRATCH_DIR"
    echo "Removed $_SCRATCH_DIR."
  else
    echo "No scratch/ at $_SCRATCH_DIR to remove."
  fi
}

checkproject() {
  # The project tests need a real app; they self-skip unless RUN_PROJECT_TESTS is
  # set (so checkall skips them). Relies on set -e: a failure aborts and leaves scratch/ for inspection.
  
  echo "=== checkproject cycle 1: test app (lint + typecheck + project tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/djangoapp/tests/testapp"
  ( cd "$_SCRATCH_DIR"
    ./run lintfix
    ./run typecheck
    RUN_PROJECT_TESTS=1 uv run manage.py test --exclude-tag playwright --noinput
  )

  echo "=== checkproject cycle 2: reference app (its own tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/docs/reference"
  # The reference app ships its own Vue pages under
  # docs/reference/frontend/src/ours/; overlay them into scratch/frontend/src/ours/
  # (main.ts already globs ./ours/pages/**/*.vue) and build, so its /notes page
  # (Inertia component "ours/NotesPage") is in the bundle the live server serves.
  rsync -a "$_MAIN_DIR/docs/reference/frontend/src/ours/" "$_SCRATCH_DIR/frontend/src/ours/"
  ( cd "$_SCRATCH_DIR"
    ( cd frontend && npm run build )
    uv run manage.py test ourapp --noinput
  )

  rm -rf "$_SCRATCH_DIR"
  echo "checkproject green."
}

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  echo "Usage: $0 {func_name}"
  exit 1
fi
