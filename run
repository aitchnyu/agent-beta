#!/bin/bash

set -euo pipefail

# Color in tool/test output: keep it in a real terminal, strip it when captured
# (agent logs, pipes) so ANSI escapes don't pollute the captured text. NO_COLOR
# is the broad switch (eslint/vitest/vite/Django/ruff/mypy all respect it); the
# explicit flags are belt-and-suspenders for the tools the agent runs most.
if [ -t 1 ]; then
  _RUFF_COLOR=
  _MYPY_COLOR=
  _DJANGO_NO_COLOR=
else
  _RUFF_COLOR=--color=never
  _MYPY_COLOR=--no-color-output
  _DJANGO_NO_COLOR=--no-color
  export NO_COLOR=1
  # FORCE_COLOR (injected by e.g. concurrently) makes chalk ignore NO_COLOR
  unset FORCE_COLOR
fi

setenv() {
  # Load the environment by shell-sourcing (no python-dotenv): `set -a`
  # exports every assignment; only plain KEY="value" lines + comments (no
  # command substitution). Dev: ./.env; on the VM the single source is the
  # credentials file the units also read (/etc/credentials/app/.env.vm).
  if [ -f .env ]; then
    set -a
    . ./.env
    set +a
    return 0
  fi
  # ie, we are inside vm
  if [ -f /etc/credentials/app/.env.vm ]; then
    set -a
    . /etc/credentials/app/.env.vm
    set +a
    return 0
  fi
  echo "Warning: no .env (dev) or /etc/credentials/app/.env.vm (VM) — relying on ambient environment." >&2
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      # Generate a real SECRET_KEY (sessions/password-reset need one);
      # DB_PASSWORD stays sentinel for the operator (it must match their
      # local postgres).
      if command -v openssl >/dev/null 2>&1; then
        sed -i.bak "s#^SECRET_KEY=.*#SECRET_KEY=\"$(openssl rand -hex 32)\"#" .env && rm -f .env.bak
      fi
      echo "Created .env with a generated SECRET_KEY — set DB_PASSWORD (your local postgres password) next."
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests
  uv run playwright install firefox
  # Create the database (name/user come from .env — convention <appname>_db)
  psql -U postgres -c "CREATE DATABASE $DB_NAME;" || echo "Database '$DB_NAME' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

runserver() {
  setenv
  djangomanage runserver
}

hueydev() {
  # Huey consumer for dev run in the foreground. Auto-discovers each installed app's
  # tasks.py (ourapp.tasks) and runs periodic + enqueued tasks. Redis must be
  # running (REDIS_URL). For prod, its run with systemd.
  setenv
  djangomanage run_huey "$@"
}

dev() {
  # The whole dev stack in one terminal via `concurrently`: runserver + vite
  # watch + huey + ttyd console (Ctrl-C stops all). The console at
  # http://localhost:7681 spawns shells in the repo with the shared banner
  # rcfile (`./run console` runs it standalone). The start command is
  # required — bare ttyd exits 254 per connection and reconnect-loops.
  setenv
  if ! command -v ttyd >/dev/null 2>&1; then
    echo "ttyd not found — install it (macOS: brew install ttyd) for the dev console; starting the rest." >&2
    frontend/node_modules/.bin/concurrently -n runserver,vite,huey -c blue,green,cyan \
      "./run runserver" \
      "cd frontend && npm run dev" \
      "./run hueydev"
    return 0
  fi
  frontend/node_modules/.bin/concurrently -n runserver,vite,huey,console -c blue,green,cyan,magenta \
    "./run runserver" \
    "cd frontend && npm run dev" \
    "./run hueydev" \
    "./run console"
}

console() {
  # The web console ALONE: ttyd on http://localhost:7681 (also part of
  # `./run dev`). Shells land IN THE REPO and read deploy/console-bashrc
  # (the banner + the normal bashrc chain) — the same rcfile the VM's
  # console_ttyd unit uses. The start command is required: bare ttyd
  # exits 254 per connection and reconnect-loops. Run `./run agent` (or
  # crush) inside the browser terminal for the agent.
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  command -v ttyd >/dev/null 2>&1 || {
    echo "ttyd not found — install it first (macOS: brew install ttyd)" >&2
    return 1
  }
  # Kill a stale console (this dev stack's or standalone) — idempotent relaunch.
  pkill -f "ttyd -W -i 127.0.0.1 -p 7681" 2>/dev/null || true
  setenv
  ttyd -W -i 127.0.0.1 -p 7681 -w "$repo_root" \
    -- /bin/bash --rcfile "$repo_root/deploy/console-bashrc"
}

agent() {
  # The agent: exec the Crush TUI with the .env environment (model, the
  # provider's native auth var, git identity) exported by setenv — dev and
  # VM alike. Config is the repo-root .crushrc (Bash — built-in providers
  # only; it reads AGENT_MODEL straight from this environment); the
  # bash/edit permission policy lives in deploy/crush_*_guard.py, wired
  # from .crushrc as PreToolUse hooks.
  setenv
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local config_file="$repo_root/.crushrc"

  # Run from the REPO ROOT (main/): the TUI's pwd is the actual repo, and
  # .crushrc's relative paths (agentconfig/steer.md, the guard hooks) are
  # working-dir-relative. No parent-cd, no parent git-init — main/ is its
  # own repo everywhere; scratch/ is a SIBLING, reachable via the
  # sanctioned compounds and scratch paths the guards allow.
  cd "$repo_root"

  # (1) Binary on PATH.
  command -v crush >/dev/null 2>&1 || {
    echo "crush binary not found on PATH — install it first" \
      "(npm install -g @charmland/crush)" >&2
    return 1
  }

  # (2) Config file exists and parses — without it the agent runs with no
  #     permissions; with a syntax error crush may start half-configured.
  [[ -f "$config_file" ]] || {
    echo "Refusing to start: $config_file not found" >&2
    return 1
  }
  local syntax_output
  if ! syntax_output=$(bash -n "$config_file" 2>&1); then
    echo "Refusing to start: .crushrc has a syntax error:" >&2
    echo "$syntax_output" >&2
    return 1
  fi

  # (3) No competing config — crush MERGES everything it finds (project
  #     .crushrc + ./crushrc + legacy .crush.json/crush.json + the global
  #     ~/.config/crush/ equivalents); any of those would layer settings
  #     over ours. Refuse on every one we don't ship ourselves.
  #     (Also /etc/crush/crush.json — a root-owned system-wide slot that
  #     normally doesn't exist; refuse if someone created one.)
  local global_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/crush"
  local competitor
  for competitor in \
    /etc/crush/crush.json \
    "$repo_root/crushrc" \
    "$repo_root/.crush.json" \
    "$repo_root/crush.json" \
    "$global_config_dir/crushrc" \
    "$global_config_dir/crush.json" \
    "$global_config_dir/.crush.json"
  do
    if [[ -f "$competitor" ]]; then
      echo "Refusing to start: a competing crush config exists at" \
        "$competitor; delete it so only $config_file is used." >&2
      return 1
    fi
  done

  # (4) Model knob set — .crushrc's :? line also enforces it, but with a
  #     bash error inside the TUI; refuse up front with a clear message.
  #     Auth is NOT checked here: it rides the provider's NATIVE env var
  #     (ZAI_API_KEY etc.), whose name varies by provider — crush itself
  #     fails loudly when it's missing.
  if [[ -z "${AGENT_MODEL:-}" ]]; then
    echo "Refusing to start: AGENT_MODEL is unset/empty — provider-qualified" \
      "built-in id, e.g. \"zai/glm-5.3\" (list with \`crush models\`)." >&2
    return 1
  fi

  # All checks passed — hand the terminal over to the TUI.
  command crush "$@"
}

test() {
  setenv
  uv run manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright "$@"
}

coverage() {
  setenv
  uv run coverage run --source=djangoapp --omit='djangoapp/tests/test_playwright.py' manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright
  uv run coverage report -m
  uv run coverage html
  open htmlcov/index.html
}

typecheck() {
  setenv
  uv run mypy $_MYPY_COLOR .
}

playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  uv run manage.py test $_DJANGO_NO_COLOR --tag playwright --noinput
}

checkframework1() {
  setenv
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running test"
  test --noinput
  echo "Running deploy/ hook unit tests (Crush guards)"
  uv run python -m unittest discover -s deploy/tests
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  cd ..
  echo "Running Playwright tests"
  playwrighttest
}

# The deployment gate: rebuild the test VM FROM SCRATCH (destructive — the
# old VM's git + database are gone), deploy the Books test app
# (djangoapp/tests/testapp) over the VM's ourapp/, then smoke the LIVE
# stack over HTTPS from the host (caddy TLS, granian, postgres, login
# links, the /agent forward_auth superuser gate) — what only a real
# deployment shows.
#
# Organized as Setup 1-4 (build/deploy/mint) then Assert 1-6 (the
# HTTP smoke, one banner per assertion, first failure aborts).
checkframework2() {
  setenv
  local vm_base="https://app.local"

  # Source the credentials env and enter the repo — embedded into every
  # vm_app invocation below via `declare -f`, so the body stays ordinary
  # (highlighted, lintable) shell.
  _vm_env() {
    set -a
    . /etc/credentials/app/.env.vm
    set +a
    cd /srv/app/main
  }

  # Run a command in the VM as the app user, with env sourced and the repo
  # as cwd. $1 embeds verbatim — pass single-quoted literals only (no $,
  # backticks, or embedded quotes in the payload).
  vm_app() {
    multipass exec app -- sudo -u app -H bash -c "$(declare -f _vm_env); _vm_env; $1"
  }

  # assert <expected[ expected...]> <got> <what-is-being-asserted> — a single
  # value ("404") or space-separated alternatives ("302 200"). NB: a
  # case-pattern CANNOT take its | alternation from an expanded variable
  # (parse-time construct), hence the loop. Failures name the assertion and
  # abort under set -e, like every other check in this script.
  assert() {
    local alt
    for alt in $1; do
      [ "$alt" = "$2" ] && return 0
    done
    echo "FAILED: $3 (expected $1, got $2)" >&2
    return 1
  }

  # assert_contains <file> <pattern> <what-is-being-asserted>
  assert_contains() {
    grep -q "$2" "$1" || { echo "FAILED: $3 ($1 lacks '$2')" >&2; return 1; }
  }

  # Extract the shipped testapp tarball over the VM's ourapp/ (full
  # replace), fix ownership/group-write, remove the tarball. Runs as root
  # via `sudo bash -c "$(declare -f deploy_ourapp); deploy_ourapp"`.
  deploy_ourapp() {
    tar xzf /tmp/testapp-ourapp.tgz -C /srv/app/main
    chown -R app:app /srv/app/main/ourapp
    find /srv/app/main/ourapp -exec chmod g+w {} +
    rm -f /tmp/testapp-ourapp.tgz
  }

  # ── Setup 1/4: rebuild the VM from scratch ─────────────────────────────
  # Delete any existing 'app' VM (destructive), provision a fresh one via
  # ./testvm. Gated by provision's own set -e: every phase it runs
  # (packages, tree, seed, bootstrap, services) must exit 0.
  echo "=== Setup 1/4: rebuild the VM from scratch (destructive) ==="
  if multipass info app >/dev/null 2>&1; then
    "$_MAIN_DIR/testvm" delete
  fi
  "$_MAIN_DIR/testvm" provision

  # ── Setup 2/4: deploy the Books test app ───────────────────────────────
  # Tar the testapp's ourapp/, ship it, then extract over the VM's
  # /srv/app/main/ourapp (full replace) as root — the body lives in
  # deploy_ourapp below (embedded via `declare -f`). Gated by each
  # command's exit code.
  echo "=== Setup 2/4: deploy the Books test app over the VM's ourapp/ ==="
  (cd "$_MAIN_DIR/djangoapp/tests/testapp" && COPYFILE_DISABLE=1 tar czf /tmp/testapp-ourapp.tgz ourapp)
  multipass transfer /tmp/testapp-ourapp.tgz app:/tmp/testapp-ourapp.tgz
  multipass exec app -- sudo bash -c "$(declare -f deploy_ourapp); deploy_ourapp"

  # ── Setup 3/4: migrate, restart the app ─────────────────────────────────
  # Migrate the fresh database, create the smoke superuser
  # (framework@example.com, "Framework Smoke"), restart granian on the new
  # code. Gated by each command's exit code.
  echo "=== Setup 3/4: migrate, create the smoke superuser ==="
  vm_app '.venv/bin/python manage.py migrate --noinput'
  vm_app '.venv/bin/python manage.py createuser framework@example.com --first-name Framework --last-name Smoke --superuser'
  multipass exec app -- sudo systemctl restart app_granian.service

  # ── Setup 4/4: mint the one-time superuser login link ──────────────────
  # makeloginlink inside the VM, extract the URL; the cookie jar captures
  # the session the assertions below ride on.
  echo "=== Setup 4/4: mint the one-time superuser login link ==="
  local link
  link=$(vm_app '.venv/bin/python manage.py makeloginlink framework@example.com --base-url https://app.local' \
    | grep -oE "https://app\.local/login-for-test/[^ ]+/" | head -1) || true
  [ -n "$link" ] || { echo "FAILED: no login link minted" >&2; return 1; }
  local cookie_jar
  cookie_jar="$(mktemp)"
  trap 'rm -f "$cookie_jar"' RETURN

  local code body agent_dump agent_anon_dump

  # ── Assert 1/6: the login link redeems ─────────────────────────────────
  # 302 (redirect after login; 200 also fine) and leaves a session cookie
  # in the jar.
  echo "=== Assert 1/6: login link redeems ==="
  code=$(curl -k -sS -o /dev/null -w '%{http_code}' -c "$cookie_jar" "$link")
  assert "302 200" "$code" "login link redemption status"

  # ── Assert 2/6: /users/list gate, anonymous ────────────────────────────
  # The framework superuser route hides from anonymous viewers: 404.
  echo "=== Assert 2/6: anonymous /users/list → 404 ==="
  code=$(curl -k -sS -o /dev/null -w '%{http_code}' "$vm_base/users/list")
  assert 404 "$code" "anonymous /users/list"

  # ── Assert 3/6: /users/list gate, superuser session ────────────────────
  # 200 proves the redeemed cookie is a real superuser session.
  echo "=== Assert 3/6: authed /users/list → 200 (session proof) ==="
  code=$(curl -k -sS -o /dev/null -w '%{http_code}' -b "$cookie_jar" "$vm_base/users/list")
  assert 200 "$code" "authed /users/list (session proof)"

  # ── Assert 4/6: home renders the test app ──────────────────────────────
  # The home page shows the smoke user's display name "Framework Smoke".
  echo "=== Assert 4/6: home shows the smoke user ==="
  body=$(curl -k -sS -b "$cookie_jar" "$vm_base/")
  grep -q "Framework Smoke" <<<"$body" \
    || { echo "FAILED: home does not show the smoke user" >&2; return 1; }

  # ── Assert 5/6: /agent gate, anonymous ─────────────────────────────────
  # Caddy forward_auth (→ /agent/auth): anonymous/non-superuser → 404,
  # relayed verbatim. The body must render OUR 404 template with the AUTH
  # SUBREQUEST's path (/agent/auth) — the fingerprint of the verdict
  # actually flowing through agent_auth. A plain Django catch-all 404
  # (caddy block missing) would render "/agent/" instead; a caddy-native
  # respond would be text/plain.
  echo "=== Assert 5/6: anonymous /agent → 404 via forward_auth ==="
  agent_anon_dump="$(mktemp)"
  code=$(curl -k -sS -o "$agent_anon_dump" -w '%{http_code}' "$vm_base/agent/")
  assert 404 "$code" "anonymous /agent (forward_auth gate)"
  assert_contains "$agent_anon_dump" "/agent/auth" "anonymous /agent 404 came from agent_auth (not a catch-all)"
  rm -f "$agent_anon_dump"

  # ── Assert 6/6: /agent gate, superuser session ─────────────────────────
  # 2xx verdict → caddy proxies to ttyd, whose terminal page serves. The
  # markers are ttyd's own title + an xterm renderer class from its JS
  # bundle — not merely the string "ttyd", which an error page echoing
  # the request could satisfy.
  echo "=== Assert 6/6: superuser /agent → 200, ttyd terminal page ==="
  agent_dump="$(mktemp)"
  code=$(curl -k -sS -o "$agent_dump" -w '%{http_code}' -b "$cookie_jar" "$vm_base/agent/")
  assert 200 "$code" "superuser /agent (forward_auth passed)"
  assert_contains "$agent_dump" "<title>ttyd - Terminal</title>" "/agent serves ttyd's page (ttyd title)"
  assert_contains "$agent_dump" "BaseRenderLayer" "/agent serves ttyd's xterm bundle"
  rm -f "$agent_dump"

  echo "checkframework2 green."
}

# The scratch/ fast loop: validate the agent's ourapp/ edits without re-running the
# unchanged framework suite or the slow browser pass. ruff + mypy (whole codebase
# — the agent's Python must pass), ourapp's OWN tests only (not djangoapp/tests/,
# which is identical to main/), and the frontend lint/typecheck/build (the build
# confirms the agent's frontend compiles; the browser pass is skipped). The full
# backend suite + Playwright stay in checkframework1, run in main/.
checkscratch() {
  setenv
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running ourapp tests (scoped; the framework suite runs in main/)"
  test ourapp --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  echo "Running frontend build"
  npm run build
  cd ..
  # Framework-file watch: diff the working tree (committed-since-baseline,
  # staged, unstaged, untracked) against scratch's seeded baseline commit.
  # Edits OUTSIDE the agent's app surface (ourapp/, frontend/src/ours/) mean
  # framework code changed → run the framework-subset smoke tests: the
  # view tests tagged `framework-subset` + the one browser smoke class,
  # a ~5-10s fraction of checkframework1 as an early-warning gate. The
  # FULL suite still gates in main/ via checkframework1.
  local baseline outside
  baseline=$(git -C "$_SCRATCH_DIR" rev-list --max-parents=0 HEAD)
  outside=$(
    {
      git -C "$_SCRATCH_DIR" diff --name-only "$baseline"
      git -C "$_SCRATCH_DIR" ls-files --others --exclude-standard
    } | sort -u | grep -vE '^(ourapp/|frontend/src/ours/)' || true
  )
  if [ -n "$outside" ]; then
    echo "=== framework files changed — running framework-subset smoke tests ==="
    printf '  %s\n' $(grep -c . <<<"$outside") files:
    printf '  %s\n' $outside
    uv run manage.py test $_DJANGO_NO_COLOR --noinput --tag=framework-subset
  else
    echo "No framework-file changes (outside ourapp/ + frontend/src/ours/) — skipping framework-subset smoke."
  fi
}

lintfix() {
  setenv
  uv run ruff format $_RUFF_COLOR
  uv run ruff check $_RUFF_COLOR --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# Shared rsync exclude list for createscratch/mergescratch: skip git, the scratch
# tree itself, virtualenvs, build-tool output (dist/build), caches, and
# machine-local state. NOTE: djangoapp/static/ (the built frontend bundle) is
# intentionally NOT excluded — it's gitignored, and deploying it carries the
# agent's fresh build from scratch/ to main/ so the live server isn't left on a
# stale bundle. ``.env`` is copied INTO scratch/ (same machine, same DB) but
# never synced BACK to main/.
_SCRATCH_EXCLUDES=(
  --exclude='.git/'
  --exclude='.kilo/'
  --exclude='.crush/'
  --exclude='scratch/'
  --exclude='node_modules/'
  --exclude='.venv/'
  --exclude='__pycache__/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
  --exclude='dist/'
  --exclude='build/'
  --exclude='staticfiles/'   # collectstatic output (VM serving); regenerated, never source
  --exclude='.DS_Store'
)

# main/ is this script's dir; scratch/ is its sibling (both under parent/).
# Resolved once at load time so createscratch/mergescratch stay free of path
# boilerplate.
_MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRATCH_DIR="$(dirname "$_MAIN_DIR")/scratch"

# Build a fresh scratch/ from main/: rsync (shared excludes), own env, own
# throwaway git repo with a baseline commit. Shared by createscratch and
# checkproject.
_new_scratch() {
  rm -rf "$_SCRATCH_DIR"
  rsync -a "${_SCRATCH_EXCLUDES[@]}" "$_MAIN_DIR/" "$_SCRATCH_DIR/"
  ( cd "$_SCRATCH_DIR"
    uv sync
    cd frontend
    npm install
  )
  git -C "$_SCRATCH_DIR" init -q
  # VM/CI fallback only: with no global git identity (the VM never sets
  # one) git cannot derive an email from the .local hostname and commits
  # would fail — seed the scratch repo with author + blank email. The
  # agent marker still rides GIT_COMMITTER_NAME from the environment; on
  # dev a global identity exists and is left untouched (the human authors).
  if ! git -C "$_SCRATCH_DIR" config --get user.name >/dev/null 2>&1 \
     && ! git config --get user.name >/dev/null 2>&1; then
    git -C "$_SCRATCH_DIR" config user.name "$(id -un)"
    git -C "$_SCRATCH_DIR" config user.email ""
  fi
  git -C "$_SCRATCH_DIR" add -A
  git -C "$_SCRATCH_DIR" commit -q -m "scratch baseline"
}

# Overlay an app's ourapp/ onto scratch/ourapp/ (full replace).
_overlay_app() {
  rsync -a --delete "$1/ourapp/" "$_SCRATCH_DIR/ourapp/"
}

createscratch() {
  # Fresh scratch/ of main/ (own env + git baseline) for the agent to edit + diff.
  _new_scratch
  echo "scratch/ ready at $_SCRATCH_DIR. Edit there, then run: ( cd $_SCRATCH_DIR && ./run checkscratch )"
}

mergescratch() {
  # Deploy scratch/ into main/ (rsync --delete; same excludes + .env so main's env
  # is never overwritten). Does NOT commit — committing is a separate step the
  # user does later. In dev, runserver auto-reloads main/ so the change is live.
  # On the test VM there is no auto-restart (decision: no restart rule): static
  # is refreshed (collectstatic, live immediately) and the restart command is
  # printed for the operator/agent to run via console's sudo.
  [ -d "$_SCRATCH_DIR" ] || { echo "Refusing: $_SCRATCH_DIR not found. Run createscratch first." >&2; return 1; }
  echo "Deploying $_SCRATCH_DIR/ → $_MAIN_DIR/ (--delete, excluding .env + generated dirs)…"
  rsync -a --delete "${_SCRATCH_EXCLUDES[@]}" --exclude='.env' "$_SCRATCH_DIR/" "$_MAIN_DIR/"
  if [ -f /etc/credentials/app/.env.vm ]; then
    echo "VM detected: collectstatic (static live immediately)…"
    ( cd "$_MAIN_DIR" && .venv/bin/python manage.py collectstatic --noinput --clear )
    echo "Code changes need a restart: sudo systemctl restart app_granian app_huey"
  fi
  echo "Deployed scratch/ → main/ (uncommitted). Commit in main/ when ready."
}

cleanscratch() {
  # Remove scratch/ outright (discard the scratch tree). Portable: uses
  # _SCRATCH_DIR (../scratch relative to this script), so the agent calls
  # `./run cleanscratch` from the repo without computing an absolute path —
  # an absolute `rm -rf /…/scratch` isn't allowlisted and prompts.
  if [ -d "$_SCRATCH_DIR" ]; then
    rm -rf "$_SCRATCH_DIR"
    echo "Removed $_SCRATCH_DIR."
  else
    echo "No scratch/ at $_SCRATCH_DIR to remove."
  fi
}

checkproject() {
  # The project tests need a real app; they self-skip unless RUN_PROJECT_TESTS is
  # set (so checkframework1 skips them). Relies on set -e: a failure aborts and leaves scratch/ for inspection.
  
  echo "=== checkproject cycle 1: test app (lint + typecheck + project tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/djangoapp/tests/testapp"
  ( cd "$_SCRATCH_DIR"
    ./run lintfix
    ./run typecheck
    RUN_PROJECT_TESTS=1 ./run test --noinput
  )

  echo "=== checkproject cycle 2: reference app (its own tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/docs/reference"
  # The reference app ships its own Vue pages under
  # docs/reference/frontend/src/ours/; overlay them into scratch/frontend/src/ours/
  # (main.ts already globs ./ours/pages/**/*.vue) and build, so its /notes page
  # (Inertia component "ours/NotesPage") is in the bundle the live server serves.
  rsync -a "$_MAIN_DIR/docs/reference/frontend/src/ours/" "$_SCRATCH_DIR/frontend/src/ours/"
  ( cd "$_SCRATCH_DIR"
    ( cd frontend && npm run build )
    ./run test --noinput ourapp
  )

  rm -rf "$_SCRATCH_DIR"
  echo "checkproject green."
}

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  echo "Usage: $0 {func_name}"
  exit 1
fi
