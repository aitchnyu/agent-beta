#!/bin/bash

set -euo pipefail

# Color in tool/test output: keep it in a real terminal, strip it when captured
# (agent logs, pipes) so ANSI escapes don't pollute the captured text. NO_COLOR
# is the broad switch (eslint/vitest/vite/Django/ruff/mypy all respect it); the
# explicit flags are belt-and-suspenders for the tools the agent runs most.
if [ -t 1 ]; then
  _RUFF_COLOR=
  _MYPY_COLOR=
  _DJANGO_NO_COLOR=
else
  _RUFF_COLOR=--color=never
  _MYPY_COLOR=--no-color-output
  _DJANGO_NO_COLOR=--no-color
  export NO_COLOR=1
  # FORCE_COLOR (injected by e.g. concurrently) makes chalk ignore NO_COLOR
  unset FORCE_COLOR
fi

setenv() {
  # Load the environment by shell-sourcing (no python-dotenv): `set -a`
  # exports every assignment; only plain KEY="value" lines + comments (no
  # command substitution). Dev: ./.env; on the VM the single source is the
  # credentials file the units also read (/etc/credentials/app/.env.vm).
  if [ -f .env ]; then
    set -a
    . ./.env
    set +a
    return 0
  fi
  # ie, we are inside vm
  if [ -f /etc/credentials/app/.env.vm ]; then
    set -a
    . /etc/credentials/app/.env.vm
    set +a
    return 0
  fi
  echo "Warning: no .env (dev) or /etc/credentials/app/.env.vm (VM) — relying on ambient environment." >&2
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      # Generate a real SECRET_KEY (sessions/password-reset need one);
      # DB_PASSWORD stays sentinel for the operator (it must match their
      # local postgres).
      if command -v openssl >/dev/null 2>&1; then
        sed -i.bak "s#^SECRET_KEY=.*#SECRET_KEY=\"$(openssl rand -hex 32)\"#" .env && rm -f .env.bak
      fi
      echo "Created .env with a generated SECRET_KEY — set DB_PASSWORD (your local postgres password) next."
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests
  uv run playwright install firefox
  # Create the database (name/user come from .env — convention <appname>_db)
  psql -U postgres -c "CREATE DATABASE $DB_NAME;" || echo "Database '$DB_NAME' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

runserver() {
  setenv
  djangomanage runserver
}

hueydev() {
  # Huey consumer for dev run in the foreground. Auto-discovers each installed app's
  # tasks.py (ourapp.tasks) and runs periodic + enqueued tasks. Redis must be
  # running (REDIS_URL). For prod, its run with systemd.
  setenv
  djangomanage run_huey "$@"
}

dev() {
  # The whole dev stack in one terminal via `concurrently`: runserver + vite
  # watch + huey + ttyd console (Ctrl-C stops all). The console at
  # http://localhost:7681 spawns shells in the repo with the shared banner
  # rcfile (`./run console` runs it standalone). The start command is
  # required — bare ttyd exits 254 per connection and reconnect-loops.
  setenv
  if ! command -v ttyd >/dev/null 2>&1; then
    echo "ttyd not found — install it (macOS: brew install ttyd) for the dev console; starting the rest." >&2
    frontend/node_modules/.bin/concurrently -n runserver,vite,huey -c blue,green,cyan \
      "./run runserver" \
      "cd frontend && npm run dev" \
      "./run hueydev"
    return 0
  fi
  frontend/node_modules/.bin/concurrently -n runserver,vite,huey,console -c blue,green,cyan,magenta \
    "./run runserver" \
    "cd frontend && npm run dev" \
    "./run hueydev" \
    "./run console"
}

console() {
  # The web console ALONE: ttyd on http://localhost:7681 (also part of
  # `./run dev`). Shells land IN THE REPO and read deploy/console-bashrc
  # (the banner + the normal bashrc chain) — the same rcfile the VM's
  # console_ttyd unit uses. The start command is required: bare ttyd
  # exits 254 per connection and reconnect-loops. Run `./run agent` (or
  # opencode) inside the browser terminal for the agent.
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  command -v ttyd >/dev/null 2>&1 || {
    echo "ttyd not found — install it first (macOS: brew install ttyd)" >&2
    return 1
  }
  # Kill a stale console (this dev stack's or standalone) — idempotent relaunch.
  pkill -f "ttyd -W -i 127.0.0.1 -p 7681" 2>/dev/null || true
  setenv
  ttyd -W -i 127.0.0.1 -p 7681 -w "$repo_root" \
    -- /bin/bash --rcfile "$repo_root/deploy/console-bashrc"
}

agent() {
  # The agent: exec the opencode TUI with the .env environment (auth/model,
  # git identity) exported by setenv — dev and VM alike. Preflight: config
  # exists, no competing config, binary present, config valid.
  setenv
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  local config_dir="${OPENCODE_CONFIG_DIR:-$repo_root/agentconfig}"
  local config_file="${OPENCODE_CONFIG:-$repo_root/agentconfig/opencode.json}"

  # Run from the REPO ROOT (main/): the TUI's pwd is the actual repo, and
  # permission paths in agentconfig/opencode.json are working-dir-relative
  # (instructions: agentconfig/steer.md; scratch/ is a SIBLING and is
  # allowed via external_directory there). No parent-cd, no parent git-init
  # — main/ is its own repo everywhere; scratch/ rides the external allows.
  cd "$repo_root"

  # (1) Config file exists — without it the agent runs with no permissions.
  [[ -f "$config_file" ]] || {
    echo "Refusing to start: $config_file not found" >&2
    return 1
  }

  # (2) No competing config — opencode merges every config it finds, which
  #     would override agentconfig/. opencode also auto-creates an empty
  #     global stub (just $schema) on first run; that merges nothing, so
  #     discard it and continue — refuse only on a config with real content.
  local global_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
  local global_config_file
  for global_config_file in \
    "$global_config_dir/opencode.json" \
    "$global_config_dir/opencode.jsonc"
  do
    [[ -f "$global_config_file" ]] || continue
    # Key-aware stub check: it's the empty auto-stub only if $schema is the
    # sole top-level key (a minified one-liner with real keys must NOT be
    # deleted).
    if grep -oE '"[^"]+"\s*:' "$global_config_file" | grep -qvE '"\$schema"\s*:'; then
      echo "Refusing to start: a real global opencode config exists at" \
        "$global_config_file; delete it so only $config_file is used." >&2
      return 1
    fi
    rm -f "$global_config_file"   # only $schema (or no keys) — empty stub
  done
  local found_competing=0
  [[ -f "$global_config_dir/config.json" ]] && found_competing=1
  [[ -f "$repo_root/opencode.json" ]] && found_competing=1
  [[ -f "$repo_root/opencode.jsonc" ]] && found_competing=1
  [[ -f "$repo_root/../opencode.json" ]] && found_competing=1
  [[ -f "$repo_root/../opencode.jsonc" ]] && found_competing=1
  [[ -n "${OPENCODE_CONFIG_CONTENT:-}" ]] && found_competing=1
  if (( found_competing )); then
    echo "Refusing to start: another opencode config exists (global" \
      "config.json, the repo or its parent, or" \
      "\$OPENCODE_CONFIG_CONTENT); delete it so only $config_file is used." >&2
    return 1
  fi

  # (3) Binary on PATH — check before `debug config` so a missing binary
  #     isn't misreported as "config invalid".
  command -v opencode >/dev/null 2>&1 || {
    echo "opencode binary not found on PATH — install it first" >&2
    return 1
  }

  # (4) Config valid — the TUI starts even on an invalid config and only
  #     errors per request, so validate first and refuse if broken.
  local check_output
  if ! check_output=$(
    OPENCODE_CONFIG_DIR="$config_dir" OPENCODE_CONFIG="$config_file" \
      command opencode debug config 2>&1
  ); then
    echo "opencode config is invalid — refusing to start:" >&2
    echo "$check_output" >&2
    return 1
  fi

  # All checks passed — hand the terminal over to the TUI.
  OPENCODE_CONFIG_DIR="$config_dir" OPENCODE_CONFIG="$config_file" \
    command opencode "$@"
}

test() {
  setenv
  uv run manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright "$@"
}

coverage() {
  setenv
  uv run coverage run --source=djangoapp --omit='djangoapp/tests/test_playwright.py' manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright
  uv run coverage report -m
  uv run coverage html
  open htmlcov/index.html
}

typecheck() {
  setenv
  uv run mypy $_MYPY_COLOR .
}

playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  uv run manage.py test $_DJANGO_NO_COLOR --tag playwright --noinput
}

checkall() {
  setenv
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running test"
  test --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  cd ..
  echo "Running Playwright tests"
  playwrighttest
}

# The scratch/ fast loop: validate the agent's ourapp/ edits without re-running the
# unchanged framework suite or the slow browser pass. ruff + mypy (whole codebase
# — the agent's Python must pass), ourapp's OWN tests only (not djangoapp/tests/,
# which is identical to main/), and the frontend lint/typecheck/build (the build
# confirms the agent's frontend compiles; the browser pass is skipped). The full
# backend suite + Playwright stay in checkall, run in main/.
checkscratch() {
  setenv
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running ourapp tests (scoped; the framework suite runs in main/)"
  test ourapp --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  echo "Running frontend build"
  npm run build
  cd ..
}

lintfix() {
  setenv
  uv run ruff format $_RUFF_COLOR
  uv run ruff check $_RUFF_COLOR --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# Shared rsync exclude list for createscratch/mergescratch: skip git, the scratch
# tree itself, virtualenvs, build-tool output (dist/build), caches, and
# machine-local state. NOTE: djangoapp/static/ (the built frontend bundle) is
# intentionally NOT excluded — it's gitignored, and deploying it carries the
# agent's fresh build from scratch/ to main/ so the live server isn't left on a
# stale bundle. ``.env`` is copied INTO scratch/ (same machine, same DB) but
# never synced BACK to main/.
_SCRATCH_EXCLUDES=(
  --exclude='.git/'
  --exclude='.kilo/'
  --exclude='scratch/'
  --exclude='node_modules/'
  --exclude='.venv/'
  --exclude='__pycache__/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
  --exclude='dist/'
  --exclude='build/'
  --exclude='staticfiles/'   # collectstatic output (VM serving); regenerated, never source
  --exclude='.DS_Store'
)

# main/ is this script's dir; scratch/ is its sibling (both under parent/).
# Resolved once at load time so createscratch/mergescratch stay free of path
# boilerplate.
_MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRATCH_DIR="$(dirname "$_MAIN_DIR")/scratch"

# Build a fresh scratch/ from main/: rsync (shared excludes), own env, own
# throwaway git repo with a baseline commit. Shared by createscratch and
# checkproject.
_new_scratch() {
  rm -rf "$_SCRATCH_DIR"
  rsync -a "${_SCRATCH_EXCLUDES[@]}" "$_MAIN_DIR/" "$_SCRATCH_DIR/"
  ( cd "$_SCRATCH_DIR"
    uv sync
    cd frontend
    npm install
  )
  git -C "$_SCRATCH_DIR" init -q
  # VM/CI fallback only: with no global git identity (the VM never sets
  # one) git cannot derive an email from the .local hostname and commits
  # would fail — seed the scratch repo with author + blank email. The
  # agent marker still rides GIT_COMMITTER_NAME from the environment; on
  # dev a global identity exists and is left untouched (the human authors).
  if ! git -C "$_SCRATCH_DIR" config --get user.name >/dev/null 2>&1 \
     && ! git config --get user.name >/dev/null 2>&1; then
    git -C "$_SCRATCH_DIR" config user.name "$(id -un)"
    git -C "$_SCRATCH_DIR" config user.email ""
  fi
  git -C "$_SCRATCH_DIR" add -A
  git -C "$_SCRATCH_DIR" commit -q -m "scratch baseline"
}

# Overlay an app's ourapp/ onto scratch/ourapp/ (full replace).
_overlay_app() {
  rsync -a --delete "$1/ourapp/" "$_SCRATCH_DIR/ourapp/"
}

createscratch() {
  # Fresh scratch/ of main/ (own env + git baseline) for the agent to edit + diff.
  _new_scratch
  echo "scratch/ ready at $_SCRATCH_DIR. Edit there, then run: ( cd $_SCRATCH_DIR && ./run checkscratch )"
}

mergescratch() {
  # Deploy scratch/ into main/ (rsync --delete; same excludes + .env so main's env
  # is never overwritten). Does NOT commit — committing is a separate step the
  # user does later. In dev, runserver auto-reloads main/ so the change is live.
  # On the test VM there is no auto-restart (decision: no restart rule): static
  # is refreshed (collectstatic, live immediately) and the restart command is
  # printed for the operator/agent to run via console's sudo.
  [ -d "$_SCRATCH_DIR" ] || { echo "Refusing: $_SCRATCH_DIR not found. Run createscratch first." >&2; return 1; }
  echo "Deploying $_SCRATCH_DIR/ → $_MAIN_DIR/ (--delete, excluding .env + generated dirs)…"
  rsync -a --delete "${_SCRATCH_EXCLUDES[@]}" --exclude='.env' "$_SCRATCH_DIR/" "$_MAIN_DIR/"
  if [ -f /etc/credentials/app/.env.vm ]; then
    echo "VM detected: collectstatic (static live immediately)…"
    ( cd "$_MAIN_DIR" && .venv/bin/python manage.py collectstatic --noinput --clear )
    echo "Code changes need a restart: sudo systemctl restart app_granian app_huey"
  fi
  echo "Deployed scratch/ → main/ (uncommitted). Commit in main/ when ready."
}

cleanscratch() {
  # Remove scratch/ outright (discard the scratch tree). Portable: uses
  # _SCRATCH_DIR (../scratch relative to this script), so the agent calls
  # `./run cleanscratch` from the repo without computing an absolute path —
  # an absolute `rm -rf /…/scratch` isn't allowlisted and prompts.
  if [ -d "$_SCRATCH_DIR" ]; then
    rm -rf "$_SCRATCH_DIR"
    echo "Removed $_SCRATCH_DIR."
  else
    echo "No scratch/ at $_SCRATCH_DIR to remove."
  fi
}

checkproject() {
  # The project tests need a real app; they self-skip unless RUN_PROJECT_TESTS is
  # set (so checkall skips them). Relies on set -e: a failure aborts and leaves scratch/ for inspection.
  
  echo "=== checkproject cycle 1: test app (lint + typecheck + project tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/djangoapp/tests/testapp"
  ( cd "$_SCRATCH_DIR"
    ./run lintfix
    ./run typecheck
    RUN_PROJECT_TESTS=1 uv run manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright --noinput
  )

  echo "=== checkproject cycle 2: reference app (its own tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/docs/reference"
  # The reference app ships its own Vue pages under
  # docs/reference/frontend/src/ours/; overlay them into scratch/frontend/src/ours/
  # (main.ts already globs ./ours/pages/**/*.vue) and build, so its /notes page
  # (Inertia component "ours/NotesPage") is in the bundle the live server serves.
  rsync -a "$_MAIN_DIR/docs/reference/frontend/src/ours/" "$_SCRATCH_DIR/frontend/src/ours/"
  ( cd "$_SCRATCH_DIR"
    ( cd frontend && npm run build )
    uv run manage.py test $_DJANGO_NO_COLOR ourapp --noinput
  )

  rm -rf "$_SCRATCH_DIR"
  echo "checkproject green."
}

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  echo "Usage: $0 {func_name}"
  exit 1
fi
