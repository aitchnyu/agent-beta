#!/bin/bash

set -euo pipefail

# Color in tool/test output: keep it in a real terminal, strip it when captured
# (agent logs, pipes) so ANSI escapes don't pollute the captured text. NO_COLOR
# is the broad switch (eslint/oxlint/vite/Django/ruff/mypy all respect it); the
# explicit flags are belt-and-suspenders for the tools the agent runs most.
if [ -t 1 ]; then
  _RUFF_COLOR=
  _MYPY_COLOR=
  _DJANGO_NO_COLOR=
else
  _RUFF_COLOR=--color=never
  _MYPY_COLOR=--no-color-output
  _DJANGO_NO_COLOR=--no-color
  export NO_COLOR=1
  # FORCE_COLOR (injected by npm-spawned tooling) makes chalk ignore NO_COLOR
  unset FORCE_COLOR
fi

# /etc/credentials/desmo/.env.vm is staged there by provisioning and exists
# NOWHERE else — the de facto "am I on the VM?" marker. Both env-loading and
# the VM/dev-side refusal guards hang off this one predicate.
is_running_on_vm() {
  [ -f /etc/credentials/desmo/.env.vm ]
}

setenv() {
  # Load the environment by shell-sourcing (no python-dotenv): `set -a`
  # exports every assignment; only plain KEY="value" lines + comments (no
  # command substitution). Dev: ./.env; on the VM the single source is the
  # credentials file the units also read (/etc/credentials/desmo/.env.vm).
  if [ -f .env ]; then
    set -a
    . ./.env
    set +a
    return 0
  fi
  # ie, we are inside vm
  if is_running_on_vm; then
    set -a
    . /etc/credentials/desmo/.env.vm
    set +a
    return 0
  fi
  echo "Warning: no .env (dev) or /etc/credentials/desmo/.env.vm (VM) — relying on ambient environment." >&2
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  # Dev-machine-only bootstrap; scratch's copy resolves both dirs to
  # scratch (a parallel .env/DB bootstrap there is pure waste), and the
  # VM provisions itself (deploy/inside-vm.sh).
  _require_main_run init || return 1
  if is_running_on_vm; then
    echo "Refusing: init is dev-only — the VM provisions itself (deploy/inside-vm.sh)." >&2
    return 1
  fi
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      # Generate a real SECRET_KEY (sessions/password-reset need one) and
      # the VAPID Web Push key — the canonical mint the VM's provision uses
      # too (deploy/gen-vapid.py, executed). Both are REQUIRED; DB_PASSWORD
      # stays empty for the operator (it must match their local postgres).
      command -v openssl >/dev/null 2>&1 || {
        echo "REFUSING: openssl not found — required to mint SECRET_KEY." >&2
        rm -f .env
        exit 1
      }
      sed -i.bak "s#^SECRET_KEY=.*#SECRET_KEY=\"$(openssl rand -hex 32)\"#" .env && rm -f .env.bak
      # --no-project --with cryptography: no venv exists yet
      _vapid="$(uv run --no-project --with cryptography python ./deploy/gen-vapid.py)" || {
        echo "REFUSING: VAPID key mint failed — not leaving .env half-configured." >&2
        rm -f .env
        exit 1
      }
      sed -i.bak "s#^VAPID_PRIVATE_KEY=.*#VAPID_PRIVATE_KEY=\"$_vapid\"#" .env && rm -f .env.bak
      echo "Created .env with generated SECRET_KEY + VAPID_PRIVATE_KEY — set DB_PASSWORD (your local postgres password) next."
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests — headless shell only
  uv run playwright install chromium --only-shell
  # Create the database (name/user come from .env — convention <appname>_db)
  psql -U postgres -c "CREATE DATABASE $DB_NAME;" || echo "Database '$DB_NAME' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

pi() {
    # The agent TUI, .env env exported — the ONE launcher. On the VM the
    # PATH entry /usr/local/bin/pi (deploy/pi.sh) purely delegates here
    # (it shadows npm's pi and exports PI_REAL_BIN); setup is assumed
    # (provisioning/repo guarantee binary + .pi/ policy); provider auth +
    # model live in pi's own stores (desmosetup writes them; by hand
    # /login, /model — README § Pi setup).
  # The VM's sanctioned entry is the debian user; dev runs as its own user.
  if is_running_on_vm && [ "$(id -un)" != "debian" ]; then
    echo "Refusing: on the VM, pi runs as the debian user only — log in as debian." >&2
    return 1
  fi
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  # The TUI's cwd must be the repo root: extension + agent discovery are
  # cwd-relative (scratch/ is a sibling, reached via sanctioned paths).
  # setenv comes after the cd on purpose: it reads .env from the cwd, and
  # the PATH launcher is typed from any directory (the home one).
  cd "$repo_root"
  setenv

  # --approve grants project trust deterministically; PI_REPO_ROOT
  # anchors steer.md injection; no startup version ping; sessions land
  # in /sessions (gitignored).
  export PI_REPO_ROOT="$repo_root"
  export PI_SKIP_VERSION_CHECK=1

  # Subcommands must be argv[1] (a leading --approve turns "auth" into
  # prompt text); trust matters for the TUI only. A direct `./run pi
  # --approve …` on the VM re-enters via the wrapper — don't duplicate
  # the flag.
  local args=("$@")
  if [[ "${1:-}" != auth && "${1:-}" != mcp && "${1:-}" != serve && "${1:-}" != --approve ]]; then
    args=(--approve "$@")
  fi
  if [ -n "${PI_REAL_BIN:-}" ]; then
    exec "$PI_REAL_BIN" "${args[@]}"
  fi
  command pi "${args[@]}"
}

backupdb() {
  # Run the nightly backup NOW — the same code the timer's shim and
  # deployscratch run. pgbackrest refuses root, so everything runs AS
  # POSTGRES (the repo owner) via sudo; the conf (/etc/pgbackrest/)
  # carries the stanza. Weekly full + daily diff; a full lands when
  # none exists yet. Retention (14 fulls) is the conf's. Failures
  # abort under set -e (unit red).
  local type=diff
  if ! sudo -u postgres pgbackrest --stanza=desmo info | grep -q 'full backup'; then
    type=full
  elif [ "$(date -u +%u)" -eq 7 ]; then
    type=full   # Sunday UTC — refresh the diff baseline
  fi
  sudo -u postgres pgbackrest --stanza=desmo backup --type="$type"
}

# True while a pgbackrest backup is in flight — the stanza's own lock
# report, verified live. `info --output=json` is an array of stanzas;
# ours (single, desmo) looks like:
#   [{"name":"desmo",
#     "status":{"code":0,"message":"ok","lock":{
#       "backup":{"held":true,"size":41627136,"size-cplt":41615360},
#       "restore":{"held":false}}}},
#    …backup sets, archive, repo…]
# — held is true exactly while a backup runs (sizes = progress).
# Shared by restoredb (refuse on it) and deployscratch (wait it out).
_backup_running() {
  sudo -u postgres pgbackrest --stanza=desmo info --output=json 2>/dev/null \
    | jq -e '.[0].status.lock.backup.held == true' >/dev/null
}

restoredb() {
  # Restore an EXPLICIT snapshot ONTO the live database — whole-app
  # downtime, explicit request only (docs/backups.md):
  #   - <set> is MANDATORY: a backup-set label exactly as
  #     `pgbackrest --stanza=desmo info` prints it (e.g.
  #     2026-10-02-000010F) — the restore stops at that set's
  #     consistency point: the snapshot exactly as taken, no WAL
  #     replay past it, no implicit "latest"
  #   - the set's existence is verified BEFORE anything stops, so a
  #     typo costs nothing
  #   - a backup ALREADY RUNNING is detected (pgbackrest's own lock
  #     report) and the restore REFUSED — it holds the repo lock.
  #     Re-run in a minute. The timer itself is left untouched: a
  #     fire landing mid-restore fails its oneshot harmlessly
  #     (postgres down / repo lock held) and the next night retries.
  #   - restore runs AS POSTGRES — ownership right by construction,
  #     no chown
  #   - waits until the cluster is OUT of recovery (promoted) — not
  #     merely accepting connections: a replaying cluster answers
  #     pg_isready read-only; the bounded wait fails loudly if it
  #     never promotes
  local set=${1:-}
  if [ -z "$set" ]; then
    echo "Refusing: restoredb needs an explicit snapshot label — restoredb 2026-10-02-000010F (list: sudo -u postgres pgbackrest --stanza=desmo info)." >&2
    return 1
  fi
  if ! sudo -u postgres pgbackrest --stanza=desmo info | grep -q "backup: $set"; then
    echo "Refusing: no backup set '$set' — list with: sudo -u postgres pgbackrest --stanza=desmo info" >&2
    return 1
  fi
  if _backup_running; then
    echo "Refusing: a backup is running — let it finish, then re-run restoredb." >&2
    return 1
  fi
  local args=(--stanza=desmo
    --set="$set"
    --type=immediate
    --target-action=promote
    restore)
  # Stop the INSTANCES by glob ('postgresql@*'), not just the dummy
  # postgresql meta unit — a meta stop returns before the propagated
  # instance shutdown finishes, and pgbackrest would race a live
  # postmaster.pid. START uses the meta unit alone: its Wants= pulls
  # every instance, while a start-glob only matches already-loaded
  # units (the readiness wait below absorbs the propagation lag).
  sudo systemctl stop desmo_granian.service desmo_huey.service 'postgresql@*' postgresql
  sudo -u postgres pgbackrest --delta "${args[@]}"
  sudo systemctl start postgresql desmo_granian.service desmo_huey.service
  local tries=0
  until sudo -u postgres psql -Atqc "SELECT NOT pg_is_in_recovery()" 2>/dev/null | grep -qx t; do
    tries=$((tries + 1))
    if [ "$tries" -ge 60 ]; then
      echo "FAILED: postgres not promoted after 60s — restore did not reach consistency." >&2
      return 1
    fi
    sleep 1
  done
}

# First-run setup — two commands, each with its logic beside it:
#   ops/setup.py + ops/setup_app.py, ops/superuserloginlink.py
# No setenv here: each shells out to `./run djangomanage` or pi.
# Each runs from any cwd: the PATH wrappers in /usr/local/bin call it
# from the home directory.
desmosetup() {
  cd "$_TREE_DIR"
  _ops_cli desmosetup "$@"
}

desmosuperuserloginlink() {
  cd "$_TREE_DIR"
  _ops_cli desmosuperuserloginlink "$@"
}

# Test redis: any nonzero DB is a test DB (clear_redis refuses DB 0).
# The test processes' REDIS_URL is set by ops/scratch.py's test_redis_env.

# Django test suite — logic in ops/testsuite.py: quiet logs, failfast,
# keepdb while migrations are unchanged; --full = full run (the gates).
test() {
  setenv
  _ops_cli test "$@"
}

typecheck() {
  setenv
  uv run mypy $_MYPY_COLOR .
}

# Playwright e2e — logic lives in ops/testsuite.py: build, then the
# tagged run (a test label narrows it; no label = full suite).
playwrighttest() {
  setenv
  _ops_cli playwrighttest "$@"
}

# Regenerates the committed README PNGs in docs/screenshots/ — logic in
# ops/testsuite.py (overlay recipe: docs/screenshots/README.md).
screenshots() {
  [ $# -gt 0 ] || { echo "screenshots needs a scoped test label (./run screenshots <TestClass>) — a bare run re-captures the whole suite and churns every PNG" >&2; return 1; }
  setenv
  _ops_cli screenshots "$@"
}

# d2 fence check — logic in deploy/checkmarkdownd2.mjs. With FILE args
# each fence also renders (.svg + .png) into a fresh /tmp/desmo/ dir for
# the image reviewer. No args on a TTY: validation-only doc scan.
checkmarkdownd2() {
  node "$_TREE_DIR/deploy/checkmarkdownd2.mjs" "$@"
}

# Which tree this ./run copy lives in; scratch/ is its sibling.
_TREE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRATCH_DIR="$(dirname "$_TREE_DIR")/scratch"

# Lifecycle verbs must run MAIN's copy: from scratch's copy both dirs
# resolve to scratch — deploy would rsync it onto itself, create would
# rm -rf its own tree.
_require_main_run() {
  if [ "$_TREE_DIR" = "$_SCRATCH_DIR" ]; then
    echo "Refusing: this is scratch's own ./run — run '$1' from main/'s ./run instead." >&2
    return 1
  fi
}

# lintfix rewrites files: require the scratch ROOT as cwd — its
# relative paths are tree-rooted, and from main/ they'd mutate the
# deployed tree.
_require_scratch_cwd() {
  if [ "$(pwd)" != "$_SCRATCH_DIR" ]; then
    echo "Refusing: '$1' runs against scratch/ — cd ../scratch first (bare relative paths from main/ target main/)." >&2
    return 1
  fi
}

# The full gate: logic in ops/checkframework1.py (four test stages, 1-3
# under coverage, merged into one report) — this shim keeps the bash
# context: main/'s ./run only (scratch's copy would rm -rf its own
# tree), never in the VM (the VM has its own gate), and setenv.
checkframework1() {
  _require_main_run checkframework1 || return 1
  if is_running_on_vm; then
    echo "Refusing: checkframework1 is a dev-side gate; the VM runs checkframework2." >&2
    return 1
  fi
  setenv
  _ops_cli checkframework1
}

# The deployment gate (destructive — but only to the
# volatile-test-machine instance it owns; every other instance, its git +
# database included, is untouched):
# - rebuild volatile-test-machine from scratch (`./localvm delete
#   volatile-test-machine` +
#   `provision-full volatile-test-machine --no-forward` — instance-local, no host forward)
# - run the in-container gate — ops/checkframework2.py, dispatched over ONE incus
#   exec (uv run --no-sync inside the container); its exit code is the
#   verdict. The gate:
#   - replaces the container's `ourapp/` with the Books test app (djangoapp/tests/testapp)
#     ourapp/
#   - refuses non-loopback installs first (BASE_URLS from the container's
#     installed .env.vm — prod origins abort before anything mutates)
#   - smokes the LIVE stack over HTTPS on loopback (caddy TLS, granian,
#     postgres, login links)
#   - runs the agent's full scratch lifecycle
#   - three setup phases, eleven asserts, first failure aborts
checkframework2() {
  _require_main_run checkframework2 || return 1
  if is_running_on_vm; then
    echo "Refusing: checkframework2 is a dev-side driver; the container's gate arrives via incus exec." >&2
    return 1
  fi
  setenv
  echo "=== Rebuild the volatile-test-machine container from scratch (destructive to volatile-test-machine only) ==="
  if incus info volatile-test-machine >/dev/null 2>&1; then
    "$_TREE_DIR/localvm" delete volatile-test-machine
  fi
  "$_TREE_DIR/localvm" provision-full volatile-test-machine --no-forward
  echo "=== Run the in-volatile-test-machine gate (testapp overlay + 11 asserts) ==="
  incus exec volatile-test-machine -- \
    sudo bash -c 'cd /srv/desmo/main && uv run --no-sync python -m ops.checkframework2'
}

lintfix() {
  _require_scratch_cwd lintfix || return 1
  setenv
  uv run ruff format $_RUFF_COLOR
  uv run ruff check $_RUFF_COLOR --fix --unsafe-fixes --show-fixes
  cd frontend
  npm run lint:fix
}

# Overlay an app's ourapp/ onto scratch/ourapp/ (full replace) —
# checkframework1's stage-3/4 fixtures ride this.
overlay_app() {
  rsync -a --delete "$1/ourapp/" "$_SCRATCH_DIR/ourapp/"
}

# The scratch lifecycle trio lives in ops/ (Python; ops/scratch.py).
# These wrappers keep the ./run surface — same command names, args, exit
# codes — and checkframework1 builds its stage-3/4 scratch copies through
# the same CLI.
_ops_cli() { # <command> [args…]
  PYTHONUNBUFFERED=1 PYTHONPATH="$_TREE_DIR${PYTHONPATH:+:$PYTHONPATH}" \
    uv run python -m ops.cli "$@"
}

createscratch() { _ops_cli createscratch "$@"; }

checkscratch() { _ops_cli checkscratch "$@"; }

deployscratch() { _ops_cli deployscratch "$@"; }

cleanscratch() { _ops_cli cleanscratch "$@"; }

postdeploychecks() { _ops_cli postdeploychecks "$@"; }

help() {
  # Colored in a real terminal, plain when captured (pipes, agent logs) —
  # same policy as the tool flags at the top of this script.
  local H C R
  H=$'\033[1;36m' C=$'\033[1;32m' R=$'\033[0m'
  [ -t 1 ] || { H=''; C=''; R=''; }
  cat <<EOF
${H}Usage:${R} run <command> [args…]        (works on dev and the VM; the VM's ${C}pi${R} launcher starts the agent)

 ${H}Setup + agent${R}
  ${C}init${R}                first-time setup: .env, uv sync, playwright, DB + migrate (dev only)
  ${C}pi${R}                  the pi coding-agent TUI (scratch-driven edit → deploy loop)
  ${C}desmosetup${R}         the post-provision setup, one Textual screen: domain, first superuser,
                          Google login, pi provider — then the terminal steps and a report
  ${C}desmosuperuserloginlink${R}
                          print the first superuser's one-time login link; creates nothing

${H}Checks${R}
  ${C}lintfix${R}             ruff format + ruff check, oxlint + prettier + eslint templates (writes)
  ${C}test${R} [args…]        Django tests — quiet logs, failfast, auto keepdb on unchanged migrations; --full = full run; other flags pass to manage.py
  ${C}typecheck${R}           mypy (backend); the frontend type-check (vue-tsgo) rides npm run build
  ${C}djangomanage generatesdk${R} <api-symbol> <out>
                       regenerate a feature's typed client + zod schemas
                       (endpoint-reachable models of that NinjaAPI,
                       nested mounts included) — repo-map §2
  ${C}checkmarkdownd2${R} [file.md]
                        validate every d2 fence (file args also render
                        each to .svg + .png in a fresh /tmp/desmo/ dir;
                        no args on a TTY → scan the default docs
  ${C}playwrighttest${R} …    Playwright e2e suite (auto keepdb on unchanged migrations, like test);
                        --pdbrc <file> feeds pdb from an rc file (HOME for the child)
                         — Playwright's driver owns stdin, see docs/debugging-tests.md
  ${C}screenshots${R}         regenerate docs/screenshots via Playwright
  ${C}checkframework1${R}     the full dev-side gate (main/ only, never the VM):
                        lint + types + 4 test tiers under one merged
                        coverage report (htmlcov/)
  ${C}checkframework2${R}     rebuild volatile-test-machine from scratch + run the in-container gate

${H}Scratch (the agent edit loop)${R}
  ${C}createscratch${R}       copy main/ → scratch/ + tag scratch-baseline
  ${C}checkscratch${R}        run the check battery in scratch — the between-batches
                       gate; main/ untouched (works on dev too). Same scoping as
                       deployscratch: backend diffs run ruff + mypy + ourapp tests +
                       frontend lint/build (+ smoke on framework files); frontend/
                       docs-only diffs take the fast path
  ${C}deployscratch${R}       checks (same battery as checkscratch), then deploy
                       scratch/ → main/ (VM only). Backend diffs: backup, migrate,
                       restarts; frontend/docs-only diffs take a fast path
  ${C}cleanscratch${R}        remove scratch/
  ${C}postdeploychecks${R}    the stage-[5] close-out audit: clean tree,
                       migrations applied, scratch gone —
                       one PASS/FAIL line each; exits nonzero on any FAIL

${H}Backups (pgbackrest — docs/backups.md)${R}
  ${C}backupdb${R}             run a backup NOW (weekly full + daily diff; the tool's own logs print)
  ${C}restoredb${R} <set>      restore ONTO the live DB to an EXACT snapshot (whole-app downtime);
                       <set> = a backup label from: pgbackrest --stanza=desmo info
  (inspect directly: sudo -u postgres pgbackrest --stanza=desmo info|check)

${H}Passthrough${R}
  ${C}djangomanage${R} …      manage.py <…> with the env sourced (e.g. djangomanage migrate)
  ${C}python${R} …           python <…> with the env sourced (e.g. python -c '…')
EOF
}

# No arguments → default to help.
if [ $# -eq 0 ]; then
  help
  exit 0
fi

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  help
  echo "Unknown command: $1" >&2
  exit 1
fi
