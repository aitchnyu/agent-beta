#!/bin/bash

set -euo pipefail

# Color in tool/test output: keep it in a real terminal, strip it when captured
# (agent logs, pipes) so ANSI escapes don't pollute the captured text. NO_COLOR
# is the broad switch (eslint/vitest/vite/Django/ruff/mypy all respect it); the
# explicit flags are belt-and-suspenders for the tools the agent runs most.
if [ -t 1 ]; then
  _RUFF_COLOR=
  _MYPY_COLOR=
  _DJANGO_NO_COLOR=
else
  _RUFF_COLOR=--color=never
  _MYPY_COLOR=--no-color-output
  _DJANGO_NO_COLOR=--no-color
  export NO_COLOR=1
  # FORCE_COLOR (injected by e.g. concurrently) makes chalk ignore NO_COLOR
  unset FORCE_COLOR
fi

setenv() {
  # Load the environment by shell-sourcing (no python-dotenv): `set -a`
  # exports every assignment; only plain KEY="value" lines + comments (no
  # command substitution). Dev: ./.env; on the VM the single source is the
  # credentials file the units also read (/etc/credentials/app/.env.vm).
  if [ -f .env ]; then
    set -a
    . ./.env
    set +a
    return 0
  fi
  # ie, we are inside vm
  if [ -f /etc/credentials/app/.env.vm ]; then
    set -a
    . /etc/credentials/app/.env.vm
    set +a
    return 0
  fi
  echo "Warning: no .env (dev) or /etc/credentials/app/.env.vm (VM) — relying on ambient environment." >&2
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      # Generate a real SECRET_KEY (sessions/password-reset need one);
      # DB_PASSWORD stays sentinel for the operator (it must match their
      # local postgres).
      if command -v openssl >/dev/null 2>&1; then
        sed -i.bak "s#^SECRET_KEY=.*#SECRET_KEY=\"$(openssl rand -hex 32)\"#" .env && rm -f .env.bak
      fi
      echo "Created .env with a generated SECRET_KEY — set DB_PASSWORD (your local postgres password) next."
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests
  uv run playwright install firefox
  # Create the database (name/user come from .env — convention <appname>_db)
  psql -U postgres -c "CREATE DATABASE $DB_NAME;" || echo "Database '$DB_NAME' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

runserver() {
  setenv
  djangomanage runserver
}

hueydev() {
  # Huey consumer for dev run in the foreground. Auto-discovers each installed app's
  # tasks.py (ourapp.tasks) and runs periodic + enqueued tasks. Redis must be
  # running (REDIS_URL). For prod, its run with systemd.
  setenv
  djangomanage run_huey "$@"
}

dev() {
  # The whole dev stack in one terminal via `concurrently`: runserver + vite
  # watch + huey (Ctrl-C stops all). The agent runs in its own terminal via
  # `./run pi` — no browser console anymore.
  setenv
  frontend/node_modules/.bin/concurrently -n runserver,vite,huey -c blue,green,cyan \
    "./run runserver" \
    "cd frontend && npm run dev" \
    "./run hueydev"
}

pi() {
  # The agent: exec the pi TUI with the .env environment (model, the
  # provider's native auth var, git identity) exported by setenv — dev and
  # VM alike. Config is project-local and versioned: .pi/settings.json
  # (model, pinned packages), .pi/extensions/pi-permission-system/config.json
  # (the whole bash/edit/path policy — allow/ask/deny with operator
  # prompts), .pi/extensions/context/ (steer.md injection), and
  # .pi/extensions/notify/ (double BEL — immediate, then 300ms — on
  # turn end and on blocking questions; rings the operator's local
  # terminal over SSH). Subagents
  # and their permission forwarding come from @gotgenes/pi-subagents.
  setenv
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  # Run from the REPO ROOT (main/): the TUI's pwd is the actual repo, and
  # project-extension discovery + agent discovery are working-dir-relative.
  # No parent-cd, no parent git-init — main/ is its own repo everywhere;
  # scratch/ is a SIBLING, reachable via the sanctioned compounds and
  # scratch paths the guards allow.
  cd "$repo_root"

  # (1) Binary on PATH.
  command -v pi >/dev/null 2>&1 || {
    echo "pi binary not found on PATH — install it first" \
      "(npm install -g --ignore-scripts @earendil-works/pi-coding-agent; see deploy/inside-vm.sh)" >&2
    return 1
  }

  # (2) The permission policy IS the launcher's config check — refuse to
  #     start without every piece: the pinned packages (declared in
  #     .pi/settings.json; auto-installed into .pi/npm on project trust),
  #     the project permission policy, and the steer.md injection
  #     extension. Without the permission system the session would run
  #     unguarded (pi has NO built-in permission model).
  local policy
  for policy in \
    .pi/settings.json \
    .pi/extensions/pi-permission-system/config.json \
    .pi/extensions/context/index.ts
  do
    [[ -f "$policy" ]] || {
      echo "Refusing to start: $policy not found — without it the agent has no permission policy." >&2
      return 1
    }
  done

  # (3) Model knob set — pi takes it VERBATIM (provider-qualified, the
  #     same format as AGENT_MODEL; no splitting, no mapping). Auth rides
  #     the provider's NATIVE env var (zai reads ZAI_API_KEY — our env
  #     contract unchanged); pi itself fails loudly when it's missing.
  if [[ -z "${AGENT_MODEL:-}" ]]; then
    echo "Refusing to start: AGENT_MODEL is unset/empty — provider-qualified" \
      "id, e.g. \"zai/glm-5.3\" (pi --list-models; see .env.example)." >&2
    return 1
  fi

  # (4) Session behavior:
  #     - --approve grants project trust DETERMINISTICALLY: without it a
  #       headless/default run silently skips .pi extensions AND packages
  #       (the permission system included) — probed. The launcher owns
  #       this decision; trust also auto-installs the pinned packages
  #       into .pi/npm/ on first run.
  #     - PI_REPO_ROOT anchors the context extension (steer.md path)
  #       against any cwd drift.
  #     - PI_SKIP_VERSION_CHECK=1: no startup update ping (telemetry is
  #       off via .pi/settings.json).
  #     - Sessions land in /sessions (sessionDir in project settings)
  #       — in-repo and gitignored; ~/.pi/agent/ only keeps trust.json.
  export PI_REPO_ROOT="$repo_root"
  export PI_SKIP_VERSION_CHECK=1

  # All checks passed — hand the terminal over to the TUI.
  command pi --approve --model "$AGENT_MODEL" "$@"
}

test() {
  setenv
  uv run manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright "$@"
}

coverage() {
  setenv
  uv run coverage run --source=djangoapp --omit='djangoapp/tests/test_playwright.py' manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright
  uv run coverage report -m
  uv run coverage html
  open htmlcov/index.html
}

typecheck() {
  setenv
  uv run mypy $_MYPY_COLOR .
}

playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  # Forwards args like test(): `./run playwrighttest
  # ourapp.tests.test_chores_playwright` runs just that module (Django
  # intersects the label with --tag playwright). No args = full suite.
  uv run manage.py test $_DJANGO_NO_COLOR --tag playwright --noinput "$@"
}

screenshots() {
  setenv
  cd frontend
  npm run build
  cd ..
  # Regenerates the committed README PNGs in docs/screenshots/. The pass
  # self-gates on GENERATE_SCREENSHOTS (tests skip without it). The models-management
  # shots additionally need the testapp overlay — see
  # docs/screenshots/README.md for the manual overlay recipe.
  GENERATE_SCREENSHOTS=1 uv run manage.py test $_DJANGO_NO_COLOR --tag screenshots --noinput "$@"
}

checkframework1() {
  setenv
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running test"
  test --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  cd ..
  echo "Running Playwright tests"
  playwrighttest
}

# The deployment gate (destructive — the old VM's git + database are gone):
# - rebuild the test VM from scratch (`./testvm delete` + `provision`)
# - run the in-VM gate — deploy/vm.sh's `gate`, dispatched like every other
#   guest-side helper — over ONE multipass exec; its exit code is the verdict.
#   The gate:
#   - overlays the Books test app (djangoapp/tests/testapp) over the VM's
#     ourapp/
#   - smokes the LIVE stack over HTTPS on loopback (caddy TLS, granian,
#     postgres, login links)
#   - runs the agent's full scratch lifecycle
#   - three setup phases, nine asserts, first failure aborts
# - NB: the exec's output streams unfiltered — never pipe an exec into
#   grep -q (early-exit readers wedge the daemon's next exec on this host)
checkframework2() {
  setenv
  echo "=== Rebuild the VM from scratch (destructive) ==="
  if multipass info app >/dev/null 2>&1; then
    "$_MAIN_DIR/testvm" delete
  fi
  "$_MAIN_DIR/testvm" provision
  echo "=== Run the in-VM gate (testapp overlay + 9 asserts) ==="
  multipass exec app -- sudo bash /srv/app/main/deploy/vm.sh gate
}

# The scratch/ fast loop: validate the agent's ourapp/ edits without re-running the
# unchanged framework suite or the slow browser pass. ruff + mypy (whole codebase
# — the agent's Python must pass), ourapp's OWN tests only (not djangoapp/tests/,
# which is identical to main/), and the frontend lint/typecheck/build (the build
# confirms the agent's frontend compiles; the browser pass is skipped). The full
# backend suite + Playwright stay in checkframework1, run in main/.
_scratch_checks() {
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running ourapp tests (scoped; the framework suite runs in main/)"
  test ourapp --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  echo "Running frontend build"
  npm run build
  cd ..
  # Framework-file watch: diff the working tree against the frozen
  # `scratch-baseline` ref (main's HEAD at seed time); edits outside
  # ourapp/ + frontend/src/ours/ mean framework code changed → run the
  # `scratch-test-subset` smoke (an early-warning fraction of
  # checkframework1; the full suite still gates in main/).
  local baseline outside
  baseline=$(git -C "$_SCRATCH_DIR" rev-parse --verify scratch-baseline 2>/dev/null) \
    || { echo "REFUSING: no scratch-baseline ref — re-run ./run createscratch" >&2; return 1; }
  outside=$(
    {
      git -C "$_SCRATCH_DIR" diff --name-only "$baseline"
      git -C "$_SCRATCH_DIR" ls-files --others --exclude-standard
    } | sort -u | grep -vE '^(ourapp/|frontend/src/ours/)' || true
  )
  if [ -n "$outside" ]; then
    echo "=== framework files changed — running scratch-test-subset smoke tests ==="
    printf '  %s\n' $(grep -c . <<<"$outside") files:
    printf '  %s\n' $outside
    uv run manage.py test $_DJANGO_NO_COLOR --noinput --tag=scratch-test-subset
  else
    echo "No framework-file changes (outside ourapp/ + frontend/src/ours/) — skipping scratch-test-subset smoke."
  fi
}

lintfix() {
  setenv
  uv run ruff format $_RUFF_COLOR
  uv run ruff check $_RUFF_COLOR --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# Shared rsync excludes — DIRECTIONAL: `.git` rides createscratch (scratch
# shares main's history) but deployscratch re-excludes it (+ `.env`) so
# main's repo and env stay untouched. djangoapp/static/ (the built bundle)
# is deliberately carried deploy-ward: the fresh build ships with the deploy.
_SCRATCH_EXCLUDES=(
  --exclude='.kilo/'
  --exclude='/sessions/'
  --exclude='.pi/npm/'
  # The permission extension self-edits its config for grant bookkeeping;
  # that state must not ride createscratch/deployscratch (it spuriously
  # tripped the framework-file smoke trigger and time-traveled stale
  # policy between trees). Plain rsync --delete never removes excluded
  # files on the receiver, so main's tracked copy stays authoritative.
  --exclude='.pi/extensions/pi-permission-system/'
  --exclude='scratch/'
  --exclude='node_modules/'
  --exclude='.venv/'
  --exclude='__pycache__/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
  --exclude='dist/'
  --exclude='build/'
  --exclude='staticfiles/'   # collectstatic output (VM serving); regenerated, never source
  --exclude='.DS_Store'
)

# main/ is this script's dir; scratch/ is its sibling (both under parent/).
# Resolved once at load time so createscratch/deployscratch stay free of path
# boilerplate.
_MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRATCH_DIR="$(dirname "$_MAIN_DIR")/scratch"

# Build a fresh scratch/ from main/: tree rsync INCLUDING .git (shared
# history), main's HEAD frozen as the `scratch-baseline` ref, and .venv +
# node_modules hardlink-copied so the bootstrap runs incremental.
# Hardlink-copy when the OS allows it (dev on the Mac: same owner —
# instant, zero extra disk); plain copy otherwise. On the VM main/ is
# app-owned and Linux's protected_hardlinks blocks the agent user from
# hardlinking files it can only read — bare cp -al dies "Operation not
# permitted" halfway and leaves a HOLLOW .venv that uv then refuses
# ("no Python executable"), which cost a session an hour of venv
# archaeology. The fallback copies fully; uv sync stays incremental.
_link_or_copy_tree() {
  if ! cp -al "$1" "$2" 2>/dev/null; then
    rm -rf "$2"
    cp -a "$1" "$2"
  fi
}

_new_scratch() {
  rm -rf "$_SCRATCH_DIR"
  rsync -a "${_SCRATCH_EXCLUDES[@]}" "$_MAIN_DIR/" "$_SCRATCH_DIR/"
  git -C "$_SCRATCH_DIR" tag -f scratch-baseline HEAD >/dev/null
  # npm install rewrites package-lock format-normalized — it reads as a
  # diff vs the baseline, tripping the framework-file watch. Restore from
  # HEAD.
  git -C "$_SCRATCH_DIR" checkout -- frontend/package-lock.json 2>/dev/null || true
  [ -d "$_MAIN_DIR/.venv" ] && _link_or_copy_tree "$_MAIN_DIR/.venv" "$_SCRATCH_DIR/.venv"
  [ -d "$_MAIN_DIR/frontend/node_modules" ] \
    && _link_or_copy_tree "$_MAIN_DIR/frontend/node_modules" "$_SCRATCH_DIR/frontend/node_modules"
  ( cd "$_SCRATCH_DIR"
    uv sync
    cd frontend
    npm install
  )
  # npm install may still touch the lock (format normalization) — pin it back
  # AFTER install so the baseline stays clean.
  git -C "$_SCRATCH_DIR" checkout -- frontend/package-lock.json 2>/dev/null || true
}

# Overlay an app's ourapp/ onto scratch/ourapp/ (full replace).
_overlay_app() {
  rsync -a --delete "$1/ourapp/" "$_SCRATCH_DIR/ourapp/"
}

# Scratch-lifecycle commands must run MAIN's ./run: from scratch's own copy
# both dirs resolve to scratch (deploy rsyncs scratch onto itself; create
# rm -rf's its own tree). Refuse loudly.
_require_main_run() {
  if [ "$_MAIN_DIR" = "$_SCRATCH_DIR" ]; then
    echo "Refusing: this is scratch's own ./run — run '$1' from main/'s ./run instead." >&2
    return 1
  fi
}

createscratch() {
  # Fresh scratch/ of main/ (shared git history + frozen baseline ref, hardlinked
  # env) for the agent to edit + diff.
  _require_main_run createscratch || return 1
  _new_scratch
  echo "scratch/ ready at $_SCRATCH_DIR. Edit there, then deploy with: ./run deployscratch (from main/)"
}

# The ONE command: the full check battery in scratch (nothing deploys
# red), then rsync → main/ (.git/.env excluded), migrate, and on the VM
# collectstatic + restart granian/huey so deploys go LIVE. Never commits.
deployscratch() {
  setenv
  _require_main_run deployscratch || return 1
  [ -d "$_SCRATCH_DIR" ] || { echo "Refusing: $_SCRATCH_DIR not found. Run createscratch first." >&2; return 1; }
  ( cd "$_SCRATCH_DIR" && _scratch_checks )

  echo "Deploying $_SCRATCH_DIR/ → $_MAIN_DIR/ (--delete, excluding .git + .env + generated dirs)…"
  if [ -f /etc/credentials/app/.env.vm ]; then
    # VM only: the sync runs under sudo (as non-root agent, rsync -a can't
    # preserve attrs on app-owned files — exit 23), and scratch's files are
    # agent-owned. Re-own to app AND re-add group-write afterwards — chown
    # alone leaves rsync-created 644/755 files without g+w, and the next
    # build as agent then dies on app-owned dirs (EACCES rmdir .vite, a
    # real session's playwright wall). Dev on the Mac owns both trees.
    sudo rsync -a --delete "${_SCRATCH_EXCLUDES[@]}" --exclude='.git/' --exclude='.env' "$_SCRATCH_DIR/" "$_MAIN_DIR/"
    sudo chown -R app:app "$_MAIN_DIR"
    sudo chmod -R g+w "$_MAIN_DIR"
  else
    rsync -a --delete "${_SCRATCH_EXCLUDES[@]}" --exclude='.git/' --exclude='.env' "$_SCRATCH_DIR/" "$_MAIN_DIR/"
  fi
  ( cd "$_MAIN_DIR" && .venv/bin/python manage.py migrate --noinput )
  if [ -f /etc/credentials/app/.env.vm ]; then
    echo "VM detected: collectstatic + restarting services…"
    ( cd "$_MAIN_DIR" && .venv/bin/python manage.py collectstatic --noinput --clear )
    # Huey's unit always exists on provisioned VMs (HUEY_WORKERS ≥ 1 is
    # enforced at provisioning).
    sudo systemctl restart app_granian.service app_huey.service
    # Share-URL base from the configured hostname (first ALLOWED_HOSTS
    # entry) — never a hardcoded one; dev keeps the localhost fallback.
    _SHARE_BASE="https://${ALLOWED_HOSTS%%,*}"
    echo "App is available under hostnames:"
    ( cd "$_MAIN_DIR" && .venv/bin/python manage.py hostnames )
  fi
  echo "Deployed scratch/ → main/ (uncommitted, services live). Commit in main/ when ready."
  echo "Share design artifacts as absolute URLs at the BOTTOM of your message (with the summary):"
  echo "  docs:  ${_SHARE_BASE:-http://localhost:8000}/files/main/ourapp/docs/<feature>.md"
  echo "  pages: ${_SHARE_BASE:-http://localhost:8000}/<page-url>"
  echo "Verify each file exists in main/ before sharing the link."
}

cleanscratch() {
  # Remove scratch/ outright (discard the scratch tree). Portable: uses
  # _SCRATCH_DIR (../scratch relative to this script), so the agent calls
  # `./run cleanscratch` from the repo without computing an absolute path —
  # an absolute `rm -rf /…/scratch` isn't allowlisted and prompts.
  if [ -d "$_SCRATCH_DIR" ]; then
    rm -rf "$_SCRATCH_DIR"
    echo "Removed $_SCRATCH_DIR."
  else
    echo "No scratch/ at $_SCRATCH_DIR to remove."
  fi
}

checkproject() {
  # The project tests need a real app; they self-skip unless RUN_PROJECT_TESTS is
  # set (so checkframework1 skips them). Relies on set -e: a failure aborts and leaves scratch/ for inspection.
  
  echo "=== checkproject cycle 1: test app (lint + typecheck + project tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/djangoapp/tests/testapp"
  ( cd "$_SCRATCH_DIR"
    ./run lintfix
    ./run typecheck
    RUN_PROJECT_TESTS=1 ./run test --noinput
  )

  echo "=== checkproject cycle 2: reference app (its own tests) ==="
  _new_scratch
  _overlay_app "$_MAIN_DIR/docs/reference"
  # The reference app ships its own Vue pages under
  # docs/reference/frontend/src/ours/; overlay them into scratch/frontend/src/ours/
  # (main.ts already globs ./ours/pages/**/*.vue) and build, so its /notes page
  # (Inertia component "ours/NotesPage") is in the bundle the live server serves.
  rsync -a "$_MAIN_DIR/docs/reference/frontend/src/ours/" "$_SCRATCH_DIR/frontend/src/ours/"
  ( cd "$_SCRATCH_DIR"
    ( cd frontend && npm run build )
    ./run test --noinput ourapp
  )

  rm -rf "$_SCRATCH_DIR"
  echo "checkproject green."
}

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  echo "Usage: $0 {func_name}"
  exit 1
fi
