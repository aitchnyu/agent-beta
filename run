#!/bin/bash

set -euo pipefail

setenv() {
  if [ ! -f .env ]; then
    echo "Warning: .env file not found, relying on python-dotenv to load defaults or environment"
  fi
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      echo "Review .env and add necessary vars"
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests
  uv run playwright install firefox
  # Create the database
  psql -U postgres -c "CREATE DATABASE instant;" || echo "Database 'instant' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

runserver() {
  setenv
  djangomanage runserver
}

opencode() {
  # Bind address for the daemon. 4196, not opencode's default 4096: 4096
  # collides with the Kilo extension's random `kilo serve` server in this
  # session. Override via OPENCODE_* env vars. No `setenv` here: this command
  # only spawns the daemon, no Python/.env needed.
  local hostname="${OPENCODE_HOSTNAME:-127.0.0.1}"
  local port="${OPENCODE_PORT:-4196}"
  # Resolve paths from this script's location (the repo root), not $PWD, so
  # `./run opencode` works no matter which directory it's invoked from — the
  # opencode.json `instructions` path is CWD-relative to the daemon process.
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  # Point opencode at agentconfig/ for the web-chat agent + permission rules.
  local config_dir="${OPENCODE_CONFIG_DIR:-$repo_root/agentconfig}"
  local config_file="${OPENCODE_CONFIG:-$repo_root/agentconfig/opencode.json}"

  # Preflight — fail fast before serving, in order:
  #   (1) the agentconfig/ config file exists,
  #   (2) no competing opencode config would override it,
  #   (3) the opencode binary is on PATH,
  #   (4) the config validates (`opencode debug config`),
  #   (5) the port is free to bind.
  # Each check prints why it refuses and returns 1.

  # (1) Config file exists — without it the daemon runs with no agent/permissions.
  [[ -f "$config_file" ]] || {
    echo "Refusing to start: $config_file not found" >&2
    return 1
  }

  # (2) No competing config — opencode merges every config it finds, which would
  #     override agentconfig/. Delete the other one so only $config_file is used.
  local global_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
  if [[ -f "$global_config_dir/opencode.json" || -f "$global_config_dir/opencode.jsonc" || -f "$global_config_dir/config.json" || -f "$repo_root/opencode.json" || -n "${OPENCODE_CONFIG_CONTENT:-}" ]]; then
    echo "Refusing to start: another opencode config exists (global, project, or \$OPENCODE_CONFIG_CONTENT); delete it so only $config_file is used." >&2
    return 1
  fi

  # (3) Binary on PATH — check before `debug config` so a missing binary isn't
  #     misreported as "config invalid".
  if ! command -v opencode >/dev/null 2>&1; then
    echo "opencode binary not found on PATH — install it first" >&2
    return 1
  fi

  # (4) Config valid — `opencode serve` starts even on an invalid config and
  #     only 400s per request, so validate first and refuse to serve if broken.
  local check_output
  if ! check_output=$(
    OPENCODE_CONFIG_DIR="$config_dir" OPENCODE_CONFIG="$config_file" \
      command opencode debug config 2>&1
  ); then
    echo "opencode config is invalid — refusing to serve:" >&2
    echo "$check_output" >&2
    return 1
  fi

  # (5) Port free — fail fast so the error names the cause instead of relying on
  #     opencode's bind-time failure (which can leave a half-started process).
  #     `lsof` is present on macOS.
  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "Refusing to start: port $port is already in use (set OPENCODE_PORT to override)." >&2
    return 1
  fi

  # All checks passed — announce and serve. If `serve` fails to bind
  # (permissions) opencode prints its own error and exits non-zero.
  echo "Starting opencode serve on ${hostname}:${port} (Ctrl+C to stop)…"
  OPENCODE_CONFIG_DIR="$config_dir" OPENCODE_CONFIG="$config_file" \
    command opencode serve --hostname "$hostname" --port "$port" "$@"
}

test() {
  setenv
  uv run manage.py test --exclude-tag playwright "$@"
}

coverage() {
  setenv
  uv run coverage run --source=djangoapp --omit='djangoapp/tests/test_playwright.py' manage.py test --exclude-tag playwright
  uv run coverage report -m
  uv run coverage html
  open htmlcov/index.html
}

typecheck() {
  setenv
  uv run mypy .
}

playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  uv run manage.py test --tag playwright --noinput
}

checkall() {
  setenv
  echo "Running ruff for formatting problems"
  uv run ruff check
  echo "Running mypy for type checking"
  uv run mypy .
  echo "Running test"
  test --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend type checking"
  npm run type-check
  cd ..
  echo "Running Playwright tests"
  playwrighttest
}

lintfix() {
  setenv
  uv run ruff format
  uv run ruff check --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# Shared rsync exclude list for createscratch/mergescratch: skip git, the copy
# itself, virtualenvs, build output, caches, and machine-local state. ``.env`` is
# copied INTO copy/ (same machine, same DB) but never synced BACK to main/.
_COPY_EXCLUDES=(
  --exclude='.git/'
  --exclude='copy/'
  --exclude='node_modules/'
  --exclude='.venv/'
  --exclude='__pycache__/'
  --exclude='.mypy_cache/'
  --exclude='.ruff_cache/'
  --exclude='dist/'
  --exclude='build/'
  --exclude='djangoapp/static/'
  --exclude='.DS_Store'
)

# main/ is this script's dir; copy/ is its sibling (both under parent/). Resolved
# once at load time so createscratch/mergescratch stay free of path boilerplate.
_MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_COPY_DIR="$(dirname "$_MAIN_DIR")/copy"

createscratch() {
  # Make a fresh copy/ of main/ (minus .git/node_modules/.venv/caches/build
  # output) and bootstrap its own env (uv sync + npm install) so ./run checkall
  # works there. An existing copy/ is wiped, so each feature starts clean.
  [ -d "$_MAIN_DIR" ] || { echo "Refusing: main/ not found at $_MAIN_DIR" >&2; return 1; }
  echo "Copying main/ → $_COPY_DIR (excluding .git/node_modules/.venv/caches)…"
  rm -rf "$_COPY_DIR"
  rsync -a "${_COPY_EXCLUDES[@]}" "$_MAIN_DIR/" "$_COPY_DIR/"
  echo "Bootstrapping copy/ environment (uv sync + npm install)…"
  ( cd "$_COPY_DIR" && uv sync ) || { echo "uv sync failed in $_COPY_DIR" >&2; return 1; }
  ( cd "$_COPY_DIR/frontend" && npm install ) || { echo "npm install failed in $_COPY_DIR/frontend" >&2; return 1; }
  # Make copy/ its own throwaway git repo with a baseline commit (main/.git is
  # never copied in). The baseline lets the agent diff its edits via
  # `cd copy && git diff` before deploying. .env/node_modules/.venv stay
  # untracked (gitignored), so the baseline is source-only.
  git -C "$_COPY_DIR" init -q
  git -C "$_COPY_DIR" config user.email "scratch@local"
  git -C "$_COPY_DIR" config user.name "scratch"
  git -C "$_COPY_DIR" add -A
  git -C "$_COPY_DIR" commit -q -m "scratch baseline"
  echo "copy/ ready at $_COPY_DIR. Edit there, then run: ( cd $_COPY_DIR && ./run checkall )"
}

mergescratch() {
  # Deploy copy/ into main/ (rsync --delete; same excludes + .env so main's env
  # is never overwritten). Does NOT commit — committing is a separate step the
  # user does later. In dev, runserver auto-reloads main/ so the change is live.
  [ -d "$_COPY_DIR" ] || { echo "Refusing: $_COPY_DIR not found. Run createscratch first." >&2; return 1; }
  echo "Deploying $_COPY_DIR/ → $_MAIN_DIR/ (--delete, excluding .env + generated dirs)…"
  rsync -a --delete "${_COPY_EXCLUDES[@]}" --exclude='.env' "$_COPY_DIR/" "$_MAIN_DIR/"
  echo "Deployed copy/ → main/ (uncommitted). Commit in main/ when ready."
}

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  echo "Usage: $0 {func_name}"
  exit 1
fi
