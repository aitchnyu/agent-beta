#!/bin/bash

set -euo pipefail

# Color in tool/test output: keep it in a real terminal, strip it when captured
# (agent logs, pipes) so ANSI escapes don't pollute the captured text. NO_COLOR
# is the broad switch (eslint/vitest/vite/Django/ruff/mypy all respect it); the
# explicit flags are belt-and-suspenders for the tools the agent runs most.
if [ -t 1 ]; then
  _RUFF_COLOR=
  _MYPY_COLOR=
  _DJANGO_NO_COLOR=
else
  _RUFF_COLOR=--color=never
  _MYPY_COLOR=--no-color-output
  _DJANGO_NO_COLOR=--no-color
  export NO_COLOR=1
  # FORCE_COLOR (injected by e.g. concurrently) makes chalk ignore NO_COLOR
  unset FORCE_COLOR
fi

# /etc/credentials/desmo/.env.vm is staged there by provisioning and exists
# NOWHERE else — the de facto "am I on the VM?" marker. Both env-loading and
# the VM/dev-side refusal guards hang off this one predicate.
is_running_on_vm() {
  [ -f /etc/credentials/desmo/.env.vm ]
}

setenv() {
  # Load the environment by shell-sourcing (no python-dotenv): `set -a`
  # exports every assignment; only plain KEY="value" lines + comments (no
  # command substitution). Dev: ./.env; on the VM the single source is the
  # credentials file the units also read (/etc/credentials/desmo/.env.vm).
  if [ -f .env ]; then
    set -a
    . ./.env
    set +a
    return 0
  fi
  # ie, we are inside vm
  if is_running_on_vm; then
    set -a
    . /etc/credentials/desmo/.env.vm
    set +a
    return 0
  fi
  echo "Warning: no .env (dev) or /etc/credentials/desmo/.env.vm (VM) — relying on ambient environment." >&2
}

python() {
  setenv
  uv run python "$@"
}

djangomanage() {
  python manage.py "$@"
}

init() {
  if [ ! -f .env ]; then
    echo ".env file not found. Copy from .env.example? (y/N)"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cp .env.example .env
      # Generate a real SECRET_KEY (sessions/password-reset need one) and
      # the VAPID Web Push key — the canonical mint the VM's provision uses
      # too (deploy/gen-vapid-b64.sh, executed). Both are REQUIRED; DB_PASSWORD
      # stays empty for the operator (it must match their local postgres).
      command -v openssl >/dev/null 2>&1 || {
        echo "REFUSING: openssl not found — required to mint SECRET_KEY + VAPID_PRIVATE_KEY." >&2
        rm -f .env
        exit 1
      }
      sed -i.bak "s#^SECRET_KEY=.*#SECRET_KEY=\"$(openssl rand -hex 32)\"#" .env && rm -f .env.bak
      _vapid="$(./deploy/gen-vapid-b64.sh)" || {
        echo "REFUSING: VAPID key mint failed — not leaving .env half-configured." >&2
        rm -f .env
        exit 1
      }
      sed -i.bak "s#^VAPID_PRIVATE_KEY=.*#VAPID_PRIVATE_KEY=\"$_vapid\"#" .env && rm -f .env.bak
      echo "Created .env with generated SECRET_KEY + VAPID_PRIVATE_KEY — set DB_PASSWORD (your local postgres password) next."
    fi
  fi
  setenv
  # Install packages using uv
  uv sync
  # We have E2E tests — headless shell only
  uv run playwright install chromium --only-shell
  # Create the database (name/user come from .env — convention <appname>_db)
  psql -U postgres -c "CREATE DATABASE $DB_NAME;" || echo "Database '$DB_NAME' already exists or creation failed"
  # Run Django migrations
  djangomanage migrate
  # Install frontend dependencies and build once
  cd frontend && npm install && npm run build && cd ..
}

runserver() {
  setenv
  djangomanage runserver
}

hueydev() {
  # Huey consumer for dev run in the foreground. Auto-discovers each installed app's
  # tasks.py (ourapp.tasks) and runs periodic + enqueued tasks. Redis must be
  # running (REDIS_URL). For prod, its run with systemd.
  setenv
  djangomanage run_huey "$@"
}

backupdb() {
  # Run the nightly backup NOW — the same code the timer's shim and
  # deployscratch run. pgbackrest refuses root, so everything runs AS
  # POSTGRES (the repo owner) via sudo; the conf (/etc/pgbackrest/)
  # carries the stanza. Weekly full + daily diff; a full lands when
  # none exists yet. Retention (14 fulls) is the conf's. Failures
  # abort under set -e (unit red).
  local type=diff
  if ! sudo -u postgres pgbackrest --stanza=desmo info | grep -q 'full backup'; then
    type=full
  elif [ "$(date -u +%u)" -eq 7 ]; then
    type=full   # Sunday UTC — refresh the diff baseline
  fi
  sudo -u postgres pgbackrest --stanza=desmo backup --type="$type"
}

# True while a pgbackrest backup is in flight — the stanza's own lock
# report, verified live. `info --output=json` is an array of stanzas;
# ours (single, desmo) looks like:
#   [{"name":"desmo",
#     "status":{"code":0,"message":"ok","lock":{
#       "backup":{"held":true,"size":41627136,"size-cplt":41615360},
#       "restore":{"held":false}}}},
#    …backup sets, archive, repo…]
# — held is true exactly while a backup runs (sizes = progress).
# Shared by restoredb (refuse on it) and deployscratch (wait it out).
_backup_running() {
  sudo -u postgres pgbackrest --stanza=desmo info --output=json 2>/dev/null \
    | jq -e '.[0].status.lock.backup.held == true' >/dev/null
}

restoredb() {
  # Restore an EXPLICIT snapshot ONTO the live database — whole-app
  # downtime, explicit request only (docs/backups.md):
  #   - <set> is MANDATORY: a backup-set label exactly as
  #     `pgbackrest --stanza=desmo info` prints it (e.g.
  #     2026-10-02-000010F) — the restore stops at that set's
  #     consistency point: the snapshot exactly as taken, no WAL
  #     replay past it, no implicit "latest"
  #   - the set's existence is verified BEFORE anything stops, so a
  #     typo costs nothing
  #   - a backup ALREADY RUNNING is detected (pgbackrest's own lock
  #     report) and the restore REFUSED — it holds the repo lock.
  #     Re-run in a minute. The timer itself is left untouched: a
  #     fire landing mid-restore fails its oneshot harmlessly
  #     (postgres down / repo lock held) and the next night retries.
  #   - restore runs AS POSTGRES — ownership right by construction,
  #     no chown
  #   - waits until the cluster is OUT of recovery (promoted) — not
  #     merely accepting connections: a replaying cluster answers
  #     pg_isready read-only; the bounded wait fails loudly if it
  #     never promotes
  local set=${1:-}
  if [ -z "$set" ]; then
    echo "Refusing: restoredb needs an explicit snapshot label — restoredb 2026-10-02-000010F (list: sudo -u postgres pgbackrest --stanza=desmo info)." >&2
    return 1
  fi
  if ! sudo -u postgres pgbackrest --stanza=desmo info | grep -q "backup: $set"; then
    echo "Refusing: no backup set '$set' — list with: sudo -u postgres pgbackrest --stanza=desmo info" >&2
    return 1
  fi
  if _backup_running; then
    echo "Refusing: a backup is running — let it finish, then re-run restoredb." >&2
    return 1
  fi
  local args=(--stanza=desmo
    --set="$set"
    --type=immediate
    --target-action=promote
    restore)
  # Stop the INSTANCES by glob ('postgresql@*'), not just the dummy
  # postgresql meta unit — a meta stop returns before the propagated
  # instance shutdown finishes, and pgbackrest would race a live
  # postmaster.pid. START uses the meta unit alone: its Wants= pulls
  # every instance, while a start-glob only matches already-loaded
  # units (the readiness wait below absorbs the propagation lag).
  sudo systemctl stop desmo_granian.service desmo_huey.service 'postgresql@*' postgresql
  sudo -u postgres pgbackrest --delta "${args[@]}"
  sudo systemctl start postgresql desmo_granian.service desmo_huey.service
  local tries=0
  until sudo -u postgres psql -Atqc "SELECT NOT pg_is_in_recovery()" 2>/dev/null | grep -qx t; do
    tries=$((tries + 1))
    if [ "$tries" -ge 60 ]; then
      echo "FAILED: postgres not promoted after 60s — restore did not reach consistency." >&2
      return 1
    fi
    sleep 1
  done
}

dev() {
  # The whole dev stack in one terminal via `concurrently`: runserver + vite
  # watch + huey (Ctrl-C stops all). The agent runs in its own terminal via
  # `./run pi` — no browser console anymore.
  setenv
  frontend/node_modules/.bin/concurrently -n runserver,vite,huey -c blue,green,cyan \
    "./run runserver" \
    "cd frontend && npm run dev" \
    "./run hueydev"
}

pi() {
  # The agent: exec the pi TUI with the .env environment (app env + git
  # identity) exported by setenv — dev and VM alike; the startup model and
  # provider auth live in pi's own stores (/model Ctrl+S, /login — see
  # deploy/access-steps.txt). Config is project-local and versioned:
  # .pi/settings.json (pinned packages), .pi/extensions/pi-permission-system/config.json
  # (the whole bash/edit/path policy — allow/ask/deny with operator
  # prompts), .pi/extensions/context/ (steer.md injection), and
  # .pi/extensions/notify/ (double BEL — immediate, then 300ms — on
  # turn end and on blocking questions; rings the operator's local
  # terminal over SSH). Subagents
  # and their permission forwarding come from @gotgenes/pi-subagents.
  setenv
  local repo_root
  repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  # Run from the REPO ROOT (main/): the TUI's pwd is the actual repo, and
  # project-extension discovery + agent discovery are working-dir-relative.
  # No parent-cd, no parent git-init — main/ is its own repo everywhere;
  # scratch/ is a SIBLING, reachable via the sanctioned compounds and
  # scratch paths the guards allow.
  cd "$repo_root"

  # (1) Binary on PATH.
  command -v pi >/dev/null 2>&1 || {
    echo "pi binary not found on PATH — install it first" \
      "(npm install -g --ignore-scripts @earendil-works/pi-coding-agent; see deploy/inside-vm.sh)" >&2
    return 1
  }

  # (2) The permission policy IS the launcher's config check — refuse to
  #     start without every piece: the pinned packages (declared in
  #     .pi/settings.json; auto-installed into .pi/npm on project trust),
  #     the project permission policy, and the steer.md injection
  #     extension. Without the permission system the session would run
  #     unguarded (pi has NO built-in permission model).
  local policy
  for policy in \
    .pi/settings.json \
    .pi/extensions/pi-permission-system/config.json \
    .pi/extensions/context/index.ts
  do
    [[ -f "$policy" ]] || {
      echo "Refusing to start: $policy not found — without it the agent has no permission policy." >&2
      return 1
    }
  done

  # (3) Session behavior:
  #     - --approve grants project trust DETERMINISTICALLY: without it a
  #       headless/default run silently skips .pi extensions AND packages
  #       (the permission system included) — probed. The launcher owns
  #       this decision; trust also auto-installs the pinned packages
  #       into .pi/npm/ on first run.
  #     - PI_REPO_ROOT anchors the context extension (steer.md path)
  #       against any cwd drift.
  #     - PI_SKIP_VERSION_CHECK=1: no startup update ping (telemetry is
  #       off via .pi/settings.json).
  #     - Sessions land in /sessions (sessionDir in project settings)
  #       — in-repo and gitignored; ~/.pi/agent/ only keeps trust.json.
  export PI_REPO_ROOT="$repo_root"
  export PI_SKIP_VERSION_CHECK=1

  # All checks passed — hand the terminal over to the TUI.
  command pi --approve "$@"
}

# Test runs point redis at an isolated DB (not the live DB 0) so tests can
# flush it freely; exported AFTER setenv, which re-sources the live value.
_TEST_REDIS_URL="redis://127.0.0.1:6379/2"

# The test-process redis environment, applied as one word: the isolated
# URL plus the marker clear_redis requires before flushing (so a bare
# manage.py test, which sees the live DB 0, refuses loudly instead).
_with_test_redis() {
  REDIS_URL="$_TEST_REDIS_URL" DESMO_TEST_REDIS=1 "$@"
}

test() {
  setenv
  _with_test_redis uv run manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright "$@"
}

typecheck() {
  setenv
  uv run mypy $_MYPY_COLOR .
}

playwrighttest() {
  setenv
  cd frontend
  npm run build
  cd ..
  # Forwards args like test(): `./run playwrighttest
  # djangoapp.tests.playwright.test_framework_smoke` runs just that module
  # (Django intersects the label with --tag playwright). No args = full suite.
  _with_test_redis uv run manage.py test $_DJANGO_NO_COLOR --tag playwright --noinput "$@"
}

screenshots() {
  setenv
  cd frontend
  npm run build
  cd ..
  # Regenerates the committed README PNGs in docs/screenshots/. The pass
  # self-gates on GENERATE_SCREENSHOTS (tests skip without it). The models-management
  # shots additionally need the testapp overlay — see
  # docs/screenshots/README.md for the manual overlay recipe.
  GENERATE_SCREENSHOTS=1 _with_test_redis uv run manage.py test $_DJANGO_NO_COLOR --tag screenshots --noinput "$@"
}

checkmarkdownd2() {
  # Validate EVERY ```d2 fence in one or more markdown files — the
  # first broken block is printed, then its compile error (exit 1).
  # All ok → exit 0. No args on a TTY: scan every fence in the default
  # docs (ourapp/docs/, ourapp/README.md, docs/d2.md,
  # docs/reference/ourapp/docs/, agentconfig/steer.md).
  _require_main_run checkmarkdownd2 || return 1
  node "$_MAIN_DIR/deploy/checkmarkdownd2.mjs" "$@"
}

# The full gate: lint + types in main/, then FOUR test stages — 1-3 under
# coverage, merged into one report:
#   1. unit suite (main/; project tests self-skip — no RUN_PROJECT_TESTS)
#   2. Playwright pass (main/; StaticLiveServerTestCase is an in-process
#      thread, so plain coverage captures the server code)
#   3. project tier (scratch + testapp overlay, RUN_PROJECT_TESTS=1) — the
#      concrete-BaseModel flows: save_plus/update logs/FileField cleanup/manage
#   4. reference tier (scratch + docs/reference overlay) — the reference
#      app validated FOR ITS OWN SAKE (its own tests over a built bundle);
#      NOT under coverage: it must not contribute to the merged report
checkframework1() {
  # main/'s ./run only (scratch's copy would rm -rf its own tree), and never
  # in the VM — the VM has its own gate (checkframework2/gate.sh).
  _require_main_run checkframework1 || return 1
  if is_running_on_vm; then
    echo "Refusing: checkframework1 is a dev-side gate; the VM runs checkframework2." >&2
    return 1
  fi
  setenv
  # Reset the fragment staging dir (.coverage-stage/, gitignored) — a
  # previous gate run that died before combine leaves it behind. Same for
  # main's own .coverage.* strays: only a successful combine deletes them,
  # and folding stale ones in would corrupt the merged report.
  rm -rf "$_MAIN_DIR/.coverage-stage"
  mkdir -p "$_MAIN_DIR/.coverage-stage"
  rm -f "$_MAIN_DIR"/.coverage.*
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR .
  echo "Running test under coverage (stage 1/4: unit suite)"
  _with_test_redis uv run coverage run --parallel-mode --source=djangoapp,ourapp \
    manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright --noinput
  cd frontend
  echo "Running frontend linting"
  npm run lint
  echo "Running frontend build (type-check + vite, bundle for the Playwright pass)"
  npm run build
  cd ..
  echo "Running Playwright tests under coverage (stage 2/4)"
  _with_test_redis uv run coverage run --parallel-mode --source=djangoapp,ourapp \
    manage.py test $_DJANGO_NO_COLOR --tag playwright --noinput

  echo "=== stage 3/4: project tests over the test app (scratch copy) ==="
  # The overlay replaces ourapp/ wholesale with fixture code — measure
  # --source=djangoapp only (never that ourapp/).
  create_new_scratch
  overlay_app "$_MAIN_DIR/djangoapp/tests/testapp"
  ( cd "$_SCRATCH_DIR"
    # typecheck only — lintfix would rewrite files and corrupt the
    # merged line data (main already ran the ruff gates).
    ./run typecheck
    RUN_PROJECT_TESTS=1 _with_test_redis uv run coverage run --parallel-mode --source=djangoapp \
      manage.py test $_DJANGO_NO_COLOR --exclude-tag playwright --noinput
  )
  # Stage the fragments out — the next create_new_scratch wipes scratch.
  mv "$_SCRATCH_DIR"/.coverage.* "$_MAIN_DIR/.coverage-stage/"

  echo "=== stage 4/4: reference app's own tests (scratch copy; not measured) ==="
  create_new_scratch
  overlay_app "$_MAIN_DIR/docs/reference"
  # The reference app ships its own app-side frontend (pages, components,
  # schemas, styles); overlay them so its pages are in the built bundle
  # (same as the old checkproject cycle 2). System files stay the tree's own.
  for _dir in pages components schemas styles; do
    rsync -a "$_MAIN_DIR/docs/reference/frontend/src/$_dir/" \
      "$_SCRATCH_DIR/frontend/src/$_dir/"
  done
  ( cd "$_SCRATCH_DIR"
    ( cd frontend && npm run build )
    ./run test --noinput ourapp
  )
  # Green: drop scratch. On failure set -e aborts earlier, leaving it behind
  # for inspection.
  rm -rf "$_SCRATCH_DIR"

  echo "Merging coverage from all four stages"
  # combine folds the testapp scratch's djangoapp/ onto main's via
  # [tool.coverage.paths] in pyproject.toml.
  uv run coverage combine . "$_MAIN_DIR/.coverage-stage"
  # The staged fragments are folded into .coverage now — drop the staging dir.
  rm -rf "$_MAIN_DIR/.coverage-stage"
  # Ratchet: the merged report must hold the measured floor (2026-10-04: 99.78%).
  # Raise when coverage improves; never lower it to make a regression pass.
  uv run coverage report -m --fail-under=99.78
  uv run coverage html
  echo "Coverage report: htmlcov/index.html"
}

# The deployment gate (destructive — the old VM's git + database are gone):
# - rebuild the test VM from scratch (`./local-vm delete` + `provision-full`)
# - run the in-VM gate — deploy/gate.sh's `gate`, dispatched like every other
#   guest-side helper — over ONE multipass exec; its exit code is the verdict.
#   The gate:
#   - replaces the VM's `ourapp/` with the Books test app (djangoapp/tests/testapp)
#     ourapp/
#   - refuses non-loopback installs first (BASE_URLS from the VM's
#     installed .env.vm — prod origins abort before anything mutates)
#   - smokes the LIVE stack over HTTPS on loopback (caddy TLS, granian,
#     postgres, login links)
#   - runs the agent's full scratch lifecycle
#   - three setup phases, eleven asserts, first failure aborts
# - NB: the exec's output streams unfiltered — never pipe an exec into
#   grep -q (early-exit readers wedge the daemon's next exec on this host)
checkframework2() {
  setenv
  echo "=== Rebuild the VM from scratch (destructive) ==="
  if multipass info desmo >/dev/null 2>&1; then
    "$_MAIN_DIR/local-vm" delete
  fi
  "$_MAIN_DIR/local-vm" provision-full
  echo "=== Run the in-VM gate (testapp overlay + 11 asserts) ==="
  multipass exec desmo -- sudo bash /srv/desmo/main/deploy/gate.sh gate
}

# Changed-set vs the frozen scratch-baseline + untracked files (one path per
# line) — one listing for both the fast-path gate and the framework watch.
_scratch_changed_files() { # <dir>
  local baseline
  baseline=$(git -C "$1" rev-parse --verify scratch-baseline 2>/dev/null) \
    || { echo "REFUSING: no scratch-baseline ref — re-run ./run createscratch" >&2; return 1; }
  {
    git -C "$1" diff --name-only "$baseline" \
      || { echo "REFUSING: git diff failed in $1 — no deploy on a partial changed-set." >&2; return 1; }
    git -C "$1" ls-files --others --exclude-standard \
      || { echo "REFUSING: git ls-files failed in $1 — no deploy on a partial changed-set." >&2; return 1; }
  } | sort -u
}

# Print the failed step + its manual re-run; return nonzero so `… || _step_failed`
# aborts deployscratch under set -e. The step text is read from the caller's
# own source line — keep `cmd || _step_failed` on ONE line — and @P-expanded so
# $VARS print as values (bash ≥4.4 to run; deployscratch is VM-only).
_step_failed() {
  local _raw _cmd
  _raw=$(sed -n "${BASH_LINENO[0]}p" "${BASH_SOURCE[1]}" \
    | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*||.*//')
  _cmd=${_raw@P}
  echo "" >&2
  echo "Step failed: $_cmd" >&2
  echo "Iterate to fix it and run only that step, not the time-consuming deployscratch." >&2
  echo "then re-run: ./run deployscratch (from main/)" >&2
  return 1
}

# The scratch/ fast loop: the agent's edits checked without the unchanged
# framework suite or the slow browser pass — those stay in main/'s
# checkframework1.
_scratch_checks() {
  echo "Running ruff format --check (formatting drift)"
  uv run ruff format $_RUFF_COLOR --check || _step_failed
  echo "Running ruff check (lint)"
  uv run ruff check $_RUFF_COLOR || _step_failed
  echo "Running mypy for type checking"
  uv run mypy $_MYPY_COLOR . || _step_failed
  echo "Running ourapp tests (scoped; the framework suite runs in main/)"
  ./run test ourapp --noinput || _step_failed
  cd frontend
  echo "Running frontend linting"
  npm run lint || _step_failed
  echo "Running frontend build (type-check + vite in one pass)"
  npm run build || _step_failed
  cd ..
  # Framework-file watch: edits outside the app surface (ourapp/ + the
  # app-side frontend dirs) mean framework code changed → run the
  # scratch-test-subset smoke (an early-warning fraction of
  # checkframework1; the full suite still gates in main/).
  local changed_files outside
  changed_files=$(_scratch_changed_files "$_SCRATCH_DIR") || return 1
  outside=$(grep -vE '^(ourapp/|frontend/src/(pages|components|schemas|styles)/)' <<<"$changed_files" || true)
  if [ -n "$outside" ]; then
    echo "=== framework files changed — running scratch-test-subset smoke tests ==="
    printf '  %s\n' $(grep -c . <<<"$outside") files:
    printf '  %s\n' $outside
    _with_test_redis uv run manage.py test $_DJANGO_NO_COLOR --noinput --tag=scratch-test-subset || _step_failed
  else
    echo "No framework-file changes (outside the app surface) — skipping scratch-test-subset smoke."
  fi
}

lintfix() {
  setenv
  uv run ruff format $_RUFF_COLOR
  uv run ruff check $_RUFF_COLOR --fix --unsafe-fixes
  cd frontend
  npm run lint:fix
}

# The scratch rsyncs' exclude set, derived from .gitignore at call time:
# keeping a new junk/artifact/runtime dir out of the scratch loop is a
# .gitignore-only change. (The permission ledger rides like any tracked
# file — the policy is never edited mid-run.)
scratch_excluded_files() { # scratch_excluded_files <egrep -v filter> <dir>...
  # <filter> drops the directional carries from the listing:
  #   djangoapp/static/  always — the built bundle rides both ways
  #                      (.gitignore says the opposite: don't commit it)
  #   ^\.env$            createscratch-ward — the deploy re-excludes it
  local filter=$1
  shift
  local d tmp
  tmp=$(mktemp)
  # BOTH trees, not just the sender: plain --delete never removes excluded
  # files on the receiver, so main-only runtime data (media/, dbbackups/,
  # staticfiles/) survives the deploy only if MAIN's listing carries the
  # exclude — scratch never contains those dirs to list them.
  # (--directory also sweeps in fully-untracked dirs whose contents are
  # all ignored — djangoapp/apps/ — intended: generated
  # output, never source.)
  for d in "$@"; do
    # Command-substitution subshells don't inherit errexit, so a git
    # failure must RETURN out of the function — else the caller's set -e
    # never fires and the rsync proceeds with an empty exclude list.
    git -C "$d" ls-files --others --ignored --exclude-standard --directory >>"$tmp" \
      || { rm -f "$tmp"; echo "REFUSING: git ls-files failed in $d — no rsync without excludes." >&2; return 1; }
  done
  # Drop lines rsync would misparse (rule prefixes "- ", "+ ", "! ",
  # comments "; "/"#", glob metachars * ? [): a hostile ignored name must
  # ride as harmless junk, never silently exclude an unrelated tracked
  # file. (`|| true`: a fresh clone has nothing gitignored yet — an
  # empty exclude list is correct there.)
  { grep -Ev "$filter" "$tmp" || true; } \
    | grep -vE '^[-+!;#] |[*?[]' >"$tmp.f" && mv "$tmp.f" "$tmp"
  printf '%s' "$tmp"
}

# main/ is this script's dir; scratch/ is its sibling (both under parent/).
# Resolved once at load time so createscratch/deployscratch stay free of path
# boilerplate.
_MAIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_SCRATCH_DIR="$(dirname "$_MAIN_DIR")/scratch"

# Build a fresh scratch/ from main/: tree rsync INCLUDING .git (shared
# history), main's HEAD frozen as the `scratch-baseline` ref, and .venv +
# node_modules hardlink-copied so the bootstrap runs incremental.
# Hardlink-copy when the OS allows it (dev on the Mac: same owner —
# instant, zero extra disk); plain copy otherwise. On the VM main/ is
# desmo-owned and Linux's protected_hardlinks blocks the default user
# from hardlinking files it can only read — bare cp -al dies "Operation
# not permitted" halfway and leaves a HOLLOW .venv that uv then refuses
# ("no Python executable"), which cost a session an hour of venv
# archaeology. The fallback copies fully; uv sync stays incremental.
_link_or_copy_tree() {
  if ! cp -al "$1" "$2" 2>/dev/null; then
    rm -rf "$2"
    cp -a "$1" "$2"
  fi
}

create_new_scratch() {
  rm -rf "$_SCRATCH_DIR"
  # Sender-only excludes (no --delete here; the receiver was just wiped).
  # The filter keeps .env and the built bundle riding to scratch — the
  # deploy re-excludes .env.
  local excluded_files
  excluded_files=$(scratch_excluded_files '^\.env$|^djangoapp/static/' "$_MAIN_DIR")
  rsync -a --exclude-from="$excluded_files" "$_MAIN_DIR/" "$_SCRATCH_DIR/"
  rm -f "$excluded_files"
  git -C "$_SCRATCH_DIR" tag -f scratch-baseline HEAD >/dev/null
  # npm install rewrites package-lock format-normalized — it reads as a
  # diff vs the baseline, tripping the framework-file watch. Restore from
  # HEAD.
  git -C "$_SCRATCH_DIR" checkout -- frontend/package-lock.json 2>/dev/null || true
  [ -d "$_MAIN_DIR/.venv" ] && _link_or_copy_tree "$_MAIN_DIR/.venv" "$_SCRATCH_DIR/.venv"
  [ -d "$_MAIN_DIR/frontend/node_modules" ] \
    && _link_or_copy_tree "$_MAIN_DIR/frontend/node_modules" "$_SCRATCH_DIR/frontend/node_modules"
  ( cd "$_SCRATCH_DIR"
    uv sync
    cd frontend
    npm install
  )
  # npm install may still touch the lock (format normalization) — pin it back
  # AFTER install so the baseline stays clean.
  git -C "$_SCRATCH_DIR" checkout -- frontend/package-lock.json 2>/dev/null || true
}

# Overlay an app's ourapp/ onto scratch/ourapp/ (full replace).
overlay_app() {
  rsync -a --delete "$1/ourapp/" "$_SCRATCH_DIR/ourapp/"
}

# Scratch-lifecycle commands must run MAIN's ./run: from scratch's own copy
# both dirs resolve to scratch (deploy rsyncs scratch onto itself; create
# rm -rf's its own tree). Refuse loudly.
_require_main_run() {
  if [ "$_MAIN_DIR" = "$_SCRATCH_DIR" ]; then
    echo "Refusing: this is scratch's own ./run — run '$1' from main/'s ./run instead." >&2
    return 1
  fi
}

createscratch() {
  # Fresh scratch/ of main/ (shared git history + frozen baseline ref, hardlinked
  # env) for the agent to edit + diff.
  _require_main_run createscratch || return 1
  create_new_scratch
  echo "scratch/ ready at $_SCRATCH_DIR. Edit there, then deploy with: ./run deployscratch (from main/)"
}

# Wall-clock stamp for the just-finished deploy step (absolute, rounded to the second).
_banner() { # <label>
  echo "    [$1 $(date +%T)]"
}

# The ONE command: the check battery in scratch (nothing deploys red),
# then rsync → main/ (.git + gitignored dirs excluded), pre-migration backup,
# migrate, collectstatic + restart granian/huey so deploys go LIVE.
# Fast path: frontend/docs-only diffs skip the backend battery, backup,
# migrate and restarts (lint + build + smoke pass / d2 fence validation).
# VM ONLY — the scratch loop is the agent's edit cycle and the agent
# lives in the VM; a dev Mac has none of it (no pgbackrest, no units).
# Never commits.
deployscratch() {
  setenv
  _require_main_run deployscratch || return 1
  if ! is_running_on_vm; then
    echo "Refusing: deployscratch deploys the VM's main." >&2
    return 1
  fi
  [ -d "$_SCRATCH_DIR" ] || { echo "Refusing: $_SCRATCH_DIR not found. Run createscratch first." >&2; return 1; }

  # Refuse the moment a backup is in flight (_backup_running —
  # pgbackrest's own lock report): the pre-migration backup below
  # would COALESCE with it (the safety copy silently never runs).
  if _backup_running; then
    echo "Refusing: a backup is running — let it finish, then re-run deployscratch." >&2
    return 1
  fi

  # Fast path — every changed file is one of:
  #   - frontend/**       → lint + build + scratch-test-subset smoke pass
  #   - ourapp/docs/*.md  → d2 fence validation
  # No backend files change → no backend battery, backup, migrate, restarts.
  local changed_files docs_or_frontend_only=false frontend_changed=false
  changed_files=$(_scratch_changed_files "$_SCRATCH_DIR") || return 1
  # docs_or_frontend_only = the set is nonempty and every line matches the safe set.
  if [ -n "$changed_files" ] && ! grep -vqE '^(frontend/|ourapp/docs/[^/]+\.md$)' <<<"$changed_files"; then
    docs_or_frontend_only=true
    if grep -q '^frontend/' <<<"$changed_files"; then frontend_changed=true; fi
  fi

  if $docs_or_frontend_only; then
    echo "Fast path: frontend/docs-only changes — no backend checks, backup, migrate, or restarts."
    if $frontend_changed; then
      # Lint + build the SPA in scratch; the bundle rides the rsync.
      ( cd "$_SCRATCH_DIR/frontend"
        npm run lint || _step_failed
        npm run build || _step_failed )
      # Real pages in a real browser — lint and build cannot catch runtime
      # breakage; the smoke pass can.
      ( cd "$_SCRATCH_DIR"
        _with_test_redis uv run manage.py test $_DJANGO_NO_COLOR --noinput --tag=scratch-test-subset || _step_failed )
    fi
    # Design docs: validate every d2 fence in each changed file.
    local md_file
    while IFS= read -r md_file; do
      # Deleted/renamed-away paths list here too — nothing to validate,
      # rsync --delete carries the removal.
      [ -f "$_SCRATCH_DIR/$md_file" ] || continue
      node "$_MAIN_DIR/deploy/checkmarkdownd2.mjs" "$_SCRATCH_DIR/$md_file" || _step_failed
    done <<<"$(grep -E '^ourapp/docs/[^/]+\.md$' <<<"$changed_files" || true)"
    _banner "check battery (fast)"
  else
    ( cd "$_SCRATCH_DIR" && _scratch_checks )
    _banner "check battery"
  fi

  echo "Deploying $_SCRATCH_DIR/ → $_MAIN_DIR/ (--delete, excluding .git + gitignored/runtime dirs)…"
  # - sudo rsync: non-root can't preserve attrs on desmo-owned files
  #   (exit 23), and scratch's files are default-user-owned.
  # - re-own to desmo AND re-add g+w after — chown alone leaves rsync's
  #   644/755 without g+w; the next default-user build dies (EACCES
  #   rmdir .vite, a real playwright wall).
  # - `.git` never rides a deploy: scratch only borrowed main's history
  #   (git never lists it, so no derived exclude covers it).
  local excluded_files
  excluded_files=$(scratch_excluded_files '^djangoapp/static/' "$_SCRATCH_DIR" "$_MAIN_DIR")
  sudo rsync -a --delete --exclude='.git/' \
    --exclude-from="$excluded_files" "$_SCRATCH_DIR/" "$_MAIN_DIR/"
  rm -f "$excluded_files"
  _banner "rsync"
  # Own the tree as desmo (scratch's files arrive default-user-owned):
  #   - main tree: the agent's user edits it (builds, git resets)
  #   - dbbackups/: PRUNED — stays postgres-owned (pgbackrest runs as
  #     postgres and refuses root); "-path <dir> -prune" is find's
  #     skip, cutting the subtree so the -exec beyond -o never fires
  #     inside it
  sudo find "$_MAIN_DIR" -path "$_MAIN_DIR/dbbackups" -prune -o -exec chown desmo:desmo {} +
  # Group-write the tree:
  #   - main tree: chown alone leaves rsync-created 644/755 files
  #     without g+w — the next build as the default user then dies on
  #     desmo-owned dirs (EACCES rmdir .vite, a real session's
  #     playwright wall)
  #   - dbbackups/: PRUNED — the repo stays mode 700; g+w would open
  #     it to the desmo group
  sudo find "$_MAIN_DIR" -path "$_MAIN_DIR/dbbackups" -prune -o -exec chmod g+w {} +
  _banner "own"
  # Backup + migrate only when backend code changed; collectstatic when the
  # bundle changed; restart only for backend — static chunks and
  # tree-served docs need no service restart.
  if ! $docs_or_frontend_only; then
    # Pre-migration snapshot through the real unit — the DB state to
    # restore to if this deploy's migrate goes wrong.
    sudo systemctl start desmo_pgbackrest.service
    _banner "backup"
    ( cd "$_MAIN_DIR" && uv run --no-sync python manage.py migrate --noinput )
    _banner "migrate"
  fi
  if ! $docs_or_frontend_only || $frontend_changed; then
    echo "collectstatic…"
    ( cd "$_MAIN_DIR" && uv run --no-sync python manage.py collectstatic --noinput --clear )
    _banner "collectstatic"
  fi
  if ! $docs_or_frontend_only; then
    echo "restarting services…"
    # Huey's unit always exists on provisioned VMs (HUEY_WORKERS ≥ 1 is
    # enforced at provisioning).
    sudo systemctl daemon-reload
    sudo systemctl restart desmo_granian.service desmo_huey.service
    _banner "restart"
  fi
  # Share-URL base — never a hardcoded one. The FIRST BASE_URLS entry is
  # the link base (the same rule makeloginlink uses); it keeps scheme and
  # port, so nothing is prefixed here.
  _SHARE_BASE="${BASE_URLS%%,*}"   # first origin of the comma list
  _SHARE_BASE="${_SHARE_BASE// /}" # tolerate spaces around the commas
  _SHARE_BASE="${_SHARE_BASE%/}"   # drop a trailing slash — the links below add their own
  echo "App is available under:"
  ( cd "$_MAIN_DIR" && uv run --no-sync python manage.py baseurls )
  _banner "baseurls"
  echo "Deployed scratch/ → main/ (uncommitted, services live). Commit in main/ when ready."
  echo "Share absolute URLs you verified exist in main/ at the BOTTOM of your message (with the summary):"
  echo "  docs: ${_SHARE_BASE}/files/main/ourapp/docs/<feature>.md · pages: ${_SHARE_BASE}/<page-url>"
}

cleanscratch() {
  # Remove scratch/ outright (discard the scratch tree). Portable: uses
  # _SCRATCH_DIR (../scratch relative to this script), so the agent calls
  # `./run cleanscratch` from the repo without computing an absolute path —
  # an absolute `rm -rf /…/scratch` isn't allowlisted and prompts.
  if [ -d "$_SCRATCH_DIR" ]; then
    rm -rf "$_SCRATCH_DIR"
    echo "Removed $_SCRATCH_DIR."
  else
    echo "No scratch/ at $_SCRATCH_DIR to remove."
  fi
}

help() {
  # Colored in a real terminal, plain when captured (pipes, agent logs) —
  # same policy as the tool flags at the top of this script.
  local H C R
  H=$'\033[1;36m' C=$'\033[1;32m' R=$'\033[0m'
  [ -t 1 ] || { H=''; C=''; R=''; }
  cat <<EOF
${H}Usage:${R} run <command> [args…]        (on the VM: ${C}desmo${R} <command> — same thing)

${H}Development${R}
  ${C}init${R}                first-time setup: .env, uv sync, playwright, DB + migrate
  ${C}dev${R}                 runserver + vite + huey in one terminal (Ctrl-C stops all)
  ${C}runserver${R}           Django dev server only
  ${C}hueydev${R}             huey consumer only (dev)
  ${C}pi${R}                  the pi coding-agent TUI (scratch-driven edit → deploy loop)

${H}Checks${R}
  ${C}lintfix${R}             ruff format + ruff check, eslint (writes)
  ${C}typecheck${R}           mypy (backend) + vue-tsc (frontend)
  ${C}checkmarkdownd2${R} [file.md]
                        validate every d2 fence in file(s) (first broken
                        block + error, exit 1); no args on a TTY →
                        scan every fence in the default docs
  ${C}test${R} [args…]        Django test suite (args pass through to manage.py test)
  ${C}playwrighttest${R} …    Playwright e2e suite
  ${C}screenshots${R}         regenerate docs/screenshots via Playwright
  ${C}checkframework1${R}     the full dev-side gate (main/ only, never the VM):
                        lint + types + 4 test tiers under one merged
                        coverage report (htmlcov/)
  ${C}checkframework2${R}     rebuild the test VM from scratch + run the in-VM gate

${H}Scratch (the agent edit loop)${R}
  ${C}createscratch${R}       copy main/ → scratch/ + tag scratch-baseline
  ${C}deployscratch${R}       checks, then deploy scratch/ → main/ (VM only). Full path:
                       battery, backup, migrate, restarts; frontend/docs-only
                       diffs take a fast path (lint/build + smoke, or fence checks)
  ${C}cleanscratch${R}        remove scratch/

${H}Backups (pgbackrest — docs/backups.md)${R}
  ${C}backupdb${R}             run a backup NOW (weekly full + daily diff; the tool's own logs print)
  ${C}restoredb${R} <set>      restore ONTO the live DB to an EXACT snapshot (whole-app downtime);
                       <set> = a backup label from: pgbackrest --stanza=desmo info
  (inspect directly: sudo -u postgres pgbackrest --stanza=desmo info|check)

${H}Passthrough${R}
  ${C}djangomanage${R} …      manage.py <…> with the env sourced (e.g. djangomanage migrate)
  ${C}python${R} …           python <…> with the env sourced (e.g. python -c '…')
EOF
}

# No arguments → default to help (`desmo` with no args lands here).
if [ $# -eq 0 ]; then
  help
  exit 0
fi

# Check if function exists and call it with all arguments except $1
if declare -F "$1" >/dev/null; then
  func_name="$1"
  shift
  "$func_name" "$@"
else
  help
  echo "Unknown command: $1" >&2
  exit 1
fi
