#!/bin/bash
# local-vm — the LOCAL test VM's single interface, dual-role by path:
#
# HOST side (this checkout, your machine):
#   ./local-vm provision-full [--release 26.04|24.04]
#   ./local-vm provision-blank [--release 26.04|24.04]
#   ./local-vm delete
# Deploys the LOCAL test VM (multipass instance "desmo") and NOTHING ELSE.
# provision-blank launches the empty VM and prints the curl|bash installer
# line; provision-full runs that same line for you (the VM is built from
# PUBLISHED main — the local working tree is never seeded; push first,
# then gate). Both end at the same provisioner:
# deploy/inside-vm.sh provision, one exec,
# phase-banner'd. All config is the
# tracked deploy/template.env (the one operator input, BASE_URL,
# rides the environment); the three machine secrets are minted inside.
#
# GUEST side (the seeded copy at /srv/desmo/main/local-vm):
#   multipass exec desmo -- sudo -u desmo -H bash /srv/desmo/main/local-vm \
#     runasdesmo <cmd…>
# `runasdesmo` — the one sanctioned way to run one command as the desmo
# service user (env sourced, repo cwd, uv on PATH): the login/oauth/
# superuser admin commands in README § VM and deploy/access-steps.txt.
#
# provision-blank launches the empty VM — the entry point for the
# end-user install: multipass shell in, paste the curl|bash line
# (deploy/install.sh provisions from a published ref, optionally with
# --base-url). Refuses if the instance exists.
#
# provision-full = provision-blank + that same curl|bash, run for you:
# the VM is built from PUBLISHED main (loopback, no domain; the local
# working tree is never seeded — push first, then gate).
#
# delete is destructive with no backup: the VM's `.git` and database are
# gone — copy anything you need off first (tar via multipass transfer,
# pg_dump via multipass exec).
#
# Never touches the host's ssh config: use `multipass shell desmo` or
# your own alias. Plan + manifest: prompts/20260818-vm-provisioning-multipass.md.

set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # repo root (main/)
deploy_dir="$here/deploy"

usage() {
  echo "Usage: $0 {provision-full|provision-blank|delete}" >&2
  [[ -n "${1:-}" ]] && echo "  $1" >&2
  exit 1
}

provision-blank() {
  local release="26.04"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --release) [[ $# -ge 2 ]] || usage "--release needs a value"; release="$2"; shift 2 ;;
      *) usage "unknown flag: $1" ;;
    esac
  done

  if ! command -v multipass >/dev/null 2>&1; then
    echo "multipass not found — install it first (https://multipass.run)" >&2
    exit 1
  fi
  if multipass info desmo >/dev/null 2>&1; then
    echo "REFUSING: instance 'desmo' already exists." >&2
    echo "  ./local-vm delete && ./local-vm provision-blank  # to rebuild" >&2
    exit 1
  fi
  echo "==> multipass launch desmo (bridged en0, DHCP, 2G ram, 20G disk, $release) — blank"
  multipass launch --name desmo --network en0 --memory 2G --disk 20G "$release"

  # The curl|bash installer line, derived from deploy/install.sh's
  # repo_url (the one place the repo identity lives — no second copy to
  # drift; MAINTAIN-CONSISTENCY vm-payload).
  local repo_url raw_path
  repo_url="$(sed -n 's|^repo_url="\([^"]*\)"$|\1|p' "$deploy_dir/install.sh")"
  [ -n "$repo_url" ] || { echo "REFUSING: repo_url missing from deploy/install.sh" >&2; exit 1; }
  raw_path="${repo_url#https://github.com/}"
  raw_path="${raw_path%.git}"

  cat <<EOF
Blank VM 'desmo' is up. Get in and run the installer (provisions from a
published ref — the VM serves loopback only, like provision-full):
  multipass shell desmo
  curl -fsSL https://raw.githubusercontent.com/${raw_path}/main/deploy/install.sh | sudo bash -s
EOF
}

provision-full() {
  # Launch (guards + refusal live in provision-blank; its printout doubles
  # as the plan), then run the installer it printed — duplicated inline
  # per house style; install.sh's repo_url stays the single source of the
  # repo identity (MAINTAIN-CONSISTENCY vm-payload).
  provision-blank "$@"
  local repo_url raw_path
  repo_url="$(sed -n 's|^repo_url="\([^"]*\)"$|\1|p' "$deploy_dir/install.sh")"
  [ -n "$repo_url" ] || { echo "REFUSING: repo_url missing from deploy/install.sh" >&2; exit 1; }
  raw_path="${repo_url#https://github.com/}"
  raw_path="${raw_path%.git}"

  # The install streams back; its exit code is the verdict (pipefail on
  # the inner leg — a failed download must not read as a blank-VM success).
  multipass exec desmo -- bash -c \
    "set -o pipefail; curl -fsSL https://raw.githubusercontent.com/${raw_path}/main/deploy/install.sh | sudo bash -s"

  cat "$deploy_dir/access-steps.txt"
}

delete() {
  multipass delete desmo
  multipass purge
  echo "Deleted VM 'desmo'. Recreate: ./local-vm provision-full (installs published main)."
}

# ── guest side (invoked inside the VM via multipass exec) ─────────────────
# Self-contained: no sourcing of other scripts — the seeded copy at
# /srv/desmo/main/local-vm is the whole runtime.
runasdesmo() { # <command…> — one command as the desmo service user
  set -a
  . /etc/credentials/desmo/.env.vm
  set +a
  cd /srv/desmo/main
  export PATH=/usr/local/bin:$PATH
  "$@"
}

# Check if function exists and call it with all arguments except $1
cmd="${1:-}"
if [[ -n "$cmd" ]] && declare -F "$cmd" >/dev/null; then
  shift
  "$cmd" "$@"
else
  usage
fi

# MAINTAIN-CONSISTENCY vm-payload — the payload contract lives in deploy/inside-vm.sh
# (deploy/install.sh is its sole manufacturer; this file's two inline
# curl-line derivations — provision-blank's printout, provision-full's
# exec — both read install.sh's repo_url)